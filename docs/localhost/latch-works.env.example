# Local app environment for the repo-root .env.
# Copy the values you need into ../../.env, or copy this file to ../../.env
# for a fresh local setup.

NODE_ENV=development
DATABASE_URL=postgres://replace-with-local-database-credentials@localhost:5432/latch_works
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_BUCKET=latch-works-media
S3_ACCESS_KEY_ID=replace-with-local-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-local-s3-secret-key

BETTER_AUTH_SECRET=replace-with-auth-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
PANE_VIEW_USERNAME=replace-with-local-username
PANE_VIEW_PASSWORD=replace-with-local-password
PANE_VIEW_SYNC_TOKEN=replace-with-lockstep-sync-token
PANE_VIEW_TRUST_PROXY_HEADERS=false
SHUTTER_EDGE_URL=https://replace-with-shutter-edge-url
SHUTTER_CONTROL_URL=https://replace-with-shutter-control-url
SHUTTER_SPACE_ID=replace-with-shutter-space-id
SHUTTER_SPACE_API_TOKEN=replace-with-shutter-space-api-token
SHUTTER_CAPABILITY_KEYS=replace-with-shutter-capability-key-registry
SHUTTER_CAPABILITY_KID=replace-with-shutter-capability-key-id

LOCKSTEP_SOURCE=T:\cloud-desktop\media
LOCKSTEP_API_URL=http://localhost:3000
LOCKSTEP_API_TOKEN=replace-with-lockstep-sync-token
