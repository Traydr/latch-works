# Local app environment for the repo-root .env.
# Copy the values you need into ../../.env, or copy this file to ../../.env
# for a fresh local setup.

DATABASE_URL=postgres://user:password@localhost:5432/latch_works
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_BUCKET=latch-works-media
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
MEDIA_DELIVERY_SECRET=local-media-delivery-secret-32-chars
MEDIA_DELIVERY_TTL_SECONDS=86400

BETTER_AUTH_SECRET=local-better-auth-secret-32-chars
BETTER_AUTH_URL=http://localhost:3000
PANE_VIEW_USERNAME=traydr
PANE_VIEW_PASSWORD=replace-me
PANE_VIEW_SYNC_TOKEN=replace-me-for-lockstep
PANE_VIEW_TRUST_PROXY_HEADERS=false

LOCKSTEP_SOURCE=T:\cloud-desktop\media
LOCKSTEP_API_URL=http://localhost:3000
LOCKSTEP_API_TOKEN=replace-me-for-lockstep
