# -----------------------------------------------------------------------------
# Shared (PostgreSQL, object storage, CDN signing)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/latch_works
S3_ENDPOINT=https://example.railway.app
S3_REGION=auto
S3_BUCKET=latch-works-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
MEDIA_DELIVERY_SECRET=replace-with-at-least-32-random-characters
MEDIA_DELIVERY_TTL_SECONDS=86400
# Bearer secret shared by Pane View and media-optimizer (min 16 chars).
# MEDIA_OPTIMIZER_TOKEN=replace-with-a-long-random-secret

# Bunny CDN image delivery (production)
# BUNNY_CDN_HOST=cdn.latch-works.traydr.dev
# VITE_BUNNY_CDN_HOST=cdn.latch-works.traydr.dev
# IMAGE_DELIVERY_MODE=bunny
# VITE_IMAGE_DELIVERY_MODE=bunny
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
PANE_VIEW_USERNAME=traydr
PANE_VIEW_PASSWORD=replace-me
PANE_VIEW_SYNC_TOKEN=replace-me-for-lockstep
# Set true only when a trusted reverse proxy sets x-forwarded-for / x-real-ip
PANE_VIEW_TRUST_PROXY_HEADERS=false
# Derivative generation: "inline" (Pane View generates) or "triggered" (the
# media-optimizer service generates). Defaults to "triggered" when
# MEDIA_OPTIMIZER_URL is set, otherwise "inline". In production, set
# DERIVATIVE_PROCESSING_MODE=triggered explicitly — see docs/runbooks/media-optimizer.md.
# DERIVATIVE_PROCESSING_MODE=triggered
# Base URL of the media-optimizer service; presence enables triggered mode.
# MEDIA_OPTIMIZER_URL=http://127.0.0.1:3200

# -----------------------------------------------------------------------------
# Media optimizer
# -----------------------------------------------------------------------------
# Pane View base URL reachable from the optimizer (private networking preferred).
# PANE_VIEW_INTERNAL_URL=http://127.0.0.1:3000
# MEDIA_OPTIMIZER_PORT=3200
# OPTIMIZER_BATCH_LIMIT=20
# OPTIMIZER_CLAIM_CHUNK=1
# OPTIMIZER_MAX_RUNTIME_MS=50000

# -----------------------------------------------------------------------------
# Lockstep
# -----------------------------------------------------------------------------
LOCKSTEP_SOURCE=T:\cloud-desktop\media
LOCKSTEP_API_URL=http://localhost:3000
LOCKSTEP_API_TOKEN=replace-me-for-lockstep
