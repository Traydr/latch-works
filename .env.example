# -----------------------------------------------------------------------------
# Shared (PostgreSQL and object storage)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/latch_works
S3_ENDPOINT=https://example.railway.app
S3_REGION=auto
S3_BUCKET=latch-works-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
SHUTTER_EDGE_URL=https://replace-with-shutter-edge-url
SHUTTER_CONTROL_URL=https://replace-with-shutter-control-url
SHUTTER_SPACE_ID=pane-view
SHUTTER_SPACE_API_TOKEN=replace-with-pane-view-space-api-token
# SHUTTER_CAPABILITY_KID is the registry key name (e.g. key-id), not the secret bytes.
# Key material may be 32-byte base64url or a 64-char hex string.
# Nested layout: {"pane-view":{"key-id":"<secret>"}}. Flat layout: {"key-id":"<secret>"}.
SHUTTER_CAPABILITY_KEYS='{"pane-view":{"key-id":"base64url-32-byte-key"}}'
SHUTTER_CAPABILITY_KID=key-id
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
PANE_VIEW_USERNAME=admin
PANE_VIEW_PASSWORD=replace-me
PANE_VIEW_SYNC_TOKEN=replace-me-for-lockstep
# Set true only when a trusted reverse proxy sets x-forwarded-for / x-real-ip
PANE_VIEW_TRUST_PROXY_HEADERS=false
# -----------------------------------------------------------------------------
# Lockstep
# -----------------------------------------------------------------------------
LOCKSTEP_SOURCE=T:\cloud-desktop\media
LOCKSTEP_API_URL=http://localhost:3000
LOCKSTEP_API_TOKEN=replace-me-for-lockstep
