{
  "name": "latch-works",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "build:all": "pnpm -r run build && pnpm -r run package",
    "format": "biome format --write .",
    "lint:biome": "biome check .",
    "lint:oxlint": "oxlint",
    "lint:all": "pnpm run lint:biome && pnpm run lint:oxlint",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @latch-works/e2e e2e",
    "e2e:pane": "pnpm --filter @latch-works/e2e e2e:pane",
    "typecheck": "pnpm -r typecheck",
    "knip": "knip",
    "check:all": "pnpm run build:all && pnpm run format && pnpm run lint:all && pnpm run typecheck && pnpm run knip",
    "e2e:frame": "pnpm --filter @latch-works/e2e e2e:frame"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@oxlint/plugins": "1.78.0",
    "@types/node": "^25.9.1",
    "knip": "^6.15.0",
    "lodash": "4.18.1",
    "oxlint": "1.78.0",
    "railway": "^3.3.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.3"
  }
}
