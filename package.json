{
  "name": "latch-works",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "build": "pnpm -r build",
    "check:packages": "pnpm -r --filter './apps/*' --filter './packages/*' --sort --if-present check",
    "check": "pnpm -r --sort build && pnpm run check:packages && pnpm run lint && pnpm run knip",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "knip": "knip",
    "dev:lockstep": "pnpm --filter @latch-works/lockstep-app start",
    "dev:pane": "pnpm --filter @latch-works/pane-view dev",
    "dev:showcase": "pnpm --filter @latch-works/showcase dev",
    "start:lockstep": "pnpm --filter @latch-works/lockstep start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^25.9.1",
    "knip": "^6.15.0",
    "lodash": "4.18.1",
    "railway": "^3.3.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  }
}
