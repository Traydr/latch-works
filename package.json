{
  "name": "latch-works",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r --sort build && pnpm -r test && pnpm -r typecheck",
    "dev:pane": "pnpm --filter @latch-works/pane-view dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lockstep": "pnpm --filter @latch-works/lockstep start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^25.5.2",
    "knip": "^6.15.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  }
}
