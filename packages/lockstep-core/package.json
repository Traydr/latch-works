{
  "name": "@latch-works/lockstep-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@latch-works/media-domain": "workspace:*",
    "@latch-works/sync-protocol": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@latch-works/conformance": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
