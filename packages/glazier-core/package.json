{
  "name": "@latch-works/glazier-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@latch-works/media-domain": "workspace:*",
    "@latch-works/media-format": "workspace:*",
    "@latch-works/media-index": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jsquash/avif": "2.1.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
