{
  "name": "@latch-works/media-derivatives",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./descriptor": {
      "types": "./dist/descriptor.d.ts",
      "default": "./dist/descriptor.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm typecheck && pnpm test",
    "test": "vitest run",
    "analyze-thumbnail-sizes": "tsx scripts/analyze-thumbnail-sizes.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@latch-works/media-delivery": "workspace:*",
    "@latch-works/media-domain": "workspace:*",
    "@latch-works/media-storage": "workspace:*",
    "@napi-rs/canvas": "^1.0.2",
    "ffmpeg-static": "^5.3.0",
    "pdfjs-dist": "^6.0.227",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  }
}
