{
  "name": "@latch-works/pane-view",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm typecheck && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js dev --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.13",
    "@better-auth/memory-adapter": "^1.6.13",
    "@fontsource-variable/geist": "^5.2.9",
    "@latch-works/media-domain": "workspace:*",
    "@latch-works/media-storage": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-router": "^1.120.20",
    "@tanstack/react-start": "^1.120.20",
    "better-auth": "^1.6.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.562.0",
    "nitro": "3.0.260429-beta",
    "postgres": "^3.4.7",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.2",
    "vite": "8.0.11",
    "vitest": "^4.1.3"
  },
  "packageManager": "pnpm@11.1.0"
}
