{
  "name": "@latch-works/lockstep-app",
  "productName": "Lockstep",
  "version": "0.1.0",
  "description": "Desktop sync client for Latch Works media archives",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "postinstall": "node ./scripts/ensure-electron.mjs",
    "prestart": "node ./scripts/ensure-workspace-deps.mjs && node ./scripts/ensure-electron.mjs",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run test",
    "test": "vitest run"
  },
  "author": {
    "name": "Traydr",
    "email": "Traydr@protonmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "^1.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@tailwindcss/postcss": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "41.1.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.3.0",
    "jsdom": "^27.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@latch-works/lockstep-core": "workspace:*",
    "better-result": "^2.8.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  }
}
