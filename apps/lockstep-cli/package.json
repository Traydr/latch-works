{
  "name": "@latch-works/lockstep",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "lockstep": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test",
