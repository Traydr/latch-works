{
  "name": "@latch-works/glazier-app",
  "productName": "Glazier",
  "version": "0.1.0",
  "description": "Desktop workbench for auditing and tidying a local Latch Works archive",
  "main": ".vite/build/main.cjs",
  "private": true,
  "scripts": {
    "prestart": "node ./scripts/ensure-workspace-deps.mjs && node ./scripts/ensure-electron.mjs",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run test",
    "test": "vitest run --passWithNoTests"
  },
  "author": {
    "name": "Traydr",
    "email": "Traydr@protonmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@jsquash/avif": "2.1.1",
    "@latch-works/app-data": "workspace:*",
    "@latch-works/glazier-core": "workspace:*",
    "@latch-works/media-format": "workspace:*",
    "electron-squirrel-startup": "^1.0.1",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.57.0",
    "mediabunny": "1.61.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}
