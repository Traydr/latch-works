            "codec_type": "video",
            "codec_name": "h264",
            "width": 1920,
            "height": 1080,
            "duration": "12.345678"
          },
          { "codec_type": "audio", "codec_name": "aac", "duration": "12.4" }
        ],
        "format": { "duration": "12.400000", "bit_rate": "5123456" }
      },
