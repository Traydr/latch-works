{
  "manifest_version": 3,
  "name": "Gather Box",
  "description": "Download original images, videos, and story PDFs from supported content pages into a chosen local folder.",
  "version": "0.2.0",
  "minimum_chrome_version": "145",
  "action": {
    "default_title": "Gather Box"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-gather-box": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Toggle Gather Box"
    },
    "download-active-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Comma",
        "mac": "Command+Shift+Comma"
      },
      "description": "Download content from the active tab"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "declarativeNetRequestWithHostAccess",
    "contextMenus",
    "sidePanel",
    "offscreen"
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "pixiv_referer",
        "enabled": true,
        "path": "rules/pixiv-referer.json"
      },
      {
        "id": "redgifs_api_headers",
        "enabled": true,
        "path": "rules/redgifs-api.json"
      }
    ]
  }
}
