{
  "about": "Written by packages/lockstep-core/src/conformance.test.ts; ORIEL_UPDATE_VECTORS=1 rewrites it.",
  "cases": [
    {
      "name": "nothing configured",
      "options": {},
      "checks": [{ "label": "API URL", "ok": false }, { "label": "API token", "ok": false }],
      "ok": false,
      "summary": { "failed": 1, "message": "Some checks failed.", "status": "failed" }
    },
    {
      "name": "a source folder alone",
      "options": { "sourceRoot": "<root>/archive" },
      "checks": [
        { "detail": "<root>/archive", "label": "Source path", "ok": true },
        { "label": "API URL", "ok": false },
        { "label": "API token", "ok": false }
      ],
      "ok": false,
      "summary": { "failed": 1, "message": "Some checks failed.", "status": "failed" }
    },
    {
      "name": "a source that is a file",
      "options": { "sourceRoot": "<root>/file.jpg" },
      "checks": [
        { "detail": "<root>/file.jpg", "label": "Source path", "ok": false },
        { "label": "API URL", "ok": false },
        { "label": "API token", "ok": false }
      ],
      "ok": false,
      "summary": { "failed": 1, "message": "Some checks failed.", "status": "failed" }
    },
    {
      "name": "a missing source",
      "options": { "sourceRoot": "<root>/missing" },
      "checks": [
        {
          "detail": "<root>/missing (ENOENT: no such file or directory, stat '<root>/missing')",
          "label": "Source path",
          "ok": false
        },
        { "label": "API URL", "ok": false },
        { "label": "API token", "ok": false }
      ],
      "ok": false,
      "summary": { "failed": 1, "message": "Some checks failed.", "status": "failed" }
    },
    {
      "name": "a source under a file",
      "options": { "sourceRoot": "<root>/file.jpg/inner" },
      "checks": [
        {
          "detail": "<root>/file.jpg/inner (ENOTDIR: not a directory, stat '<root>/file.jpg/inner')",
          "label": "Source path",
          "ok": false
        },
        { "label": "API URL", "ok": false },
        { "label": "API token", "ok": false }
      ],
      "ok": false,
      "summary": { "failed": 1, "message": "Some checks failed.", "status": "failed" }
    },
    {
      "name": "a URL without a token",
      "options": { "apiUrl": "http://127.0.0.1:3100" },
      "checks": [
        { "detail": "http://127.0.0.1:3100", "label": "API URL", "ok": true },
        { "label": "API token", "ok": false }
      ],
      "ok": false,
      "summary": { "failed": 1, "message": "Some checks failed.", "status": "failed" }
    },
    {
      "name": "a token without a URL",
      "options": { "apiToken": "secret" },
      "checks": [{ "label": "API URL", "ok": false }, { "label": "API token", "ok": true }],
      "ok": false,
      "summary": { "failed": 1, "message": "Some checks failed.", "status": "failed" }
    },
    {
      "name": "a port nothing listens on",
      "options": { "apiUrl": "http://<address>", "apiToken": "secret" },
      "api": { "kind": "closed" },
      "checks": [
        { "detail": "http://<address>", "label": "API URL", "ok": true },
        { "label": "API token", "ok": true },
        {
          "detail": "Could not reach Pane View at http://<address>: connect ECONNREFUSED <address>",
          "label": "API snapshot",
          "ok": false
        }
      ],
      "ok": false,
      "summary": { "failed": 1, "message": "Some checks failed.", "status": "failed" }
    },
    {
      "name": "a token Pane View refuses",
      "options": { "apiUrl": "http://<address>", "apiToken": "wrong" },
      "api": { "kind": "answer", "status": 401, "body": "Unauthorized" },
      "checks": [
        { "detail": "http://<address>", "label": "API URL", "ok": true },
        { "label": "API token", "ok": true },
        {
          "detail": "/api/sync/snapshot failed with 401: Unauthorized",
          "label": "API snapshot",
          "ok": false
        }
      ],
      "ok": false,
      "summary": { "failed": 1, "message": "Some checks failed.", "status": "failed" }
    },
    {
      "name": "everything answers",
      "options": {
        "sourceRoot": "<root>/archive",
        "apiUrl": "http://<address>",
        "apiToken": "secret"
      },
      "api": {
        "kind": "answer",
        "status": 200,
        "body": "{\"entries\":[{\"path\":\"a.jpg\",\"size\":1},{\"path\":\"b.png\",\"size\":2}],\"status\":\"ok\"}"
      },
      "checks": [
        { "detail": "<root>/archive", "label": "Source path", "ok": true },
        { "detail": "http://<address>", "label": "API URL", "ok": true },
        { "label": "API token", "ok": true },
        { "detail": "2 remote entries", "label": "API snapshot", "ok": true }
      ],
      "ok": true,
      "summary": { "failed": 0, "message": "All checks passed.", "status": "completed" }
    }
  ]
}
