{
  "name": "@latch-works/showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "pnpm typecheck && pnpm build",
    "screenshots": "node scripts/prepare-showcase-media.mjs && node scripts/capture-screenshots.mjs",
    "screenshots:install-browser": "pnpm exec browsers install chrome@stable",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/node": "^9.5.2",
    "@astrojs/react": "^4.4.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource/barlow": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/courier-prime": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-serif": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "astro": "^5.17.2",
    "lucide-react": "^0.562.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.0.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "puppeteer-core": "24.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@11.1.0"
}
