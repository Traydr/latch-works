{
  "name": "@latch-works/showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "pnpm typecheck && pnpm build",
    "screenshots": "node scripts/prepare-showcase-media.mjs && node scripts/capture-screenshots.mjs",
    "screenshots:install-browser": "pnpm exec browsers install chrome@stable",
    "typecheck": "tsc --noEmit && astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^6.0.6",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "puppeteer-core": "25.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@11.1.0"
}
