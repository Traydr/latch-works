---
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/500.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import { getCollection } from "astro:content";
import DocsSidebarNav from "@/components/DocsSidebarNav.astro";
import { groupDocsBySection } from "@/data/docs-nav";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const sections = groupDocsBySection(await getCollection("docs"));
const currentPath = Astro.url.pathname;
---

<BaseLayout title={`${title} — Latch Works Docs`} description={description}>
  <a class="skip" href="#docs-content">Skip to content</a>

  <div class="docs-shell">
    <aside class="mobile-nav">
      <details>
        <summary>
          <span>Docs menu</span>
          <span class="hint">Sections</span>
        </summary>
        <div class="menu-body" data-docs-scroll>
          <DocsSidebarNav sections={sections} currentPath={currentPath} />
        </div>
      </details>
    </aside>

    <div class="sidebar-column">
      <p class="docs-title">Documentation</p>
      <aside class="sidebar" data-docs-scroll>
        <DocsSidebarNav sections={sections} currentPath={currentPath} />
      </aside>
    </div>

    <article id="docs-content" class="prose-docs">
      <slot />
    </article>
  </div>
</BaseLayout>

<script>
  function scrollActiveDocsLink() {
    for (const container of document.querySelectorAll("[data-docs-scroll]")) {
      if (!(container instanceof HTMLElement)) continue;
      const active = container.querySelector(".link.active");
      if (!(active instanceof HTMLElement)) continue;

      const containerRect = container.getBoundingClientRect();
      const activeRect = active.getBoundingClientRect();
      const delta =
        activeRect.top -
        containerRect.top -
        container.clientHeight / 2 +
        activeRect.height / 2;
      container.scrollTop += delta;
    }
  }

  scrollActiveDocsLink();
  document.addEventListener("astro:page-load", scrollActiveDocsLink);
</script>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 1rem;
    z-index: 60;
    padding: 0.55rem 0.85rem;
    background: #2a2e35;
    color: #e8eaed;
    font:
      700 0.72rem/1 "JetBrains Mono",
      monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid #3a404a;
  }
  .skip:focus {
    left: 1rem;
  }

  .docs-shell {
    display: grid;
    gap: 1.5rem;
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3.5rem;
    background: #16181c;
    color: #e8eaed;
    font-family: "Barlow", sans-serif;
  }

  .sidebar-column {
    display: none;
    min-width: 0;
    align-self: start;
  }

  .docs-title {
    margin: 0 0 0.85rem;
    font:
      700 clamp(1.55rem, 2.2vw, 1.85rem)/1 "Barlow Condensed",
      sans-serif;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: #e8eaed;
  }

  .sidebar {
    border: 1px solid #2a2e35;
    background: #1a1d22;
    padding: 1.1rem 0.65rem 1.25rem;
    max-height: calc(100vh - 8.5rem);
    overflow-y: auto;
  }

  .mobile-nav details {
    border: 1px solid #2a2e35;
    background: #1a1d22;
  }
  .mobile-nav summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    font:
      700 0.72rem/1 "JetBrains Mono",
      monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #e8eaed;
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav .hint {
    color: #8a8f98;
    font-weight: 700;
  }
  .menu-body {
    max-height: 50vh;
    overflow-y: auto;
    border-top: 1px solid #2a2e35;
    padding: 0.65rem 0.35rem 0.85rem;
  }

  .prose-docs {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .docs-shell {
      grid-template-columns: 260px minmax(0, 1fr);
      gap: 2.5rem;
      padding-block: 2.5rem 4rem;
    }
    .mobile-nav {
      display: none;
    }
    .sidebar-column {
      display: block;
      position: sticky;
      top: 5.25rem;
      grid-column: 1;
      grid-row: 1;
    }
    .prose-docs {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
