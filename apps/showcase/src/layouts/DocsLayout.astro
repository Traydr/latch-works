---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { groupDocsBySection } from "@/data/docs-nav";
import DocsV1 from "@/variants/v1/Docs.astro";
import DocsV2 from "@/variants/v2/Docs.astro";
import DocsV3 from "@/variants/v3/Docs.astro";
import DocsV4 from "@/variants/v4/Docs.astro";
import DocsV5 from "@/variants/v5/Docs.astro";
import ShellV1 from "@/variants/v1/Shell.astro";
import ShellV2 from "@/variants/v2/Shell.astro";
import ShellV3 from "@/variants/v3/Shell.astro";
import ShellV4 from "@/variants/v4/Shell.astro";
import ShellV5 from "@/variants/v5/Shell.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const sections = groupDocsBySection(await getCollection("docs"));
const currentPath = Astro.url.pathname;
---

<BaseLayout title={`${title} — Latch Works Docs`} description={description}>
  <div data-variant="1" class="variant-root">
    <ShellV1>
      <DocsV1 sections={sections} currentPath={currentPath}><slot /></DocsV1>
    </ShellV1>
  </div>
  <div data-variant="2" class="variant-root">
    <ShellV2 sections={sections} currentPath={currentPath} showDocsNav>
      <DocsV2 currentPath={currentPath}><slot /></DocsV2>
    </ShellV2>
  </div>
  <div data-variant="3" class="variant-root">
    <ShellV3>
      <DocsV3 sections={sections} currentPath={currentPath}><slot /></DocsV3>
    </ShellV3>
  </div>
  <div data-variant="4" class="variant-root">
    <ShellV4>
      <DocsV4 sections={sections} currentPath={currentPath}><slot /></DocsV4>
    </ShellV4>
  </div>
  <div data-variant="5" class="variant-root">
    <ShellV5>
      <DocsV5 sections={sections} currentPath={currentPath}><slot /></DocsV5>
    </ShellV5>
  </div>
</BaseLayout>
