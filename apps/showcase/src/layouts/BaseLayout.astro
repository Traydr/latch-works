---
import { VariantSwitcher } from "@/components/VariantSwitcher";
import { defaultVariant, variantStorageKey } from "@/data/variants";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Latch Works",
  description = "Latch Works — a private media archive ecosystem for collecting, syncing, and viewing personal media across desktop, web, and the browser.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-active-variant={defaultVariant}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline define:vars={{ variantStorageKey, defaultVariant }}>
      try {
        const stored = localStorage.getItem(variantStorageKey);
        const legacy = localStorage.getItem("latch-showcase-theme");
        const value = stored ?? (legacy && ["1", "2", "3", "4", "5"].includes(legacy) ? legacy : null);
        if (value) {
          document.documentElement.dataset.activeVariant = value;
        }
      } catch {}
    </script>
  </head>
  <body>
    <slot />
    <VariantSwitcher client:load />
  </body>
</html>
