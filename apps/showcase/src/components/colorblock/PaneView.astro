---
/**
 * Pane View product page — Colorblock design system.
 * Sky enamel #38A8E8 with dark ink, overlapped image panes, delivery rail.
 */
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/500.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import type { Product } from "@/data/products";

interface Props {
  product: Product;
}
const { product } = Astro.props;
---

<div class="page">
  <a class="back" href="/">← All stages</a><section class="hero">
    <i></i><i></i><i></i><i></i><p>STAGE 04 / VIEW</p><h1>
      {product.name}
    </h1><strong>{product.tagline}</strong><p class="desc">
      {product.description}
    </p><div class="spec">
      PATH <b>{product.repoPath}</b><br />TYPE <b>{product.kind}</b><br />ROLE <b
        >authenticated web viewing</b>
    </div>
  </section><section class="panes">
    <figure class="main-shot">
      <img
        src={product.heroScreenshot.src}
        alt={product.heroScreenshot.alt}
      /><figcaption>{product.heroScreenshot.caption}</figcaption>
    </figure>{
      product.gallery.map((shot, index) => (
        <figure class:list={["side-shot", `s${index}`]}>
          <>
            <img src={shot.src} alt={shot.alt} />
            <figcaption>{shot.caption}</figcaption>
          </>
        </figure>
      ))
    }
  </section><section class="delivery">
    <p>DELIVERY SPEC</p><div>
      <b>SIGNED</b><span
        >Thumbnails and previews resolve through signed CDN tokens.</span>
    </div><div>
      <b>READ-ONLY</b><span
        >Pane View indexes what Lockstep explicitly pushes.</span>
    </div>
  </section><section class="features">
    {
      product.features.map((feature) => (
        <article>
          <>
            <i />
            <h2>{feature.title}</h2>
            <p>{feature.description}</p>
          </>
        </article>
      ))
    }
  </section><aside>
    {product.highlights.map((highlight) => <span>{highlight}</span>)}
  </aside><a class="manual" href={`/docs/${product.slug}`}>Service manual →</a>
</div>
<style>
  .page {
    --sky: #38a8e8;
    background: #16181c;
    color: #e8eaed;
    min-height: 100vh;
    padding: 1.3rem;
    font-family: "Barlow", sans-serif;
    overflow: hidden;
  }
  .back {
    font:
      700 0.73rem "JetBrains Mono",
      monospace;
    color: #e8eaed;
    text-transform: uppercase;
    text-decoration: none;
  }
  .hero {
    position: relative;
    background: var(--sky);
    color: #151310;
    padding: clamp(2.5rem, 6vw, 6rem);
    margin-top: 1.5rem;
  }
  .hero i,
  .features i {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 2px solid #151310;
  }
  .features i {
    border-color: var(--sky);
  }
  .hero i:nth-of-type(1) {
    top: 15px;
    left: 15px;
    border-right: 0;
    border-bottom: 0;
  }
  .hero i:nth-of-type(2) {
    top: 15px;
    right: 15px;
    border-left: 0;
    border-bottom: 0;
  }
  .hero i:nth-of-type(3) {
    bottom: 15px;
    left: 15px;
    border-right: 0;
    border-top: 0;
  }
  .hero i:nth-of-type(4) {
    bottom: 15px;
    right: 15px;
    border-left: 0;
    border-top: 0;
  }
  .hero > p:not(.desc),
  .spec,
  figcaption,
  aside,
  .delivery p {
    font:
      700 0.65rem/1.5 "JetBrains Mono",
      monospace;
    letter-spacing: 0.07em;
  }
  .hero h1,
  h2 {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.78;
    letter-spacing: -0.03em;
    margin: 0.8rem 0;
  }
  .hero h1 {
    font-size: clamp(5.5rem, 15vw, 14rem);
  }
  .hero strong {
    font:
      500 clamp(1.3rem, 2.2vw, 2rem) "Barlow",
      sans-serif;
  }
  .desc {
    font:
      400 1.1rem/1.45 "Barlow",
      sans-serif;
    max-width: 55rem;
  }
  .spec {
    border-top: 1px solid #15131055;
    padding-top: 0.8rem;
  }
  .spec b {
    font-weight: 400;
    margin-left: 1rem;
  }
  .panes {
    height: min(760px, 65vw);
    min-height: 480px;
    position: relative;
    margin: 4rem 7vw;
  }
  .panes figure {
    position: absolute;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    margin: 0;
    background: var(--sky);
    padding: 0.65rem;
    box-shadow: 15px 18px 0 #0006;
  }
  .panes img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    filter: grayscale(1) contrast(1.12) brightness(1.02);
    mix-blend-mode: multiply;
    opacity: 0.92;
  }
  .panes figcaption {
    color: #151310;
    margin: 0.6rem 0 0;
  }
  .main-shot {
    inset: 2% 17% 2% 0;
    transform: rotate(-1.7deg);
  }
  .side-shot {
    width: 38%;
    height: 48%;
    right: 0;
  }
  .s0 {
    top: 0;
    transform: rotate(2.1deg);
  }
  .s1 {
    bottom: 0;
    transform: rotate(-2.3deg);
  }
  .delivery {
    display: grid;
    grid-template-columns: 1fr 1fr 1.2fr;
    border: 1px solid #2a2e35;
    margin: 0 5vw;
  }
  .delivery p {
    color: var(--sky);
    padding: 1.2rem;
    margin: 0;
    border-right: 1px solid #2a2e35;
  }
  .delivery div {
    padding: 1.2rem;
    border-right: 1px solid #2a2e35;
  }
  .delivery b {
    display: block;
    font:
      700 2rem "Barlow Condensed",
      sans-serif;
  }
  .delivery span {
    line-height: 1.35;
    color: #bec3ca;
  }
  .features {
    padding: 5rem 5vw;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .features article {
    position: relative;
    border: 1px solid #2a2e35;
    padding: 1.5rem;
    min-height: 185px;
  }
  .features i {
    top: 11px;
    right: 11px;
    border-left: 0;
    border-bottom: 0;
  }
  .features h2 {
    font-size: 2.35rem;
    color: var(--sky);
  }
  .features p {
    color: #c1c5cb;
    line-height: 1.4;
  }
  aside {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-block: 1px solid #2a2e35;
  }
  aside span {
    padding: 1rem;
    border-right: 1px solid #2a2e35;
  }
  .manual {
    display: block;
    background: var(--sky);
    color: #151310;
    margin: 4rem 5vw 1rem;
    padding: 1.2rem;
    text-align: center;
    text-decoration: none;
    font:
      700 2rem "Barlow Condensed",
      sans-serif;
    text-transform: uppercase;
  }
  a:focus-visible {
    outline: 3px solid white;
    outline-offset: 4px;
  }
  @media (max-width: 700px) {
    .hero h1 {
      font-size: clamp(5rem, 23vw, 8rem);
    }
    .panes {
      height: 610px;
      margin: 3rem 0;
    }
    .main-shot {
      inset: 0 5% 34% 0;
    }
    .side-shot {
      width: 62%;
      height: 30%;
    }
    .s0 {
      top: auto;
      bottom: 18%;
      right: 0;
    }
    .s1 {
      bottom: 0;
      right: 8%;
    }
    .delivery {
      grid-template-columns: 1fr;
      margin: 0;
    }
    .delivery p,
    .delivery div {
      border-right: 0;
      border-bottom: 1px solid #2a2e35;
    }
    .features {
      grid-template-columns: 1fr;
      padding-inline: 0;
    }
    aside {
      grid-template-columns: 1fr;
    }
    aside span {
      border-right: 0;
      border-bottom: 1px solid #2a2e35;
    }
    .manual {
      margin-inline: 0;
    }
  }
</style>
