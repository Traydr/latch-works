---
/**
 * Oriel product page (Colorblock design system).
 * Violet enamel #8B7CF6 with white stencil type in a dark steel display rig.
 * Three mode plates (View, Tidy, Sync) sit between the hero display and the feature grid.
 */
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/500.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import { type Product, pipelineStepsFor } from "@/data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;

const modes = product.modes ?? [];
---

<div class="page">
  <section class="hero">
    <i></i><i></i><i></i><i></i>
    <p>{pipelineStepsFor(product.slug)}</p>
    <h1>{product.name}</h1>
    <strong>{product.tagline}</strong>
    <p class="desc">{product.description}</p>
  </section>
  <section class="display">
    <img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} />
    <p>{product.heroScreenshot.caption}</p>
  </section>
  <section class="modes">
    {
      modes.map((mode, index) => (
        <article class:list={["mode", index % 2 === 1 && "reverse"]}>
          <div class="mode-copy">
            <p class="kicker">
              {String(index + 1).padStart(2, "0")} / {mode.kicker}
            </p>
            <h2>{mode.name}</h2>
            <strong>{mode.tagline}</strong>
            <p>{mode.description}</p>
            <ul>
              {mode.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
          <figure>
            <img src={mode.screenshot.src} alt={mode.screenshot.alt} />
            <figcaption>{mode.screenshot.caption}</figcaption>
          </figure>
        </article>
      ))
    }
  </section>
  <section class="gallery">
    {
      product.gallery.map((shot) => (
        <figure>
          <>
            <img src={shot.src} alt={shot.alt} />
            <figcaption>{shot.caption}</figcaption>
          </>
        </figure>
      ))
    }
  </section>
  <section class="features">
    {
      product.features.map((feature) => (
        <article>
          <>
            <h2>{feature.title}</h2>
            <p>{feature.description}</p>
          </>
        </article>
      ))
    }
  </section>
  <aside>
    {product.highlights.map((highlight) => <span>{highlight}</span>)}
  </aside>
  <a class="docs" href={`/docs/${product.slug}`}>Docs →</a>
</div>
<style>
  .page {
    --violet: #8b7cf6;
    background: #16181c;
    color: #e8eaed;
    min-height: 100vh;
    padding: 1.3rem;
    font-family: "Barlow", sans-serif;
  }
  .hero {
    position: relative;
    background: var(--violet);
    padding: clamp(2.5rem, 6vw, 6rem);
    margin-top: 0.4rem;
    color: #151310;
  }
  .hero > p:first-of-type,
  .kicker,
  figcaption,
  aside,
  .display > p {
    font:
      700 0.65rem/1.5 "JetBrains Mono",
      monospace;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .desc {
    font:
      400 1.1rem/1.45 "Barlow",
      sans-serif;
    max-width: 55rem;
    letter-spacing: 0;
    text-transform: none;
  }
  .hero h1,
  h2 {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.78;
    letter-spacing: -0.03em;
    margin: 0.8rem 0;
  }
  .hero h1 {
    font-size: clamp(5.5rem, 15vw, 14rem);
  }
  .hero strong {
    font:
      500 clamp(1.3rem, 2.2vw, 2rem) "Barlow",
      sans-serif;
  }
  .hero > i {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 2px solid #151310;
  }
  .hero > i:nth-of-type(1) {
    top: 13px;
    left: 13px;
    border-right: 0;
    border-bottom: 0;
  }
  .hero > i:nth-of-type(2) {
    top: 13px;
    right: 13px;
    border-left: 0;
    border-bottom: 0;
  }
  .hero > i:nth-of-type(3) {
    bottom: 13px;
    left: 13px;
    border-right: 0;
    border-top: 0;
  }
  .hero > i:nth-of-type(4) {
    bottom: 13px;
    right: 13px;
    border-left: 0;
    border-top: 0;
  }
  .display {
    position: relative;
    background: var(--violet);
    padding: 0.75rem;
    margin: clamp(2rem, 6vw, 6rem) auto 1.5rem;
    max-width: 1300px;
    transform: rotate(1.3deg);
    box-shadow: 18px 20px 0 #0006;
  }
  .display img {
    display: block;
    width: 100%;
    height: auto;
  }
  .display p {
    color: #151310;
    margin: 0.6rem 0 0;
  }
  .modes {
    display: grid;
    gap: 1px;
    background: #2a2e35;
    border: 1px solid #2a2e35;
    margin: clamp(3rem, 7vw, 6rem) 0 0;
  }
  .mode {
    display: grid;
    grid-template-columns: minmax(280px, 0.85fr) minmax(360px, 1.15fr);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: center;
    background: #1d2025;
    padding: clamp(2rem, 4vw, 4rem);
  }
  .mode.reverse .mode-copy {
    order: 2;
  }
  .mode.reverse figure {
    order: 1;
    transform: rotate(-1.4deg);
  }
  .kicker {
    color: var(--violet);
    margin: 0 0 0.4rem;
  }
  .mode h2 {
    font-size: clamp(4rem, 8vw, 7.5rem);
    color: #e8eaed;
  }
  .mode-copy strong {
    display: block;
    font:
      500 clamp(1.15rem, 1.8vw, 1.5rem) "Barlow",
      sans-serif;
    color: var(--violet);
    margin-bottom: 0.9rem;
  }
  .mode-copy p:not(.kicker) {
    line-height: 1.45;
    color: #c1c5cb;
    margin: 0 0 1rem;
  }
  .mode-copy ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.45rem;
    border-top: 1px solid #2a2e35;
    padding-top: 0.9rem;
  }
  .mode-copy li {
    color: #c1c5cb;
    line-height: 1.4;
    padding-left: 1.1rem;
    position: relative;
  }
  .mode-copy li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    background: var(--violet);
  }
  .mode figure {
    margin: 0;
    background: var(--violet);
    padding: 0.6rem;
    transform: rotate(1.4deg);
    box-shadow: 12px 14px 0 #0005;
  }
  .mode img,
  .gallery img {
    display: block;
    width: 100%;
  }
  .mode figcaption,
  .gallery figcaption {
    color: #151310;
    margin: 0.6rem 0 0;
  }
  .gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    max-width: 1120px;
    margin: 4rem auto;
  }
  .gallery figure {
    margin: 0;
    background: var(--violet);
    padding: 0.6rem;
    transform: rotate(-1.7deg);
  }
  .gallery figure + figure {
    transform: rotate(1.8deg);
  }
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #2a2e35;
    border: 1px solid #2a2e35;
  }
  .features article {
    background: #1d2025;
    padding: 1.5rem;
    min-height: 170px;
  }
  .features h2 {
    font-size: 2.2rem;
    color: var(--violet);
  }
  .features p {
    line-height: 1.42;
    color: #c1c5cb;
  }
  aside {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-block: 1px solid #2a2e35;
    margin-top: 4rem;
  }
  aside span {
    padding: 1rem;
    border-right: 1px solid #2a2e35;
  }
  .docs {
    display: block;
    background: var(--violet);
    color: #151310;
    margin: 4rem 0 1rem;
    padding: 1.2rem;
    text-align: center;
    text-decoration: none;
    font:
      700 2rem "Barlow Condensed",
      sans-serif;
    text-transform: uppercase;
  }
  a:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }
  @media (max-width: 840px) {
    .mode {
      grid-template-columns: 1fr;
    }
    .mode.reverse .mode-copy,
    .mode.reverse figure {
      order: initial;
    }
    .mode h2 {
      font-size: clamp(3.5rem, 16vw, 6rem);
    }
  }
  @media (max-width: 700px) {
    .hero h1 {
      font-size: clamp(5rem, 23vw, 8rem);
    }
    .gallery,
    .features {
      grid-template-columns: 1fr;
    }
    .display {
      margin-inline: 0;
    }
    .gallery {
      margin-block: 3rem;
    }
    aside {
      grid-template-columns: 1fr;
    }
    aside span {
      border-right: 0;
      border-bottom: 1px solid #2a2e35;
    }
  }
</style>
