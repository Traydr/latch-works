---
/**
 * Gather Box product page — Colorblock design system.
 * Amber industrial enamel #F5A623 on steel #16181C, dark-ink stencil type.
 */
import "@fontsource/barlow-condensed/600.css"; import "@fontsource/barlow-condensed/700.css"; import "@fontsource/barlow/400.css"; import "@fontsource/barlow/500.css"; import "@fontsource/jetbrains-mono/400.css"; import "@fontsource/jetbrains-mono/700.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
const sources = ["Fanbox", "Kemono", "Archive of Our Own", "Fanfiction.net", "Hentai Foundry"];
---
<main><a class="back" href="/">← All stages</a><section class="nameplate"><i></i><i></i><i></i><i></i><p>STAGE 01 / COLLECT</p><h1>{product.name}</h1><strong>{product.tagline}</strong><p class="description">{product.description}</p><div class="spec">PATH <b>{product.repoPath}</b><br />TYPE <b>{product.kind}</b><br />ROLE <b>pipeline entry point</b></div></section><section class="visual"><figure><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><figcaption>{product.heroScreenshot.caption}</figcaption></figure><div class="sources"><p>COLLECTION SOURCES</p>{sources.map((source)=><b>{source}</b>)}</div></section><section class="tree"><p>FOLDER STRUCTURE / EXAMPLE</p><pre>~/archive → artist-name/series-title/post-title/001.jpg</pre></section><section class="features">{product.features.map((feature)=><article><i></i><i></i><h2>{feature.title}</h2><p>{feature.description}</p></article>)}</section><aside>{product.highlights.map((highlight)=><span>{highlight}</span>)}</aside><a class="manual" href={`/docs/${product.slug}`}>Service manual →</a></main>
<style>
main{--amber:#F5A623;background:#16181C;color:#E8EAED;padding:1.3rem;min-height:100vh;font-family:"Barlow",sans-serif}.back{font:700 .73rem "JetBrains Mono",monospace;color:#E8EAED;text-transform:uppercase;text-decoration:none}.nameplate{background:var(--amber);color:#151310;margin-top:1.5rem;padding:clamp(2.4rem,6vw,6rem);position:relative;border:1px solid #a86900}.nameplate>i,.features i{position:absolute;width:13px;height:13px;border-radius:50%;background:linear-gradient(45deg,transparent 42%,#151310 43% 57%,transparent 58%),radial-gradient(circle at 35% 30%,#fff8 0 13%,#151310 50%)}.nameplate>i:nth-of-type(1){top:15px;left:15px}.nameplate>i:nth-of-type(2){top:15px;right:15px}.nameplate>i:nth-of-type(3){bottom:15px;left:15px}.nameplate>i:nth-of-type(4){bottom:15px;right:15px}.nameplate p,.spec,.sources p,.tree p,figcaption,aside{font:700 .65rem/1.55 "JetBrains Mono",monospace;letter-spacing:.07em}.nameplate h1,h2{font-family:"Barlow Condensed",sans-serif;font-weight:700;text-transform:uppercase;line-height:.78;letter-spacing:-.03em;margin:.8rem 0}.nameplate h1{font-size:clamp(5.5rem,15vw,14rem)}.nameplate strong{font:500 clamp(1.3rem,2.2vw,2rem) "Barlow",sans-serif}.description{font:400 1.1rem/1.45 "Barlow",sans-serif;max-width:52rem;margin:1.6rem 0}.spec{border-top:1px solid #15131055;padding-top:.8rem}.spec b{font-weight:400;margin-left:1rem}.visual{padding:clamp(3rem,7vw,7rem) 5vw;display:grid;grid-template-columns:1.3fr .7fr;align-items:end;gap:3rem}.visual figure{background:var(--amber);padding:.7rem;margin:0;transform:rotate(-2deg);box-shadow:14px 16px 0 #0005}.visual img{display:block;width:100%;filter:grayscale(1) contrast(1.12) brightness(1.02);mix-blend-mode:multiply;opacity:.92}.visual figcaption{color:#151310;margin:.65rem 0 0}.sources{border:1px solid #2A2E35;padding:1rem}.sources p{color:#8A8F98;margin:0 0 .8rem}.sources b{display:block;border-top:1px solid #2A2E35;padding:.65rem 0;font:700 1.6rem "Barlow Condensed",sans-serif;text-transform:uppercase}.tree{background:#202329;border:1px solid #2A2E35;padding:clamp(1.5rem,4vw,3rem);margin:0 5vw}.tree p{color:var(--amber)}pre{font:400 clamp(.78rem,1.5vw,1rem)/1.6 "JetBrains Mono",monospace;margin:0;white-space:pre-wrap}.features{padding:5rem 5vw;display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.features article{position:relative;border:1px solid #2A2E35;padding:1.5rem;min-height:180px}.features article>i:nth-child(1){top:10px;left:10px}.features article>i:nth-child(2){bottom:10px;right:10px}.features h2{font-size:2.4rem;color:var(--amber)}.features p{line-height:1.4;color:#c0c4ca}aside{margin:0 5vw;border-block:1px solid #2A2E35;display:grid;grid-template-columns:repeat(4,1fr)}aside span{padding:1rem;border-right:1px solid #2A2E35}.manual{display:block;margin:4rem 5vw 2rem;background:var(--amber);color:#151310;padding:1.2rem;text-align:center;text-decoration:none;font:700 2rem "Barlow Condensed",sans-serif;text-transform:uppercase}a:focus-visible{outline:3px solid white;outline-offset:4px}@media(max-width:700px){.visual{grid-template-columns:1fr;padding-inline:1rem}.tree,aside,.manual{margin-inline:0}.features{grid-template-columns:1fr;padding-inline:0}aside{grid-template-columns:1fr}aside span{border-right:0;border-bottom:1px solid #2A2E35}.nameplate h1{font-size:clamp(5rem,23vw,8rem)}}
</style>
