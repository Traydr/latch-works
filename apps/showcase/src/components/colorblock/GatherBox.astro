---
/**
 * Gather Box product page — Colorblock design system.
 * Amber industrial enamel #F5A623 on steel #16181C, dark-ink stencil type.
 */
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/500.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import type { Product } from "@/data/products";

interface Props {
  product: Product;
}
const { product } = Astro.props;
const sources = ["X", "Reddit", "pixiv", "Archive of Our Own", "FanFiction.Net"];
---

<div class="page">
  <section class="nameplate">
    <i></i><i></i><i></i><i></i>
    <p>Gather</p>
    <h1>{product.name}</h1>
    <strong>{product.tagline}</strong>
    <p class="description">{product.description}</p>
  </section>
  <section class="visual">
    <figure>
      <img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} />
      <figcaption>{product.heroScreenshot.caption}</figcaption>
    </figure>
    <div class="sources">
      <p>Supported sources</p>
      {sources.map((source) => <b>{source}</b>)}
    </div>
  </section>
  <section class="tree">
    <p>Folder structure / example</p>
    <pre>~/archive → artist-name/series-title/post-title/001.jpg</pre>
  </section>
  <section class="features">
    {
      product.features.map((feature) => (
        <article>
          <>
            <i />
            <i />
            <h2>{feature.title}</h2>
            <p>{feature.description}</p>
          </>
        </article>
      ))
    }
  </section>
  <aside>
    {product.highlights.map((highlight) => <span>{highlight}</span>)}
  </aside>
  <a class="docs" href={`/docs/${product.slug}`}>Docs →</a>
</div>
<style>
  .page {
    --amber: #f5a623;
    background: #16181c;
    color: #e8eaed;
    padding: 1.3rem;
    min-height: 100vh;
    font-family: "Barlow", sans-serif;
  }
  .nameplate {
    background: var(--amber);
    color: #151310;
    margin-top: 0.4rem;
    padding: clamp(2.4rem, 6vw, 6rem);
    position: relative;
    border: 1px solid #a86900;
  }
  .nameplate > i,
  .features i {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 2px solid #151310;
  }
  .features i {
    border-color: var(--amber);
  }
  .nameplate > i:nth-of-type(1) {
    top: 15px;
    left: 15px;
    border-right: 0;
    border-bottom: 0;
  }
  .nameplate > i:nth-of-type(2) {
    top: 15px;
    right: 15px;
    border-left: 0;
    border-bottom: 0;
  }
  .nameplate > i:nth-of-type(3) {
    bottom: 15px;
    left: 15px;
    border-right: 0;
    border-top: 0;
  }
  .nameplate > i:nth-of-type(4) {
    bottom: 15px;
    right: 15px;
    border-left: 0;
    border-top: 0;
  }
  .nameplate > p:not(.description),
  .sources p,
  .tree p,
  figcaption,
  aside {
    font:
      700 0.65rem/1.55 "JetBrains Mono",
      monospace;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .nameplate h1,
  h2 {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.78;
    letter-spacing: -0.03em;
    margin: 0.8rem 0;
  }
  .nameplate h1 {
    font-size: clamp(5.5rem, 15vw, 14rem);
  }
  .nameplate strong {
    font:
      500 clamp(1.3rem, 2.2vw, 2rem) "Barlow",
      sans-serif;
  }
  .description {
    font:
      400 1.1rem/1.45 "Barlow",
      sans-serif;
    max-width: 52rem;
    margin: 1.6rem 0 0;
  }
  .visual {
    padding: clamp(3rem, 7vw, 7rem) 5vw;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(12rem, 0.7fr);
    align-items: end;
    gap: 3rem;
  }
  .visual figure {
    background: var(--amber);
    padding: 0.7rem;
    margin: 0;
    transform: rotate(-2deg);
    box-shadow: 14px 16px 0 #0005;
  }
  .visual img {
    display: block;
    width: 100%;
    height: auto;
  }
  .visual figcaption {
    color: #151310;
    margin: 0.65rem 0 0;
  }
  .sources {
    border: 1px solid #2a2e35;
    padding: 1rem;
  }
  .sources p {
    color: #8a8f98;
    margin: 0 0 0.8rem;
  }
  .sources b {
    display: block;
    border-top: 1px solid #2a2e35;
    padding: 0.65rem 0;
    font:
      700 1.6rem "Barlow Condensed",
      sans-serif;
    text-transform: uppercase;
  }
  .tree {
    background: #202329;
    border: 1px solid #2a2e35;
    padding: clamp(1.5rem, 4vw, 3rem);
    margin: 0 5vw;
  }
  .tree p {
    color: var(--amber);
  }
  pre {
    font:
      400 clamp(0.78rem, 1.5vw, 1rem)/1.6 "JetBrains Mono",
      monospace;
    margin: 0;
    white-space: pre-wrap;
  }
  .features {
    padding: 5rem 5vw;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .features article {
    position: relative;
    border: 1px solid #2a2e35;
    padding: 1.5rem;
    min-height: 180px;
  }
  .features article > i:nth-child(1) {
    top: 10px;
    left: 10px;
    border-right: 0;
    border-bottom: 0;
  }
  .features article > i:nth-child(2) {
    bottom: 10px;
    right: 10px;
    border-left: 0;
    border-top: 0;
  }
  .features h2 {
    font-size: 2.4rem;
    color: var(--amber);
  }
  .features p {
    line-height: 1.4;
    color: #c0c4ca;
  }
  aside {
    margin: 0 5vw;
    border-block: 1px solid #2a2e35;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  aside span {
    padding: 1rem;
    border-right: 1px solid #2a2e35;
  }
  .docs {
    display: block;
    margin: 4rem 5vw 2rem;
    background: var(--amber);
    color: #151310;
    padding: 1.2rem;
    text-align: center;
    text-decoration: none;
    font:
      700 2rem "Barlow Condensed",
      sans-serif;
    text-transform: uppercase;
  }
  a:focus-visible {
    outline: 3px solid white;
    outline-offset: 4px;
  }
  @media (max-width: 700px) {
    .visual {
      grid-template-columns: 1fr;
      padding-inline: 1rem;
    }
    .tree,
    aside,
    .docs {
      margin-inline: 0;
    }
    .features {
      grid-template-columns: 1fr;
      padding-inline: 0;
    }
    aside {
      grid-template-columns: 1fr;
    }
    aside span {
      border-right: 0;
      border-bottom: 1px solid #2a2e35;
    }
    .nameplate h1 {
      font-size: clamp(5rem, 23vw, 8rem);
    }
  }
</style>
