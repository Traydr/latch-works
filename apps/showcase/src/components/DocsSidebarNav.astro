---
import { type DocsSection, docNavLabel } from "@/data/docs-nav";

interface Props {
  sections: DocsSection[];
  currentPath: string;
}

const { sections, currentPath } = Astro.props;

/** Docs sections are named after products in content frontmatter; unknown sections get no accent. */
const sectionEnamel = new Map([
  ["Gather Box", "#F5A623"],
  ["Frame View", "#8B7CF6"],
  ["Lockstep", "#34C98E"],
  ["Pane View", "#38A8E8"],
]);
---

<nav class="docs-nav" aria-label="Docs">
  {
    sections.map((section) => {
      const enamel = sectionEnamel.get(section.name);
      return (
        <div class="section" style={enamel ? `--enamel:${enamel}` : undefined}>
          <p class="section-label">{section.name}</p>
          <div class="links">
            {section.pages.map((doc) => {
              const href = `/docs/${doc.id}`;
              const active = currentPath === href;
              return (
                <a href={href} class:list={["link", active && "active"]}>
                  {docNavLabel(doc)}
                </a>
              );
            })}
          </div>
        </div>
      );
    })
  }
</nav>

<style>
  .docs-nav {
    display: grid;
    gap: 1.35rem;
  }
  .section-label {
    margin: 0 0 0.4rem;
    padding: 0 0.75rem;
    font:
      700 0.58rem/1.3 "JetBrains Mono",
      monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--enamel, #8a8f98);
  }
  .links {
    display: grid;
    gap: 1px;
    background: #2a2e35;
    border: 1px solid #2a2e35;
  }
  .link {
    display: block;
    padding: 0.55rem 0.75rem;
    background: #1a1d22;
    color: #8a8f98;
    text-decoration: none;
    font:
      500 0.92rem/1.3 "Barlow",
      sans-serif;
  }
  .link:hover {
    color: #e8eaed;
    background: #20242a;
  }
  .link.active {
    color: #151310;
    background: var(--enamel, #e8eaed);
    font-weight: 700;
  }
  .section:not([style*="--enamel"]) .link.active {
    color: #e8eaed;
    background: #2a2e35;
  }
  a:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }
</style>
