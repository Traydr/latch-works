---
// PROTOTYPE: Pigment uses lab black, product pigments, Geist display type, and mono swatch labels.
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import { pipeline, products } from "@/data/products";

const pigments = {
  "gather-box": { hex: "#F5A623", name: "AMBER", ink: "#101014" },
  "frame-view": { hex: "#8B7CF6", name: "VIOLET", ink: "#F4F4F2" },
  lockstep: { hex: "#34C98E", name: "EMERALD", ink: "#101014" },
  "pane-view": { hex: "#38A8E8", name: "SKY", ink: "#101014" },
} as const;
---

<main>
  <section class="intro">
    <p class="lab-label">LATCH WORKS / MEDIA COLOR LAB</p>
    <h1>A private media archive, from collection to view.</h1>
    <p class="lede">Collect, sync, and view on your terms. Local-first tools for a personal archive.</p>
    <div class="pipeline" aria-label="Archive pipeline">
      <div class="gradient" aria-hidden="true"></div>
      <div class="stages">
        {pipeline.map((item) => <span><b>{item.step}</b>{item.product}</span>)}
      </div>
    </div>
  </section>

  <section class="products" aria-label="Products">
    {products
      .slice()
      .sort((a, b) => ["gather-box", "frame-view", "lockstep", "pane-view"].indexOf(a.slug) - ["gather-box", "frame-view", "lockstep", "pane-view"].indexOf(b.slug))
      .map((product, index) => {
        const pigment = pigments[product.slug as keyof typeof pigments];
        return (
          <article class="product" style={`--pigment:${pigment.hex};--ink:${pigment.ink}`}>
            <div class="product-copy">
              <p class="chip">PIGMENT 0{index + 1} · {pigment.name} · {pigment.hex}</p>
              <h2>{product.name}</h2>
              <p class="tagline">{product.tagline}</p>
              <a href={`/${product.slug}`}>Open <span aria-hidden="true">→</span></a>
            </div>
            <figure class="duotone">
              <img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} />
            </figure>
          </article>
        );
      })}
  </section>

  <footer>
    <p class="lab-label">WORKSHOP PRINCIPLES</p>
    <div class="principles">
      <section><h2>Local-first</h2><p>The archive on disk stays authoritative. Sync is explicit, never automatic mirroring.</p></section>
      <section><h2>Private by default</h2><p>Web viewing requires authentication. Delivery URLs are signed and time-limited.</p></section>
      <section><h2>Shared packages</h2><p>media-domain, media-index, media-storage, and lockstep-core keep behavior consistent.</p></section>
      <section><h2>Calm tooling</h2><p>Direct language, dark UI, practical spacing — a workshop, not a marketing site.</p></section>
    </div>
  </footer>
</main>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #101014; color: #f4f4f2; font-family: Geist Variable, Arial, sans-serif; }
  .intro { min-height: 84vh; padding: clamp(2rem, 6vw, 6rem); display: flex; flex-direction: column; justify-content: center; }
  .lab-label, .chip, .stages, footer h2 { font-family: "JetBrains Mono", monospace; letter-spacing: .04em; }
  .lab-label { color: #9a9aa3; font-size: .7rem; font-weight: 700; margin: 0 0 2rem; }
  h1 { font-size: clamp(4rem, 10.4vw, 10rem); line-height: .83; letter-spacing: -.085em; max-width: 1100px; margin: 0; font-weight: 700; }
  .lede { color: #9a9aa3; font-size: clamp(1rem, 1.6vw, 1.4rem); max-width: 540px; line-height: 1.45; margin: 2.5rem 0 4rem; }
  .pipeline { max-width: 820px; }
  .gradient { height: 14px; background: linear-gradient(90deg, #f5a623, #8b7cf6 35%, #34c98e 66%, #38a8e8); }
  .stages { display: grid; grid-template-columns: repeat(4, 1fr); font-size: .66rem; color: #9a9aa3; margin-top: .75rem; gap: 1rem; }
  .stages b { color: #f4f4f2; display: block; margin-bottom: .3rem; }
  .product { background: var(--pigment); color: var(--ink); min-height: 680px; display: grid; grid-template-columns: minmax(260px, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 6vw, 8rem); align-items: center; padding: clamp(2rem, 6vw, 6rem); overflow: hidden; }
  .product-copy { position: relative; z-index: 1; }
  .chip { border: 1px solid currentColor; display: inline-block; padding: .55rem .7rem; font-size: .68rem; font-weight: 700; margin: 0 0 2rem; }
  .product h2 { font-size: clamp(4.5rem, 9vw, 9.5rem); letter-spacing: -.09em; line-height: .78; margin: 0; max-width: 630px; }
  .tagline { font-size: clamp(1.1rem, 1.8vw, 1.55rem); max-width: 330px; line-height: 1.25; margin: 2rem 0; }
  a { color: inherit; font-weight: 700; text-underline-offset: .25em; }
  a span { font-size: 1.4em; }
  a:focus-visible { outline: 3px solid currentColor; outline-offset: 5px; }
  .duotone { margin: 0; background: var(--pigment); box-shadow: 18px 18px 0 color-mix(in srgb, var(--ink) 20%, transparent); overflow: hidden; transform: rotate(-2deg); }
  .duotone img { display: block; width: 100%; min-height: 400px; max-height: 620px; object-fit: cover; filter: grayscale(1) contrast(1.1) brightness(1.02); mix-blend-mode: multiply; opacity: .92; }
  footer { padding: clamp(3rem, 6vw, 6rem); }
  .principles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; border-top: 1px solid #36363d; padding-top: 1.25rem; }
  footer h2 { font-size: .72rem; margin: 0 0 .8rem; color: #f4f4f2; }
  footer section p { color: #9a9aa3; margin: 0; font-size: .85rem; line-height: 1.55; }
  @media (max-width: 700px) { .intro { min-height: 760px; } .stages { grid-template-columns: repeat(2, 1fr); row-gap: 1.2rem; } .product { min-height: auto; grid-template-columns: 1fr; padding: 3rem 1.4rem; } .product h2 { font-size: clamp(4.2rem, 20vw, 6rem); } .duotone { margin: 1rem 0 .5rem; } .duotone img { min-height: 250px; } .principles { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 390px) { .principles { grid-template-columns: 1fr; } }
</style>
