---
import "@fontsource/courier-prime/400.css";
import "@fontsource/courier-prime/700.css";
import { products } from "@/data/products";
const pipelineProducts = ["gather-box", "frame-view", "lockstep", "pane-view"].flatMap((slug) =>
  products.filter((product) => product.slug === slug),
);
---

<!-- PROTOTYPE: Dossier tokens — manila #D8C496/#C4AF7D, paper #F4EEDF, ink #23211B, dim #6B6353, red pencil #B23A25, redaction #1C1A16; Courier Prime throughout; tabs, clips, restrained paper grain. -->
<main class="dossier">
  <section class="cover" aria-labelledby="case-title">
    <p class="case-number">CASE FILE / LW-04</p>
    <div class="cover-tab">ARCHIVE DOSSIER</div>
    <h1 id="case-title">LATCH<br />WORKS</h1>
    <dl>
      <div><dt>SUBJECT</dt><dd>Latch Works</dd></div>
      <div><dt>CONTENTS</dt><dd>4 tools, one archive</dd></div>
      <div><dt>STATUS</dt><dd>private, local-first; <span class="redaction">public media URLs</span> not issued</dd></div>
    </dl>
    <p class="stamp">PRIVATE</p>
  </section>

  <section class="files" aria-label="Archive pipeline case files">
    {pipelineProducts.map((product, index) => (
      <article class:list={["file", `file-${index}`]}>
        <div class="tab">{String(index + 1).padStart(2, "0")} / {product.name}</div>
        <div class="clip" aria-hidden="true"></div>
        <img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} loading="lazy" />
        <div class="file-copy">
          <p class="file-path">{product.repoPath}</p>
          <h2>{product.tagline}</h2>
          <p>{product.description}</p>
          <a href={`/${product.slug}`}>Open file <span aria-hidden="true">→</span></a>
        </div>
      </article>
    ))}
  </section>

  <section class="notes" aria-labelledby="notes-title">
    <p class="case-number">CLOSING NOTES</p>
    <h2 id="notes-title">WORKING PRINCIPLES</h2>
    <div class="note-grid">
      <article><h3>Local-first</h3><p>The archive on disk stays authoritative. Sync is explicit, never automatic mirroring.</p></article>
      <article><h3>Private by default</h3><p>Web viewing requires authentication. Delivery URLs are signed and time-limited.</p></article>
      <article><h3>Shared packages</h3><p>media-domain, media-index, media-storage, and lockstep-core keep behavior consistent.</p></article>
      <article><h3>Calm tooling</h3><p>Direct language, dark UI, practical spacing — a workshop, not a marketing site.</p></article>
    </div>
  </section>
</main>

<style>
  .dossier { --manila:#d8c496; --deep:#c4af7d; --paper:#f4eedf; --ink:#23211b; --dim:#6b6353; --red:#b23a25; --black:#1c1a16; max-width:1180px; margin:auto; padding:clamp(1.25rem,4vw,4rem) 1rem 5rem; color:var(--ink); font-family:"Courier Prime",monospace; background-color:var(--paper); background-image:repeating-linear-gradient(0deg,transparent 0 3px,#23211b05 4px); }
  .cover { position:relative; max-width:690px; padding:clamp(2rem,6vw,5.5rem); margin:0 auto 4rem; background:var(--manila); border:1px solid #9e8b60; box-shadow:7px 9px 0 #23211b24; }
  .cover-tab,.tab { position:absolute; top:-1px; left:2rem; transform:translateY(-100%); padding:.55rem 1.1rem .45rem; background:var(--manila); border:1px solid #9e8b60; border-bottom:0; font-weight:700; letter-spacing:.08em; font-size:.8rem; }
  .cover h1,.notes h2 { font-size:clamp(3rem,10vw,7rem); line-height:.82; letter-spacing:-.08em; margin:1.8rem 0 2.2rem; font-weight:700; }
  .case-number,.file-path { color:var(--dim); font-size:.73rem; letter-spacing:.1em; margin:0; }
  dl { border-top:1px solid #8c7c57; margin:0; } dl div { display:grid; grid-template-columns:10rem 1fr; border-bottom:1px solid #8c7c57; padding:.75rem 0; } dt { font-size:.75rem; font-weight:700; } dd { margin:0; } .redaction { background:var(--black); color:var(--black); border-radius:2px; padding:0 .2em; white-space:nowrap; }
  .stamp { position:absolute; right:1.6rem; bottom:1.3rem; margin:0; padding:.35rem .55rem; border:2px solid var(--red); color:var(--red); font-weight:700; letter-spacing:.12em; transform:rotate(-6deg); }
  .files { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:3.5rem 2.2rem; margin:0 .5rem 6rem; }
  .file { position:relative; background:var(--paper); border:1px solid #a99c82; box-shadow:5px 6px 0 #23211b22; transform:rotate(var(--tilt)); } .file-0 { --tilt:-1.1deg; } .file-1 { --tilt:1deg; } .file-2 { --tilt:.6deg; } .file-3 { --tilt:-.8deg; }
  .file .tab { left:1.25rem; background:var(--deep); } .file img { display:block; width:100%; aspect-ratio:16/10; object-fit:cover; border-bottom:1px solid #a99c82; filter:saturate(.78) contrast(.94); } .file-copy { padding:1.3rem 1.35rem 1.5rem; } .file h2 { font-size:1.14rem; line-height:1.2; margin:.55rem 0; } .file-copy p:not(.file-path) { color:var(--dim); font-size:.88rem; line-height:1.48; margin:0 0 1rem; } a { color:var(--ink); font-weight:700; text-underline-offset:.22em; } .clip { position:absolute; z-index:2; right:1.2rem; top:-1rem; width:13px; height:35px; border:2px solid var(--ink); border-bottom:0; border-radius:8px 8px 0 0; transform:rotate(13deg); }
  .notes { border-top:2px solid var(--ink); padding-top:1.4rem; } .notes h2 { font-size:clamp(2rem,5vw,4rem); margin:.5rem 0 2rem; } .note-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; } .note-grid article { border-top:4px solid var(--deep); padding-top:.8rem; } .note-grid h3 { font-size:1rem; margin:0 0 .55rem; } .note-grid p { color:var(--dim); font-size:.84rem; line-height:1.48; margin:0; }
  a:focus-visible { outline:3px solid var(--red); outline-offset:4px; }
  @media (max-width:700px) { .cover { margin:1.5rem 0 4rem; } dl div { grid-template-columns:1fr; gap:.25rem; } .files { grid-template-columns:1fr; margin:0 .2rem 4rem; } .note-grid { grid-template-columns:1fr 1fr; } }
  @media (max-width:420px) { .cover h1 { font-size:3.2rem; } .stamp { position:static; display:inline-block; margin-top:1.3rem; } .note-grid { grid-template-columns:1fr; } }
</style>
