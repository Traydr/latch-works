---
// PROTOTYPE: Atlas — parchment #F0EBDD, panel #E9E2CF, ink #2B2A24, dim #7A7260, contour #C9BBA0, route #C4442C; Geist + IBM Plex Mono.
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import { pipeline, products } from "@/data/products";

const ordered = ["gather-box", "frame-view", "lockstep", "pane-view"].map((slug) =>
  products.find((product) => product.slug === slug),
);
const refs = ["GB-01", "FV-02", "LS-03", "PV-04"];
const principles = [
  ["Local-first", "The archive on disk stays authoritative. Sync is explicit, never automatic mirroring."],
  ["Private by default", "Web viewing requires authentication. Delivery URLs are signed and time-limited."],
  ["Shared packages", "media-domain, media-index, media-storage, and lockstep-core keep behavior consistent."],
  ["Calm tooling", "Direct language, dark UI, practical spacing — a workshop, not a marketing site."],
];
---

<main class="atlas">
  <section class="hero">
    <p class="eyebrow">ATLAS / ARCHIVE EXPEDITION</p>
    <h1>Map the media<br />you mean to keep.</h1>
    <p class="intro">Latch Works is a private media archive: local disk remains the source of truth, and sync is an explicit trip you choose to take.</p>
    <div class="route" aria-label="Archive pipeline">
      <svg viewBox="0 0 1000 75" preserveAspectRatio="none" aria-hidden="true"><path d="M45 43 L300 20 L610 55 L955 27" /></svg>
      {pipeline.map((stage, index) => <div class={`stop s${index + 1}`}>
        <span class="marker"></span><span class="ref">REF {refs[index]}</span><strong>{stage.step}</strong><span>{stage.product}</span><small>{stage.description}</small>
      </div>)}
    </div>
  </section>

  <section class="territories" aria-label="Product territories">
    <div class="section-head"><p class="eyebrow">FOUR TERRITORIES</p><p>Follow the archive from capture to private viewing.</p></div>
    <div class="card-grid">
      {ordered.map((product, index) => product && <a class="territory" href={`/${product.slug}`}>
        <div class="card-top"><span>REF {refs[index]}</span><span>STAGE 0{index + 1}</span></div>
        <div class="photo"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} loading="lazy" /></div>
        <h2>{product.name}</h2><p>{product.tagline}</p><span class="go">Enter region <b>→</b></span>
      </a>)}
    </div>
  </section>

  <section class="principles">
    {principles.map(([title, body]) => <article><span class="cross">+</span><h2>{title}</h2><p>{body}</p></article>)}
  </section>
</main>

<style>
  :global(:root){--paper:#F0EBDD;--panel:#E9E2CF;--ink:#2B2A24;--dim:#7A7260;--line:#C9BBA0;--red:#C4442C} .atlas{color:var(--ink);background:var(--paper);min-height:100vh;background-image:repeating-radial-gradient(ellipse at 18% 5%,transparent 0 24px,rgba(201,187,160,.2) 25px 26px,transparent 27px 51px);font-family:Geist,system-ui,sans-serif}.hero,.territories,.principles{max-width:1240px;margin:auto}.hero{padding:8rem 2rem 5rem}.eyebrow,.ref,.card-top,.go{font:500 .68rem/1.3 "IBM Plex Mono",monospace;letter-spacing:.08em}.eyebrow{color:var(--red);margin:0 0 1rem}.hero h1{font-size:clamp(3.4rem,8vw,7.8rem);line-height:.88;letter-spacing:-.075em;margin:0;max-width:850px}.intro{font-size:1.15rem;line-height:1.55;max-width:560px;margin:2rem 0 4rem;color:var(--dim)}.route{height:205px;position:relative}.route svg{position:absolute;inset:22px 0 auto;width:100%;height:90px;overflow:visible}.route path{fill:none;stroke:var(--red);stroke-width:2;stroke-dasharray:8 8}.stop{position:absolute;width:21%;display:grid;gap:.22rem}.s1{left:0;top:43px}.s2{left:27%;top:20px}.s3{left:58%;top:55px}.s4{right:0;top:27px}.marker{width:13px;height:13px;border:2px solid var(--red);border-radius:50%;background:var(--paper);position:relative;margin-bottom:.5rem}.marker:after{content:"";position:absolute;width:21px;border-top:1px solid var(--red);left:-6px;top:4px}.ref{color:var(--red)}.stop strong{font-size:1.2rem}.stop>span:not(.marker):not(.ref),.stop small{color:var(--dim)}.stop small{font-size:.77rem;line-height:1.4;max-width:190px}.territories{padding:4rem 2rem 7rem}.section-head{display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid var(--ink);padding-top:1rem;margin-bottom:2rem}.section-head p:last-child{color:var(--dim);font-size:.9rem}.card-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.territory{color:inherit;text-decoration:none;padding:1rem;background:rgba(233,226,207,.6);border:1px solid var(--line);transition:transform .2s,box-shadow .2s}.territory:hover{transform:translateY(-5px);box-shadow:5px 6px 0 var(--line)}.card-top{display:flex;justify-content:space-between;color:var(--dim);margin-bottom:1rem}.photo{aspect-ratio:4/3;overflow:hidden;background:var(--line);padding:5px;background-image:linear-gradient(90deg,transparent 49%,rgba(43,42,36,.25) 50%,transparent 51%),linear-gradient(0deg,transparent 49%,rgba(43,42,36,.2) 50%,transparent 51%)}.photo img{width:100%;height:100%;object-fit:cover;display:block}.territory:nth-child(even) .photo{transform:rotate(.8deg)}.territory h2{font-size:1.4rem;letter-spacing:-.04em;margin:1.2rem 0 .3rem}.territory p{color:var(--dim);font-size:.88rem;line-height:1.45;margin:0;min-height:3em}.go{display:block;margin-top:1.4rem;color:var(--red)}.go b{font-size:1rem}.principles{border-top:1px solid var(--ink);display:grid;grid-template-columns:repeat(4,1fr)}.principles article{padding:2rem 1.5rem 3rem;border-right:1px solid var(--line)}.principles article:first-child{padding-left:2rem}.cross{font:1.4rem "IBM Plex Mono";color:var(--red)}.principles h2{font-size:1.05rem;margin:1.7rem 0 .6rem}.principles p{color:var(--dim);font-size:.83rem;line-height:1.5;margin:0}a:focus-visible{outline:3px solid var(--red);outline-offset:4px}@media(max-width:760px){.hero{padding:5rem 1.25rem 3rem}.intro{margin-bottom:2.5rem}.route{height:auto;display:grid;gap:1rem;border-left:1px dashed var(--red);padding-left:1.5rem}.route svg{display:none}.stop{position:relative!important;left:auto!important;right:auto!important;top:auto!important;width:auto}.marker{position:absolute;left:-2rem;top:.1rem}.territories{padding:3rem 1.25rem 4rem}.section-head{display:block}.card-grid{grid-template-columns:1fr 1fr}.principles{grid-template-columns:1fr 1fr}.principles article:first-child{padding-left:1.25rem}}@media(max-width:440px){.hero h1{font-size:3.35rem}.card-grid,.principles{grid-template-columns:1fr}.principles article{border-bottom:1px solid var(--line)}}
</style>
