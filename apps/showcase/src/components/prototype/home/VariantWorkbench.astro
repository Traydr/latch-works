---
/**
 * PROTOTYPE — Variant 2 "Workbench". Throwaway. Do not ship.
 *
 * Concept: the "Works" in Latch Works taken literally — a workshop equipment
 * wall. The ecosystem is a rack of four mounted units in workflow order, each
 * with an engraved spec plate, corner screws, and a status LED. The pipeline
 * is a DIN rail the units clip onto.
 *
 * Tokens
 *   Color: steel #1B1F23 · panel #23282E · seam #343A41 · zinc #C9CDD3
 *          dim #7C828A · safety orange #FF5C1F (functional marks only)
 *          per-unit anodized stripe (amber/violet/emerald/sky)
 *   Type:  Barlow Condensed 600/700 uppercase (machine badging) · Barlow (body)
 *          IBM Plex Mono (spec plates)
 *   Layout: riveted maker's plate hero → DIN-rail pipeline → four equipment
 *           panels (screenshot bezel + spec plate) → stencil strip of principles.
 *   Signature: slotted corner screws + engraved mono spec plates on every unit.
 *   Iteration 2: removed status LEDs and the MODEL/UNITS/POWER/TELEMETRY
 *   strip — decoration that carried no information.
 */
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/500.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import { pipeline, products } from "@/data/products";

const unitMeta: Record<string, { unit: string; stripe: string }> = {
  "gather-box": { unit: "UNIT 01", stripe: "#F5A623" },
  "frame-view": { unit: "UNIT 02", stripe: "#8B7CF6" },
  lockstep: { unit: "UNIT 03", stripe: "#34C98E" },
  "pane-view": { unit: "UNIT 04", stripe: "#38A8E8" },
};

const ordered = ["gather-box", "frame-view", "lockstep", "pane-view"]
  .map((slug) => products.find((p) => p.slug === slug))
  .filter((p) => p !== undefined);

const principles = [
  { title: "LOCAL-FIRST", body: "The archive on disk stays authoritative. Sync is explicit, never automatic mirroring." },
  { title: "PRIVATE BY DEFAULT", body: "Web viewing requires authentication. Delivery URLs are signed and time-limited." },
  { title: "SHARED PACKAGES", body: "media-domain, media-index, media-storage, and lockstep-core keep behavior consistent." },
  { title: "CALM TOOLING", body: "Direct language, dark UI, practical spacing — a workshop, not a marketing site." },
];
---

<div class="bench">
  <!-- Maker's plate -->
  <header class="plate-hero">
    <div class="maker-plate">
      <span class="rivet tl" aria-hidden="true"></span>
      <span class="rivet tr" aria-hidden="true"></span>
      <span class="rivet bl" aria-hidden="true"></span>
      <span class="rivet br" aria-hidden="true"></span>
      <p class="maker">LATCH WORKS · ARCHIVE EQUIPMENT</p>
      <h1>Private media<br />archive system</h1>
      <p class="brief">
        Four mounted units handle the full life of a file — collect it from the web, organize it
        on disk, sync it on your word alone, and view it anywhere privately.
      </p>
    </div>

    <!-- DIN rail -->
    <div class="rail-wrap">
      <div class="rail" aria-hidden="true"></div>
      <ol class="rail-modules">
        {
          pipeline.map((stage) => (
            <li class="module">
              <span class="mod-step">{stage.step}</span>
              <span class="mod-product">{stage.product}</span>
              <span class="mod-desc">{stage.description}</span>
            </li>
          ))
        }
      </ol>
      <div class="rail" aria-hidden="true"></div>
    </div>
  </header>

  <!-- Equipment panels -->
  <ol class="units">
    {
      ordered.map((product) => {
        const meta = unitMeta[product.slug];
        return (
          <li class="unit" style={`--stripe:${meta.stripe}`}>
            <span class="screw tl" aria-hidden="true"></span>
            <span class="screw tr" aria-hidden="true"></span>
            <span class="screw bl" aria-hidden="true"></span>
            <span class="screw br" aria-hidden="true"></span>
            <span class="stripe" aria-hidden="true"></span>

            <header class="unit-head">
              <span class="unit-no">{meta.unit}</span>
              <h2>{product.name}</h2>
            </header>

            <div class="unit-body">
              <div class="bezel">
                <img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} loading="lazy" />
              </div>
              <div class="spec">
                <dl>
                  <div><dt>TYPE</dt><dd>{product.kind === "app" ? "APPLICATION" : "SYNC TOOL"}</dd></div>
                  <div><dt>PATH</dt><dd>{product.repoPath}</dd></div>
                  <div><dt>ROLE</dt><dd>{product.tagline}</dd></div>
                </dl>
                <ul class="etched">
                  {product.highlights.slice(0, 3).map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
                <a class="manual" href={`/${product.slug}`}>
                  Service manual<span aria-hidden="true"> →</span>
                </a>
              </div>
            </div>
          </li>
        );
      })
    }
  </ol>

  <!-- Stencil strip -->
  <footer class="stencil-strip">
    {
      principles.map((p) => (
        <div class="stencil">
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </div>
      ))
    }
  </footer>
</div>

<style>
  .bench {
    --steel: #1b1f23;
    --panel: #23282e;
    --seam: #343a41;
    --zinc: #c9cdd3;
    --dim: #7c828a;
    --orange: #ff5c1f;
    background:
      radial-gradient(color-mix(in srgb, var(--seam) 45%, transparent) 1px, transparent 1px) 0 0 / 22px 22px,
      var(--steel);
    color: var(--zinc);
    font-family: "Barlow", system-ui, sans-serif;
    padding-bottom: 4rem;
  }

  h1, h2, h3 {
    font-family: "Barlow Condensed", "Barlow", sans-serif;
    text-transform: uppercase;
  }

  /* — Maker's plate — */
  .plate-hero {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 0;
  }
  .maker-plate {
    position: relative;
    background: linear-gradient(180deg, #262c32, #1e2328);
    border: 1px solid var(--seam);
    border-radius: 4px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 20px 40px -20px rgba(0, 0, 0, 0.8);
    padding: 2.5rem clamp(1.5rem, 4vw, 3rem);
  }
  .maker {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.35em;
    color: var(--orange);
    margin: 0;
  }
  .maker-plate h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0.01em;
    color: #e8ebee;
    margin: 0.9rem 0 0;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5);
  }
  .brief {
    max-width: 42rem;
    color: var(--dim);
    font-size: 1rem;
    line-height: 1.65;
    margin: 1.25rem 0 0;
  }
  .rivet {
    position: absolute;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #5b636c, #2a2f35 70%);
    box-shadow:
      inset 0 -1px 2px rgba(0, 0, 0, 0.7),
      0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .rivet.tl { top: 0.7rem; left: 0.7rem; }
  .rivet.tr { top: 0.7rem; right: 0.7rem; }
  .rivet.bl { bottom: 0.7rem; left: 0.7rem; }
  .rivet.br { bottom: 0.7rem; right: 0.7rem; }

  /* — DIN rail — */
  .rail-wrap {
    margin-top: 2.75rem;
  }
  .rail {
    height: 8px;
    background: linear-gradient(180deg, #3a4149, #22262b);
    border-top: 1px solid #454d56;
    border-bottom: 1px solid #101316;
  }
  .rail-modules {
    list-style: none;
    margin: 0;
    padding: 1rem 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 60rem) {
    .rail-modules {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .module {
    position: relative;
    background: var(--panel);
    border: 1px solid var(--seam);
    border-radius: 3px;
    padding: 0.8rem 0.9rem 0.75rem;
    box-shadow: 0 6px 14px -8px rgba(0, 0, 0, 0.7);
  }
  .mod-step {
    display: block;
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    color: #e8ebee;
  }
  .mod-product {
    display: block;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    color: var(--orange);
    letter-spacing: 0.12em;
    margin-top: 0.15rem;
  }
  .mod-desc {
    display: block;
    font-size: 0.8rem;
    color: var(--dim);
    margin-top: 0.45rem;
    line-height: 1.5;
  }

  /* — Equipment units — */
  .units {
    list-style: none;
    margin: 3rem auto 0;
    padding: 0 1.25rem;
    max-width: 72rem;
    display: grid;
    gap: 2rem;
  }
  .unit {
    position: relative;
    background: linear-gradient(180deg, #242a30, #1f2429);
    border: 1px solid var(--seam);
    border-radius: 4px;
    padding: 1.4rem clamp(1.1rem, 3vw, 1.9rem) 1.6rem;
    box-shadow: 0 18px 36px -20px rgba(0, 0, 0, 0.8);
  }
  .stripe {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 4px;
    background: var(--stripe);
    border-radius: 4px 0 0 4px;
  }
  .screw {
    position: absolute;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background:
      linear-gradient(45deg, transparent 44%, #14171a 44%, #14171a 56%, transparent 56%),
      radial-gradient(circle at 35% 30%, #59616a, #262b31 75%);
    box-shadow:
      inset 0 -1px 2px rgba(0, 0, 0, 0.8),
      0 1px 0 rgba(255, 255, 255, 0.07);
  }
  .screw.tl { top: 0.55rem; left: 0.55rem; }
  .screw.tr { top: 0.55rem; right: 0.55rem; transform: rotate(30deg); }
  .screw.bl { bottom: 0.55rem; left: 0.55rem; transform: rotate(65deg); }
  .screw.br { bottom: 0.55rem; right: 0.55rem; transform: rotate(110deg); }

  .unit-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    border-bottom: 1px solid var(--seam);
    padding: 0 0.4rem 0.8rem;
  }
  .unit-no {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    letter-spacing: 0.25em;
    color: var(--dim);
  }
  .unit-head h2 {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: #e8ebee;
    flex: 1;
  }
  .unit-body {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.25rem;
  }
  @media (min-width: 56rem) {
    .unit-body {
      grid-template-columns: 7fr 5fr;
      align-items: start;
    }
  }
  .bezel {
    background: #101315;
    border: 1px solid #0b0e10;
    border-radius: 3px;
    padding: 0.55rem;
    box-shadow:
      inset 0 2px 8px rgba(0, 0, 0, 0.8),
      0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .bezel img {
    display: block;
    width: 100%;
    border-radius: 2px;
  }
  .spec dl {
    margin: 0;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
  }
  .spec dl div {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 0.75rem;
    padding: 0.42rem 0;
    border-bottom: 1px dashed color-mix(in srgb, var(--seam) 80%, transparent);
  }
  .spec dt { color: var(--dim); letter-spacing: 0.08em; }
  .spec dd { margin: 0; color: var(--zinc); line-height: 1.5; }
  .etched {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
    color: var(--dim);
  }
  .etched li {
    padding: 0.35rem 0 0.35rem 1.1rem;
    position: relative;
    line-height: 1.5;
  }
  .etched li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--orange);
  }
  .manual {
    display: inline-block;
    margin-top: 1.15rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    color: var(--orange);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--orange) 55%, transparent);
    border-radius: 2px;
    padding: 0.5rem 0.8rem;
  }
  .manual:hover {
    background: color-mix(in srgb, var(--orange) 12%, transparent);
  }
  .manual:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }

  /* — Stencil strip — */
  .stencil-strip {
    max-width: 72rem;
    margin: 3rem auto 0;
    padding: 0 1.25rem;
    display: grid;
    gap: 1px;
    background: var(--seam);
    border: 1px solid var(--seam);
  }
  @media (min-width: 60rem) {
    .stencil-strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stencil {
    background: var(--steel);
    padding: 1.25rem 1.1rem 1.5rem;
  }
  .stencil h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--zinc) 85%, transparent);
  }
  .stencil p {
    margin: 0.6rem 0 0;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--dim);
  }
</style>
