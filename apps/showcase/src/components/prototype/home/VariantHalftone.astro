---
// PROTOTYPE: Halftone uses white paper (#FAFAF7), ink (#141414), gray (#8A8A85), hairlines (#DDDDD6), and four pipeline spot colors.
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import { pipeline, products } from "@/data/products";

const order = ["gather-box", "frame-view", "lockstep", "pane-view"];
const colors = { "gather-box": "#F5A623", "frame-view": "#8B7CF6", lockstep: "#34C98E", "pane-view": "#38A8E8" };
const stages = products.slice().sort((a, b) => order.indexOf(a.slug) - order.indexOf(b.slug));
---

<main>
  <header class="masthead">
    <p class="kicker">PRIVATE MEDIA ARCHIVE / 01—04</p>
    <h1>LATCH<br />WORKS</h1>
    <p class="intro">A private media archive. Local disk is the source of truth; sync is explicit.</p>
    <div class="pipeline" aria-label="Archive pipeline">
      <div class="strip" aria-hidden="true"></div>
      <div class="stage-labels">
        {pipeline.map((item, index) => <span>0{index + 1} {item.step} / {item.product}</span>)}
      </div>
    </div>
  </header>

  <section aria-label="Products">
    {stages.map((product, index) => {
      const spot = colors[product.slug as keyof typeof colors];
      const colorSection = index % 2 === 1;
      return <article class:list={["product", { color: colorSection, violet: product.slug === "frame-view" }]} style={`--spot:${spot}`}>
        <div class="product-copy">
          <p class="kicker">STAGE 0{index + 1} / {pipeline[index].step.toUpperCase()}</p>
          <h2>{product.name}</h2>
          <p class="tagline">{product.tagline}</p>
          <a href={`/${product.slug}`}>Open <span aria-hidden="true">→</span></a>
        </div>
        <figure>
          <img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} />
          <figcaption>{product.heroScreenshot.caption}</figcaption>
        </figure>
      </article>;
    })}
  </section>

  <footer>
    <p class="kicker">WORKSHOP PRINCIPLES</p>
    <div class="principles">
      <section><h2>Local-first</h2><p>The archive on disk stays authoritative. Sync is explicit, never automatic mirroring.</p></section>
      <section><h2>Private by default</h2><p>Web viewing requires authentication. Delivery URLs are signed and time-limited.</p></section>
      <section><h2>Shared packages</h2><p>media-domain, media-index, media-storage, and lockstep-core keep behavior consistent.</p></section>
      <section><h2>Calm tooling</h2><p>Direct language, dark UI, practical spacing — a workshop, not a marketing site.</p></section>
    </div>
  </footer>
</main>

<style>
  main { background: #fafaf7; color: #141414; font-family: "Geist Variable", sans-serif; overflow: hidden; }
  .masthead { min-height: 88vh; padding: clamp(2rem, 7vw, 8rem); display: flex; flex-direction: column; justify-content: center; }
  .kicker, figcaption { font: 700 .68rem/1.3 "JetBrains Mono", monospace; letter-spacing: .04em; }
  .kicker { margin: 0 0 1.75rem; }
  h1, h2 { font-weight: 800; letter-spacing: -.095em; }
  h1 { font-size: clamp(5.5rem, 15vw, 15rem); line-height: .69; margin: 0; }
  .intro { max-width: 31rem; margin: 2.7rem 0 4rem; font-size: clamp(1rem, 1.5vw, 1.35rem); line-height: 1.45; }
  .pipeline { max-width: 62rem; }
  .strip { height: 15px; background: linear-gradient(90deg, #f5a623, #8b7cf6 34%, #34c98e 66%, #38a8e8); }
  .stage-labels { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: .7rem; font: 700 .62rem/1.4 "JetBrains Mono", monospace; }
  .product { --foreground: #141414; min-height: 48rem; display: grid; grid-template-columns: minmax(16rem, .78fr) minmax(0, 1.22fr); align-items: center; gap: clamp(2rem, 7vw, 9rem); padding: clamp(3rem, 7vw, 8rem); background: #fafaf7; color: var(--foreground); }
  .product.color { --foreground: #141414; background: var(--spot); }
  .product.violet { --foreground: #fafaf7; }
  .product-copy { align-self: center; }
  .product h2 { font-size: clamp(4.5rem, 9.5vw, 10rem); line-height: .76; margin: 0; max-width: 45rem; }
  .tagline { max-width: 20rem; margin: 2rem 0 1.5rem; font: 400 clamp(.85rem, 1.2vw, 1rem)/1.55 "JetBrains Mono", monospace; }
  a { color: inherit; font-weight: 700; text-underline-offset: .25em; }
  a span { font-size: 1.3em; }
  a:focus-visible { outline: 3px solid currentColor; outline-offset: 5px; }
  figure { position: relative; margin: 0; color: var(--foreground); background: #fafaf7; border: 1px solid currentColor; box-shadow: 15px 15px 0 var(--foreground); transform: rotate(-1.35deg); overflow: hidden; }
  .color figure { color: var(--spot); box-shadow: 15px 15px 0 var(--foreground); }
  figure::after { content: ""; position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(circle, currentColor 1px, transparent 1.3px); background-size: 4px 4px; mix-blend-mode: multiply; opacity: .48; }
  img { display: block; width: 100%; min-height: 23rem; max-height: 38rem; object-fit: cover; filter: grayscale(1) contrast(1.25) brightness(1.06); }
  figcaption { position: relative; z-index: 1; padding: .85rem 1rem; background: #fafaf7; color: #141414; }
  footer { padding: clamp(3rem, 7vw, 8rem); }
  .principles { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid #ddddd6; }
  .principles section { padding: 1.25rem 1.5rem 0 0; border-right: 1px solid #ddddd6; min-height: 11rem; }
  .principles section:not(:first-child) { padding-left: 1.5rem; }
  .principles section:last-child { border: 0; }
  .principles h2 { margin: 0 0 1rem; font: 700 .72rem "JetBrains Mono", monospace; letter-spacing: .04em; }
  .principles p { margin: 0; color: #8a8a85; font-size: .86rem; line-height: 1.55; }
  @media (max-width: 760px) { .masthead { min-height: 46rem; } .stage-labels { grid-template-columns: repeat(2, 1fr); row-gap: .7rem; } .product { min-height: auto; grid-template-columns: 1fr; gap: 2.5rem; } .product:nth-child(even) figure { order: -1; } .product h2 { font-size: clamp(4.4rem, 20vw, 7rem); } img { min-height: 15rem; } .principles { grid-template-columns: repeat(2, 1fr); } .principles section:nth-child(2) { border-right: 0; } .principles section:nth-child(3) { padding-left: 0; padding-top: 1.5rem; } .principles section:nth-child(4) { padding-top: 1.5rem; } }
  @media (max-width: 390px) { .masthead, .product, footer { padding-left: 1.25rem; padding-right: 1.25rem; } .principles { grid-template-columns: 1fr; } .principles section, .principles section:not(:first-child) { border-right: 0; border-bottom: 1px solid #ddddd6; padding: 1.25rem 0; min-height: 0; } }
</style>
