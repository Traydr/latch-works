---
// PROTOTYPE: Halftone Gather Box uses white paper (#FAFAF7), ink (#141414), gray (#8A8A85), hairlines (#DDDDD6), and amber (#F5A623).
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
const sources = ["Fanbox", "Kemono", "Archive of Our Own", "Fanfiction.net", "Hentai Foundry"];
---
<main>
  <section class="hero"><a class="back" href="/">← All stages</a><div class="copy"><p>STAGE 01 / GATHER BOX</p><h1>{product.name}</h1><strong>{product.tagline}</strong><span>{product.description}</span><code>{product.repoPath}</code></div><figure><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} /><figcaption>{product.heroScreenshot.caption}</figcaption></figure></section>
  <p class="roster">{sources.map((source) => <span>{source}</span>)}</p>
  <section class="features"><p>WHAT IT COLLECTS</p><div>{product.features.map((feature) => <article><h2>{feature.title}</h2><p>{feature.description}</p></article>)}</div></section>
  <section class="gallery">{product.gallery.map((shot) => <figure><img src={shot.src} alt={shot.alt} /><figcaption>{shot.caption}</figcaption></figure>)}</section>
  <p class="highlights">{product.highlights.map((item) => <span>{item}</span>)}</p><a class="cta" href={`/docs/${product.slug}`}>Read more →</a>
</main>
<style>
 main { background:#fafaf7;color:#141414;font-family:"Geist Variable",sans-serif;overflow:hidden }.hero { background:#f5a623;padding:2rem clamp(1.5rem,7vw,8rem) clamp(4rem,8vw,8rem);display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(2rem,6vw,7rem);align-items:end }.back,.copy>p,.roster,.features>p,figcaption,.highlights,code { font:700 .68rem/1.4 "JetBrains Mono",monospace;letter-spacing:.04em }.back { grid-column:1/-1;color:inherit }.back:focus-visible,.cta:focus-visible { outline:3px solid currentColor;outline-offset:5px }.copy>p { margin:0 0 2rem }.copy h1 { margin:0;font-size:clamp(5rem,11vw,11rem);line-height:.7;letter-spacing:-.105em;font-weight:800 }.copy strong { display:block;margin:2rem 0 .8rem;font-size:1.3rem }.copy span { display:block;max-width:28rem;line-height:1.5 }.copy code { display:block;margin-top:1.5rem } figure { position:relative;margin:0;color:#f5a623;background:#fafaf7;border:1px solid #141414;box-shadow:16px 16px #141414;transform:rotate(1.4deg);overflow:hidden } figure::after { content:"";position:absolute;inset:0;pointer-events:none;background-image:radial-gradient(circle,currentColor 1px,transparent 1.3px);background-size:4px 4px;mix-blend-mode:multiply;opacity:.48 } img { display:block;width:100%;min-height:26rem;object-fit:cover;filter:grayscale(1) contrast(1.25) brightness(1.06) } figcaption { position:relative;z-index:1;padding:.8rem;background:#fafaf7;color:#141414 }.roster { margin:0;padding:1.25rem clamp(1.5rem,7vw,8rem);display:flex;gap:.8rem;flex-wrap:wrap;border-bottom:1px solid #ddddd6 }.roster span:not(:last-child)::after { content:"•";margin-left:.8rem;color:#8a8a85 }.features { padding:clamp(4rem,8vw,8rem) }.features>p { margin:0 0 2rem }.features>div { display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #ddddd6 }.features article { padding:1.2rem 1.5rem 2.5rem 0;border-bottom:1px solid #ddddd6 }.features article:nth-child(3n+2),.features article:nth-child(3n+3) { padding-left:1.5rem }.features h2 { margin:0;font:700 .78rem "JetBrains Mono",monospace }.features article p { margin:.8rem 0 0;color:#8a8a85;font-size:.9rem;line-height:1.5 }.gallery { padding:0 clamp(1.5rem,8vw,8rem) 6rem;display:flex;justify-content:flex-end }.gallery figure { width:min(43rem,100%);transform:rotate(-1deg) }.gallery img { min-height:16rem }.highlights { margin:0;padding:1.2rem clamp(1.5rem,7vw,8rem);border-top:1px solid #ddddd6;display:flex;gap:1rem;flex-wrap:wrap }.highlights span:not(:last-child)::after { content:"/";margin-left:1rem;color:#8a8a85 }.cta { display:block;background:#f5a623;color:#141414;padding:clamp(3rem,7vw,7rem);font-size:clamp(2rem,5vw,5rem);font-weight:800;letter-spacing:-.07em;text-decoration:none } @media(max-width:700px){.hero{grid-template-columns:1fr;padding-bottom:4rem}.features>div{grid-template-columns:1fr}.features article,.features article:nth-child(3n+2),.features article:nth-child(3n+3){padding:1.2rem 0 2rem}img{min-height:17rem}} @media(max-width:390px){.hero,.features{padding-left:1.25rem;padding-right:1.25rem}.copy h1{font-size:4.6rem}}
</style>
