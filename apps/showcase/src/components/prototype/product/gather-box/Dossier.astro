---
import "@fontsource/courier-prime/400.css";
import "@fontsource/courier-prime/700.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
const sites = ["Fanbox", "Kemono", "Archive of Our Own", "Fanfiction.net", "Hentai Foundry"];
---
<!-- PROTOTYPE: Dossier tokens — manila #D8C496, paper #F4EEDF, ink #23211B, dim #6B6353, red pencil #B23A25, redaction #1C1A16; Courier Prime, case tab, clip, single truthful stamp. -->
<main class="page">
  <a class="back" href="/">← All stages</a>
  <header><div class="tab">GATHER BOX / STAGE 01</div><p>SUBJECT</p><h1>{product.tagline}</h1><p class="description">{product.description}</p><p class="file">FILE {product.repoPath} · STAGE 01 OF 04</p></header>
  <section class="intake"><div class="exhibit"><span class="clip"></span><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} /><p>EXHIBIT A — {product.heroScreenshot.caption}</p></div><aside><p class="label">INFORMANT ROSTER / SUPPORTED SITES</p><ol>{sites.map((site, i) => <li><span>{String(i + 1).padStart(2, "0")}</span>{site}</li>)}</ol><p class="restricted">Private destination <span>████████</span> chosen per run.</p></aside></section>
  <section class="statements"><p class="label">STATEMENTS / COLLECTING RECORD</p>{product.features.map((feature, i) => <article><b>{String(i + 1).padStart(2, "0")}</b><p><strong>{feature.title}</strong> — {feature.description}</p></article>)}</section>
  <section class="highlights"><div><p class="label">FILE NOTES</p>{product.highlights.map((item) => <p>— {item}</p>)}</div><div class="verdict"><p>VERDICT</p><strong>COLLECTED</strong><a href={`/docs/${product.slug}`}>Full file →</a></div></section>
</main>
<style>
  .page{--m:#d8c496;--d:#c4af7d;--p:#f4eedf;--i:#23211b;--x:#6b6353;--r:#b23a25;max-width:1120px;margin:auto;padding:2rem 1.25rem 5rem;color:var(--i);font-family:"Courier Prime",monospace;background:var(--p);background-image:repeating-linear-gradient(90deg,transparent 0 5px,#23211b04 6px)}.back,a{color:var(--i);font-weight:700;text-underline-offset:.2em}.back{display:inline-block;margin-bottom:3.5rem}header{position:relative;background:var(--m);padding:3rem clamp(1.4rem,5vw,4rem);border:1px solid #9e8b60;box-shadow:6px 7px #23211b20}.tab{position:absolute;top:0;left:2rem;transform:translateY(-100%);padding:.55rem 1rem;background:var(--d);border:1px solid #9e8b60;border-bottom:0;font-weight:700;letter-spacing:.08em;font-size:.78rem}header>p:first-of-type,.label,.file{font-size:.74rem;letter-spacing:.1em;margin:0;color:var(--x);font-weight:700}h1{font-size:clamp(2.2rem,6vw,5rem);line-height:.95;margin:.6rem 0 1rem;text-transform:uppercase}.description{max-width:47rem;line-height:1.5;margin:0 0 1.8rem}.file{border-top:1px solid #9e8b60;padding-top:.8rem}.intake{display:grid;grid-template-columns:1.35fr .65fr;gap:2rem;margin:4rem 0}.exhibit{position:relative;padding:.9rem;background:#fffaf0;border:1px solid #aaa08c;box-shadow:5px 6px #23211b1c}.exhibit img{width:100%;display:block;filter:saturate(.75)}.exhibit p{margin:.8rem 0 0;font-size:.8rem}.clip{position:absolute;right:1rem;top:-1rem;width:13px;height:34px;border:2px solid var(--i);border-bottom:0;border-radius:8px 8px 0 0;transform:rotate(14deg)}aside{border-left:3px solid var(--d);padding:1rem 0 1rem 1.3rem}ol{list-style:none;padding:0;margin:1.2rem 0}li{padding:.75rem 0;border-bottom:1px dotted #9e8b60}li span{color:var(--r);font-weight:700;margin-right:.7rem}.restricted{font-size:.83rem;line-height:1.45}.restricted span{background:#1c1a16;color:#1c1a16;border-radius:2px}.statements{border-top:2px solid var(--i);padding-top:1.25rem}.statements article{display:grid;grid-template-columns:3rem 1fr;border-bottom:1px solid #b4a989;padding:1.1rem 0}.statements b{color:var(--r)}.statements p{margin:0;line-height:1.48}.statements strong{font-weight:700}.highlights{display:flex;justify-content:space-between;gap:2rem;margin-top:3rem}.highlights>div:first-child p:not(.label){font-size:.85rem;color:var(--x);margin:.55rem 0}.verdict{text-align:right}.verdict p{margin:0 0 .4rem;font-size:.75rem}.verdict strong{display:inline-block;color:var(--r);border:3px solid var(--r);padding:.45rem .65rem;letter-spacing:.1em;transform:rotate(-5deg)}.verdict a{display:block;margin-top:1.5rem}a:focus-visible{outline:3px solid var(--r);outline-offset:4px}@media(max-width:650px){.back{margin-bottom:3rem}.intake{grid-template-columns:1fr}.highlights{display:block}.verdict{text-align:left;margin-top:2.5rem}}@media(max-width:390px){h1{font-size:2rem}.page{padding-inline:1rem}}
</style>
