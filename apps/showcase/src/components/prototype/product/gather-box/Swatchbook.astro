---
// PROTOTYPE: amber #F5A623 collection card on #EFEAE0 archive paper; #F7F3E8 taped specifications, #191713 ink, riveted workshop hardware.
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
const sources = ["Fanbox", "Kemono", "Archive of Our Own", "Fanfiction.net", "Hentai Foundry"];
---
<main>
  <a class="back" href="/">← All stages</a>
  <article class="hero"><i class="rivet"></i><p>STAGE 1 / GATHER</p><h1>{product.name}</h1><strong>{product.tagline}</strong><p class="description">{product.description}</p><figure><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} /></figure><div class="spec">{product.repoPath} · {product.kind} · stage 1</div></article>
  <section class="sources"><span>COLLECTED SOURCES</span>{sources.map((source) => <b>{source}</b>)}</section>
  <pre class="tree">archive/
└── artist/
    └── series/
        ├── post-001/
        └── story.pdf</pre>
  <section class="features">{product.features.map((feature) => <article><h2>{feature.title}</h2><p>{feature.description}</p></article>)}</section>
  <section class="lower"><figure><img src={product.gallery[0].src} alt={product.gallery[0].alt} /></figure><div><h2>Workshop notes</h2><ul>{product.highlights.map((item) => <li>{item}</li>)}</ul><a class="docs" href={`/docs/${product.slug}`}>Docs →</a></div></section>
</main>
<style>
@import "@fontsource/ibm-plex-mono/400.css"; @import "@fontsource/ibm-plex-mono/500.css";
main { max-width: 1180px; margin: auto; padding: 32px clamp(18px, 5vw, 70px) 72px; color:#191713; background:#EFEAE0; box-shadow:0 0 0 100vmax #EFEAE0; clip-path:inset(0 -100vmax); font-family:"IBM Plex Mono",monospace; } .back,.docs { color:#191713; font-size:12px; font-weight:500; } .back:focus-visible,.docs:focus-visible { outline:3px solid #191713; outline-offset:4px; }
.hero { position:relative; max-width:850px; margin:28px auto 35px; padding:34px 28px 0; border-radius:12px; background:#F5A623; box-shadow:0 22px 38px #19171340; transform:rotate(-.7deg); } .hero>p:first-of-type,.spec,h2,.sources span { font-size:11px; letter-spacing:.08em; } h1 { margin:12px 0 4px; font:700 clamp(52px,9vw,104px)/.86 Geist Variable,sans-serif; letter-spacing:-.07em; } strong { font-size:14px; } .description { max-width:660px; margin:22px 0; font-size:13px; line-height:1.55; } figure { margin:0; padding:6px; background:#F7F3E8; } figure img { display:block; width:100%; } .spec { position:relative; margin:15px -10px -17px; padding:15px; background:#F7F3E8; box-shadow:0 4px 8px #19171330; transform:rotate(1deg); } .spec::before,.features article::before { content:""; position:absolute; top:-5px; left:20%; width:48px; height:10px; background:#efeae0aa; } .rivet { position:absolute; top:14px; left:14px; width:17px; height:17px; border-radius:50%; background:radial-gradient(circle at 32% 28%,#fff 0 10%,#C9CDD3 24%,#6A6F76 74%,#42464b); } .rivet::after { content:""; position:absolute; top:7px; left:3px; width:11px; height:2px; background:#4d5258; transform:rotate(-12deg); }
.sources { display:flex; align-items:center; flex-wrap:wrap; gap:9px; margin:45px 0 18px; } .sources span { margin-right:8px; color:#6E6759; } .sources b { padding:8px 10px; background:#F7F3E8; box-shadow:0 3px 6px #19171325; font-size:11px; font-weight:500; transform:rotate(-1deg); } .sources b:nth-child(3n) { transform:rotate(1.5deg); } .tree { margin:0 0 28px; padding:18px; overflow:auto; background:#F7F3E8; color:#6E6759; font:12px/1.6 "IBM Plex Mono",monospace; box-shadow:0 4px 8px #19171318; }
.features { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; } .features article { position:relative; padding:18px; background:#F7F3E8; box-shadow:0 4px 9px #19171318; } h2 { margin:0 0 14px; } .features p { margin:0; color:#6E6759; font-size:12px; line-height:1.55; }.lower { display:grid; grid-template-columns:1.1fr .9fr; gap:26px; align-items:start; margin-top:34px; }.lower figure { transform:rotate(1.4deg); box-shadow:0 7px 13px #19171328; }.lower ul { padding:0; margin:0 0 28px; list-style:none; border-top:1px solid #bdb5a8; }.lower li { padding:11px 0; border-bottom:1px solid #bdb5a8; font-size:12px; line-height:1.45; } .docs { display:inline-block; padding:13px; background:#F7F3E8; box-shadow:0 3px 6px #19171320; }
@media(max-width:650px){ .hero{padding:30px 16px 0;margin-top:24px;} .features,.lower{grid-template-columns:1fr;} .sources{align-items:flex-start;} h1{font-size:58px;} }
</style>
