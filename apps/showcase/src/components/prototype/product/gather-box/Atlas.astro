---
// PROTOTYPE: Atlas — parchment #F0EBDD, panel #E9E2CF, ink #2B2A24, dim #7A7260, contour #C9BBA0, route #C4442C; Geist + IBM Plex Mono.
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
---
<main class="atlas"><a class="back" href="/">← All stages</a><section class="mast"><div><p>STAGE 01 · GATHER <span>REF GB-01</span></p><h1>{product.name}</h1><em>{product.tagline}</em><p class="desc">{product.description}</p><code>GRID REF / {product.repoPath}</code></div><figure class="photo hero"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><figcaption>REF GB-01 / {product.heroScreenshot.caption}</figcaption></figure></section><section class="field"><aside><p>COLLECTION SITES</p><ul><li>Fanbox</li><li>Kemono</li><li>Archive of Our Own</li><li>Fanfiction.net</li><li>Hentai Foundry</li></ul><small>Named collectors are part of the supported-site feature set.</small></aside><div class="landmarks"><p>LANDMARKS / SIX VERIFIED POINTS</p>{product.features.map(f=><article><span>⊕</span><div><h2>{f.title}</h2><p>{f.description}</p></div></article>)}</div></section>{product.gallery[0] && <figure class="photo gallery"><img src={product.gallery[0].src} alt={product.gallery[0].alt}/><figcaption>REF GB-02 / {product.gallery[0].caption}</figcaption></figure>}<section class="notes">{product.highlights.map(h=><span>{h}</span>)}</section><a class="guide" href={`/docs/${product.slug}`}>Trail guide →</a></main>
<style>
:global(:root){--p:#F0EBDD;--q:#E9E2CF;--i:#2B2A24;--d:#7A7260;--l:#C9BBA0;--r:#C4442C}.atlas{max-width:1180px;margin:auto;padding:2rem;color:var(--i);background:var(--p);min-height:100vh;background-image:repeating-radial-gradient(circle at 95% 3%,transparent 0 29px,rgba(201,187,160,.18) 30px 31px,transparent 32px 60px)}.back,.guide{font:500 .75rem "IBM Plex Mono",monospace;color:var(--r);text-decoration:none}.mast{display:grid;grid-template-columns:1fr .85fr;align-items:center;gap:5rem;padding:5rem 0}.mast>div>p:first-child,.field>aside>p,.landmarks>p,figcaption,code{font:500 .7rem "IBM Plex Mono",monospace;letter-spacing:.07em}.mast>div>p:first-child{color:var(--r)}.mast span{color:var(--d);margin-left:1rem}.mast h1{font-size:clamp(4rem,8vw,7rem);letter-spacing:-.08em;line-height:.85;margin:1rem 0}.mast em{font-style:normal;font-size:1.45rem;color:var(--r)}.desc{line-height:1.6;color:var(--d);max-width:510px}.mast code{display:block;margin-top:2rem;border-top:1px solid var(--l);padding-top:.8rem;color:var(--d)}.photo{margin:0;padding:7px;background:var(--q);border:1px solid var(--l);background-image:linear-gradient(90deg,transparent 49.5%,rgba(43,42,36,.2) 50%,transparent 50.5%);transform:rotate(1.2deg)}.photo img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}.photo figcaption{padding:.7rem 0 0;color:var(--d);font-size:.6rem}.field{display:grid;grid-template-columns:265px 1fr;border-top:1px solid var(--i);border-bottom:1px solid var(--i)}.field aside{padding:2rem;border-right:1px solid var(--l)}.field aside>p,.landmarks>p{color:var(--r);margin-top:0}.field ul{list-style:none;padding:1rem 0;margin:0;border-top:1px solid var(--l);border-bottom:1px solid var(--l);font:500 .8rem/2 "IBM Plex Mono",monospace}.field li:before{content:"+";color:var(--r);padding-right:.5rem}.field small{display:block;color:var(--d);line-height:1.5;margin-top:1.5rem}.landmarks{padding:2rem}.landmarks article{display:flex;gap:1rem;padding:1rem 0;border-top:1px solid var(--l)}.landmarks article>span{color:var(--r);font-size:1.2rem}.landmarks h2{margin:0;font-size:1.05rem}.landmarks p{margin:.25rem 0 0;color:var(--d);font-size:.9rem;line-height:1.5}.gallery{width:min(600px,100%);margin:3rem 0 0 auto}.notes{display:flex;flex-wrap:wrap;gap:.7rem;padding:2rem 0}.notes span{font:500 .7rem "IBM Plex Mono",monospace;padding:.6rem .8rem;border:1px solid var(--l);color:var(--d)}.guide{display:inline-block;margin:1rem 0 3rem;font-size:1rem}a:focus-visible{outline:3px solid var(--r);outline-offset:4px}@media(max-width:700px){.atlas{padding:1.25rem}.mast{grid-template-columns:1fr;gap:2.5rem;padding:3rem 0}.field{grid-template-columns:1fr}.field aside{border-right:0;border-bottom:1px solid var(--l)}.mast h1{font-size:4rem}.gallery{margin:2rem 0 0}} 
</style>
