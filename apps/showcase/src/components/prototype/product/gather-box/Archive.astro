---
/**
 * PROTOTYPE — Gather Box "Field Notes" (Archive family). Throwaway. Do not ship.
 *
 * Concept: the collector's field journal, retinted to sit inside the Archive
 * family — journal kraft instead of dark bark. Same structure as the liked
 * dark version: sites on record, the folder tree where catches land, and
 * handwritten Caveat margin notes.
 *
 * Tokens
 *   Color: kraft #EFE7D2 · panel #E6DAB9 · ink #2A251A · pencil #7A6E55
 *          rule #D6C9A6 · field amber #8A5A00 · tick #4C7A33
 *   Type:  Geist (titles) · IBM Plex Mono (log lines, tree) · Caveat (margins)
 *   Layout: log header → instrument plate (popup + margin note) → sites on
 *           record → where things land (folder tree) → field kit.
 *   Signature: handwritten Caveat margin notes + amber folder-tree diagram.
 */
import "@fontsource/caveat/500.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import type { Product } from "@/data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;

const sites = [
  { name: "Fanbox", note: "gallery posts" },
  { name: "Kemono", note: "artist feeds" },
  { name: "Archive of Our Own", note: "long-form stories → PDF" },
  { name: "Fanfiction.net", note: "long-form stories → PDF" },
  { name: "Hentai Foundry", note: "gallery posts" },
];
---

<div class="log">
  <div class="page">
    <a class="back" href="/">← All stages</a>

    <header class="log-head">
      <p class="eyebrow">FIELD LOG · STAGE 01 · GATHER</p>
      <div class="head-row">
        <div class="head-copy">
          <h1>{product.name}</h1>
          <p class="tagline">{product.tagline}</p>
          <p class="desc">{product.description}</p>
          <p class="repo">{product.repoPath}</p>
        </div>
        <figure class="instrument">
          <img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} />
          <figcaption>{product.heroScreenshot.caption}</figcaption>
          <span class="margin-note shot-note" aria-hidden="true">detects the page<br />for you ↴</span>
        </figure>
      </div>
    </header>

    <section class="block">
      <h2 class="block-title"><span>Sites on record</span></h2>
      <ul class="sites">
        {
          sites.map((site) => (
            <li class="site">
              <span class="tick" aria-hidden="true">✓</span>
              <span class="site-name">{site.name}</span>
              <span class="leader" aria-hidden="true" />
              <span class="site-note">{site.note}</span>
            </li>
          ))
        }
        <li class="site more">
          <span class="tick dim" aria-hidden="true">+</span>
          <span class="site-name dim">more sources</span>
          <span class="leader" aria-hidden="true" />
          <a href="/docs/supported-sources">supported sources →</a>
        </li>
      </ul>
    </section>

    <section class="block">
      <h2 class="block-title"><span>Where things land</span></h2>
      <div class="tree-wrap">
        <pre class="tree" aria-label="Example of the inferred folder structure"><span class="t-root">~/archive/</span>
├── <span class="t-dir">artist-name/</span>
│   └── <span class="t-dir">series-title/</span>
│       └── <span class="t-dir">post-title/</span>
│           ├── <span class="t-file">001.jpg</span>
│           ├── <span class="t-file">002.jpg</span>
│           └── <span class="t-file">…</span>
└── <span class="t-dir">stories/</span>
    └── <span class="t-dir">author-name/</span>
        └── <span class="t-file">story-title.pdf</span></pre>
        <span class="margin-note tree-note" aria-hidden="true">lands ready<br />for frame view →</span>
      </div>
      <p class="aside">Example structure — inferred from the page, so downloads arrive pre-sorted.</p>
    </section>

    <section class="block">
      <h2 class="block-title"><span>Field kit</span></h2>
      <div class="kit">
        {
          product.features.map((feature) => (
            <div class="kit-item">
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <footer class="log-foot">
      <a class="manual" href="/docs/gather-box">Read the field manual →</a>
    </footer>
  </div>
</div>

<style>
  .log {
    --kraft: #efe7d2;
    --panel: #e6dab9;
    --ink: #2a251a;
    --pencil: #7a6e55;
    --rule: #d6c9a6;
    --amber: #8a5a00;
    --tick: #4c7a33;
    background: var(--kraft);
    color: var(--ink);
    font-family: "Geist Variable", system-ui, sans-serif;
    padding-bottom: 4rem;
  }

  .page {
    max-width: 68rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 0;
  }

  .back {
    display: inline-block;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.75rem;
    color: var(--pencil);
    text-decoration: none;
    margin-bottom: 2.5rem;
  }
  .back:hover { color: var(--amber); }

  .eyebrow {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    color: var(--amber);
    margin: 0 0 1rem;
  }
  .head-row {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 60rem) {
    .head-row {
      grid-template-columns: 6fr 5fr;
    }
  }
  .log-head h1 {
    margin: 0;
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .tagline {
    margin: 0.75rem 0 0;
    font-size: 1.15rem;
    color: var(--amber);
    font-weight: 500;
  }
  .desc {
    margin: 1.25rem 0 0;
    max-width: 34rem;
    color: var(--pencil);
    line-height: 1.7;
    font-size: 0.98rem;
  }
  .repo {
    margin: 1.25rem 0 0;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    color: var(--pencil);
  }
  .instrument {
    position: relative;
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--amber) 45%, transparent);
    padding: 0.6rem;
    background: var(--panel);
    transform: rotate(0.6deg);
    box-shadow: 0 20px 36px -18px rgba(42, 37, 26, 0.45);
  }
  .instrument img {
    display: block;
    width: 100%;
  }
  .instrument figcaption {
    margin-top: 0.5rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    color: var(--pencil);
    text-align: center;
  }

  .margin-note {
    position: absolute;
    font-family: "Caveat", cursive;
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--amber);
    line-height: 1.15;
    transform: rotate(-4deg);
    pointer-events: none;
  }
  .shot-note {
    right: -1.25rem;
    bottom: -2.25rem;
    text-align: right;
  }

  .block {
    margin-top: 4rem;
  }
  .block-title {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.5rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .block-title::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--rule);
  }

  .sites {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.85rem;
  }
  .site {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.55rem 0.5rem;
    margin: 0 -0.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .site:last-child {
    border-bottom: 0;
  }
  .tick { color: var(--tick); font-weight: 500; }
  .tick.dim, .dim { color: var(--pencil); }
  .site-name { font-weight: 500; }
  .leader {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1px dotted color-mix(in srgb, var(--pencil) 45%, transparent);
    transform: translateY(-0.3em);
  }
  .site-note { color: var(--pencil); font-size: 0.78rem; }
  .site.more a {
    color: var(--amber);
    text-decoration: none;
    font-size: 0.78rem;
  }
  .site.more a:hover { text-decoration: underline; }

  .tree-wrap {
    position: relative;
    border: 1px solid var(--rule);
    background: var(--panel);
    padding: 1.5rem clamp(1rem, 4vw, 2rem);
    overflow-x: auto;
  }
  .tree {
    margin: 0;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.85rem;
    line-height: 1.75;
    color: var(--pencil);
  }
  .t-root { color: var(--ink); font-weight: 500; }
  .t-dir { color: var(--amber); }
  .t-file { color: var(--ink); }
  .tree-note {
    right: 1.25rem;
    top: 50%;
    transform: rotate(-3deg) translateY(-50%);
  }
  @media (max-width: 48rem) {
    .tree-note { display: none; }
  }
  .aside {
    margin: 0.9rem 0 0;
    font-size: 0.82rem;
    color: var(--pencil);
  }

  .kit {
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  @media (min-width: 48rem) {
    .kit { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 62rem) {
    .kit { grid-template-columns: repeat(3, 1fr); }
  }
  .kit-item {
    background: var(--kraft);
    padding: 1.25rem 1.15rem 1.4rem;
  }
  .kit-item h3 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .kit-item p {
    margin: 0.5rem 0 0;
    font-size: 0.82rem;
    line-height: 1.65;
    color: var(--pencil);
  }

  .log-foot {
    margin-top: 3.5rem;
    border-top: 1px solid var(--rule);
    padding-top: 2rem;
  }
  .manual {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.85rem;
    color: var(--amber);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--amber) 55%, transparent);
    padding-bottom: 0.15rem;
  }
  .manual:hover { border-color: var(--amber); }
  .manual:focus-visible {
    outline: 2px solid var(--amber);
    outline-offset: 3px;
  }
</style>
