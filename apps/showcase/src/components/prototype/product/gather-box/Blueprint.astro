---
// PROTOTYPE: Blueprint. Deep blueprint paper with factual white technical rules; mono data and condensed headings, cyan only identifies links.
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
const suppliers = ["Fanbox", "Kemono", "Archive of Our Own", "Fanfiction.net", "Hentai Foundry"];
---
<main class="sheet"><a class="back" href="/">← ALL STAGES</a><header><p>STAGE 01 · GATHER BOX</p><h1>{product.name}</h1><strong>{product.tagline}</strong><div class="intro"><p>{product.description}</p><span>{product.repoPath}</span></div></header>
<section class="lead"><div class="label"><span>FIG. 1</span><span>COLLECTOR POPUP</span></div><div class="frame"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><svg viewBox="0 0 100 60" aria-hidden="true"><path d="M4 48H27L42 32M97 11H74L61 23M96 50H70L57 42"/><circle cx="42" cy="32" r="1"/><circle cx="61" cy="23" r="1"/><circle cx="57" cy="42" r="1"/></svg><b class="a">PAGE STATUS</b><b class="b">DESTINATION</b><b class="c">COLLECT ACTION</b></div></section>
<div class="twocol"><section><div class="label"><span>SUPPLIERS</span><span>SUPPORTED SOURCES</span></div><table><thead><tr><th>NO.</th><th>SOURCE</th><th>OUTPUT</th></tr></thead><tbody>{suppliers.map((supplier,index)=><tr><td>{String(index+1).padStart(2,"0")}</td><td>{supplier}</td><td>MEDIA / STORY PDF</td></tr>)}</tbody></table></section><section class="tree"><div class="label"><span>FIG. 2</span><span>INFERRED FOLDER TREE</span></div><svg viewBox="0 0 480 235" role="img" aria-label="Example inferred folder tree"><g class="lines"><path d="M62 36V192M62 79H188M62 131H188M62 184H188M188 79V107H340M188 131V158H340"/></g><g class="box"><rect x="16" y="17" width="92" height="38"/><rect x="188" y="60" width="124" height="38"/><rect x="188" y="112" width="124" height="38"/><rect x="188" y="165" width="124" height="38"/><rect x="340" y="88" width="118" height="38"/><rect x="340" y="140" width="118" height="38"/></g><g class="svgtext"><text x="28" y="41">ARCHIVE</text><text x="201" y="84">ARTIST</text><text x="201" y="136">SERIES</text><text x="201" y="189">STORIES</text><text x="351" y="112">POST 001</text><text x="351" y="164">STORY.PDF</text></g></svg></section></div>
<section class="parts"><div class="label"><span>PARTS LIST</span><span>06 ITEMS</span></div><table><thead><tr><th>PART</th><th>FUNCTION</th></tr></thead><tbody>{product.features.map((feature,index)=><tr><td>{String(index+1).padStart(2,"0")} / {feature.title}</td><td>{feature.description}</td></tr>)}</tbody></table></section><section class="notes"><div class="label"><span>NOTES</span><span>01–04</span></div><ol>{product.highlights.map((highlight)=><li>{highlight}</li>)}</ol></section><footer><div><span>PROJECT</span><b>{product.name}</b><span>PATH</span><b>apps/gather-box</b></div><div><span>SHEET</span><b>01</b><span>STAGE</span><b>01</b></div><a href="/docs/gather-box">ASSEMBLY DOCS →</a></footer></main>
<style>
.sheet{--p:#173E7A;--d:#122F5F;--l:rgba(255,255,255,.75);--g:rgba(255,255,255,.07);--t:#F2F6FC;--m:#9DB4D8;--c:#7FD4FF;color:var(--t);min-height:100vh;padding:clamp(1.25rem,4vw,4.5rem);box-sizing:border-box;background-color:var(--p);background-image:linear-gradient(var(--g) 1px,transparent 1px),linear-gradient(90deg,var(--g) 1px,transparent 1px);background-size:28px 28px;font-family:"IBM Plex Mono",monospace}.back,.label,header p,footer{font-size:.68rem;letter-spacing:.08em}.back{color:var(--c);text-decoration:none}.back:focus-visible,footer a:focus-visible{outline:2px solid var(--c);outline-offset:4px}header{border-bottom:1px solid var(--l);padding:2rem 0}header p{color:var(--c);margin:0}h1{font:700 clamp(4rem,11vw,10rem)/.72 "Barlow Condensed",sans-serif;margin:.6rem 0}header strong{color:var(--c);font-size:clamp(.8rem,1.4vw,1.15rem);font-weight:400}.intro{display:grid;grid-template-columns:minmax(0,52rem) auto;gap:2rem;align-items:end;margin-top:1.25rem}.intro p{color:var(--m);font-size:.85rem;line-height:1.65;margin:0}.intro span{border-bottom:1px solid var(--l);padding:.35rem 0;color:var(--t);font-size:.72rem}.lead{padding:2rem 0}.label{color:var(--m);display:flex;justify-content:space-between;margin-bottom:.5rem}.frame{position:relative;border:1px solid var(--l);background:var(--d);max-width:860px;aspect-ratio:1.65;overflow:hidden}.frame img{width:100%;height:100%;object-fit:cover;display:block}.frame svg{position:absolute;inset:0;width:100%;height:100%;fill:none;stroke:var(--c);stroke-width:.3}.frame circle{fill:var(--c);stroke:none}.frame b{position:absolute;background:var(--p);color:var(--c);font-size:clamp(.4rem,.65vw,.6rem);font-weight:400;padding:.1rem}.a{left:2%;bottom:12%}.b{right:2%;top:8%}.c{right:2%;bottom:9%}.twocol{display:grid;grid-template-columns:1fr 1fr;gap:clamp(1rem,5vw,5rem);padding:1rem 0 3rem}.twocol section,.parts,.notes{border-top:1px solid var(--l);padding-top:.75rem}table{width:100%;border-collapse:collapse;font-size:.68rem}th{text-align:left;color:var(--c);font-weight:400;padding:.7rem 0;border-bottom:1px solid var(--l)}td{padding:.75rem .3rem  .75rem 0;border-bottom:1px solid rgba(255,255,255,.35);color:var(--m);line-height:1.45}td:first-child{color:var(--t)}.tree svg{width:100%;height:auto;margin-top:.5rem}.lines{fill:none;stroke:var(--l);stroke-width:1}.box{fill:var(--p);stroke:var(--l);stroke-width:1}.svgtext{fill:var(--t);font:12px "IBM Plex Mono",monospace}.parts{max-width:1000px}.parts td:first-child{width:28%}.notes{margin-top:3rem;max-width:700px}.notes ol{padding-left:2.5rem;color:var(--m);font-size:.77rem;line-height:1.7}.notes li{padding:.35rem 0}footer{border-top:1px solid var(--l);margin-top:4rem;padding-top:1rem;display:flex;gap:1rem;justify-content:space-between;align-items:end}footer div{display:grid;grid-template-columns:auto auto;gap:.25rem 1rem}footer span{color:var(--m)}footer b{font-weight:500}footer a{color:var(--c);text-decoration:none;border:1px solid var(--c);padding:.75rem} @media(max-width:600px){.twocol,.intro{grid-template-columns:1fr}.intro{gap:.75rem}.frame{margin-right:-.1rem}footer{align-items:start;flex-direction:column}.tree{overflow:hidden}}
</style>
