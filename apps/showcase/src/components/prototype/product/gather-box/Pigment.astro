---
// PROTOTYPE: Pigment 01 pairs amber collection fields with black ink and a source-chip specimen sheet.
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
const sources = ["Fanbox", "Kemono", "Archive of Our Own", "Fanfiction.net", "Hentai Foundry"];
---
<main>
  <a class="back" href="/">← All stages</a>
  <section class="hero">
    <div class="copy"><p class="chip">PIGMENT 01 · AMBER · #F5A623</p><h1>{product.name}</h1><p class="tagline">{product.tagline}</p><p class="description">{product.description}</p><code>{product.repoPath}</code></div>
    <figure class="duotone"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} /><figcaption>{product.heroScreenshot.caption}</figcaption></figure>
    <div class="sources"><span>COLLECTION SOURCES</span>{sources.map((source) => <b>{source}</b>)}</div>
  </section>
  <section class="ingredients"><p class="eyebrow">INGREDIENTS / WHAT THE COLLECTOR SAVES</p><ul>{product.features.map((feature) => <li><i></i><div><h2>{feature.title}</h2><p>{feature.description}</p></div></li>)}</ul></section>
  <section class="gallery">{product.gallery.map((image) => <figure><img src={image.src} alt={image.alt} /><figcaption>{image.caption}</figcaption></figure>)}</section>
  <p class="highlight">{product.highlights.join("  /  ")}</p>
  <a class="cta" href={`/docs/${product.slug}`}>Read the formula →</a>
</main>
<style>
  :global(*){box-sizing:border-box}:global(body){margin:0;background:#101014;color:#f4f4f2;font-family:Geist Variable,Arial,sans-serif}.back{position:absolute;z-index:2;top:2rem;left:clamp(1.4rem,5vw,5rem);color:#101014;font-family:"JetBrains Mono",monospace;font-size:.75rem;font-weight:700}.back:focus-visible,.cta:focus-visible{outline:3px solid currentColor;outline-offset:5px}.hero{background:#f5a623;color:#101014;min-height:790px;padding:clamp(6rem,11vw,10rem) clamp(1.4rem,7vw,8rem) 4rem;display:grid;grid-template-columns:minmax(260px,.8fr) minmax(320px,1.1fr);gap:3rem 8vw;align-items:center}.chip,.eyebrow,.sources,.highlight,code{font-family:"JetBrains Mono",monospace;font-size:.7rem;letter-spacing:.035em}.chip{border:1px solid;padding:.55rem .7rem;display:inline-block;font-weight:700;margin:0 0 1.8rem}.copy h1{font-size:clamp(5rem,11vw,11rem);letter-spacing:-.1em;line-height:.72;margin:0}.tagline{font-size:1.5rem;font-weight:700;margin:2rem 0 .8rem}.description{line-height:1.5;max-width:430px;margin:0 0 1.5rem}.duotone{margin:0;background:#f5a623;box-shadow:20px 20px 0 #101014;transform:rotate(2deg)}.duotone img,.gallery img{display:block;width:100%;filter:grayscale(1) contrast(1.12) brightness(1.02);mix-blend-mode:multiply;opacity:.92}.duotone figcaption,.gallery figcaption{padding:.75rem;font:700 .65rem "JetBrains Mono",monospace}.sources{grid-column:1/-1;display:flex;align-items:center;gap:.55rem;flex-wrap:wrap;border-top:1px solid #101014;padding-top:1.2rem}.sources span{margin-right:auto;font-weight:700}.sources b{font-size:.68rem;padding:.45rem .55rem;border:1px solid #101014}.ingredients{padding:clamp(4rem,8vw,8rem);max-width:1280px;margin:auto}.eyebrow{color:#9a9aa3}.ingredients ul{list-style:none;padding:0;margin:3rem 0 0;display:grid;grid-template-columns:repeat(2,1fr);gap:0 4rem}.ingredients li{border-top:1px solid #36363d;padding:1.4rem 0;display:flex;gap:1rem}.ingredients i{display:block;width:10px;height:10px;flex:none;background:#f5a623;margin-top:.35rem}.ingredients h2{margin:0;font-size:1.1rem}.ingredients p{color:#9a9aa3;line-height:1.5;margin:.5rem 0 0}.gallery{padding:0 clamp(1.4rem,7vw,8rem) 5rem}.gallery figure{background:#f5a623;margin:0;max-width:760px}.highlight{margin:0;padding:1.2rem clamp(1.4rem,7vw,8rem);color:#9a9aa3;border-top:1px solid #36363d;line-height:2}.cta{display:block;background:#f5a623;color:#101014;padding:clamp(3rem,7vw,7rem);font-size:clamp(2.5rem,6vw,6rem);font-weight:700;letter-spacing:-.07em;text-decoration:none}@media(max-width:700px){.hero{grid-template-columns:1fr;min-height:auto}.sources span{width:100%;margin-bottom:.4rem}.ingredients ul{grid-template-columns:1fr}.gallery{padding-bottom:3rem}} 
</style>
