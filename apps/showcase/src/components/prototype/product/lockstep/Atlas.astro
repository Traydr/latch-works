---
// PROTOTYPE: Atlas — parchment #F0EBDD, panel #E9E2CF, ink #2B2A24, dim #7A7260, contour #C9BBA0, route #C4442C; Geist + IBM Plex Mono.
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
const flow = product.features.filter((feature) => ["Plan (read-only)", "Push uploads/updates", "Verify"].includes(feature.title));
const hazard = product.features.find((feature) => feature.title === "Apply deletes");
const other = product.features.filter((feature) => ![...flow, hazard].includes(feature));
---
<main class="atlas"><a class="back" href="/">← All stages</a><header><p>STAGE 03 · SYNC <span>REF LS-03</span></p><h1>{product.name}</h1><em>{product.tagline}</em><p>{product.description}</p><code>GRID REF / {product.repoPath}</code></header><section class="route"><p>SYNC ROUTE / REVIEW BEFORE WRITING</p><div class="steps">{flow.map((f,i)=><article><span class="point">0{i+1}</span><h2>{f.title}</h2><p>{f.description}</p></article>)}</div>{hazard && <aside><span>!</span><div><b>HAZARD WAYPOINT / {hazard.title}</b><p>{hazard.description}</p></div></aside>}</section><figure class="plate"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><figcaption>LS-03 / {product.heroScreenshot.caption}</figcaption></figure><section class="lower"><div class="landmarks"><p>OTHER LANDMARKS</p>{other.map(f=><article><span>⊕</span><div><h2>{f.title}</h2><p>{f.description}</p></div></article>)}</div><figure><img src={product.gallery[0].src} alt={product.gallery[0].alt}/><figcaption>LS-04 / {product.gallery[0].caption}</figcaption></figure></section><section class="notes">{product.highlights.map(h=><span>{h}</span>)}</section><a class="guide" href={`/docs/${product.slug}`}>Trail guide →</a></main>
<style>
:global(:root){--p:#F0EBDD;--q:#E9E2CF;--i:#2B2A24;--d:#7A7260;--l:#C9BBA0;--r:#C4442C}.atlas{max-width:1180px;margin:auto;padding:2rem;color:var(--i);min-height:100vh;background:var(--p);background-image:repeating-radial-gradient(circle at 10% 50%,transparent 0 28px,rgba(201,187,160,.17) 29px 30px,transparent 31px 58px)}.back,.guide{color:var(--r);text-decoration:none;font:500 .75rem "IBM Plex Mono",monospace}header{max-width:730px;padding:5rem 0 3rem}header>p:first-child,.route>p,figcaption,code,.landmarks>p{font:500 .7rem "IBM Plex Mono",monospace;letter-spacing:.08em;color:var(--r)}header span{color:var(--d);margin-left:1rem}h1{font-size:clamp(4rem,9vw,7.5rem);line-height:.82;letter-spacing:-.085em;margin:1rem 0}em{font-size:1.4rem;color:var(--r);font-style:normal}header>p:not(:first-child){color:var(--d);line-height:1.6;font-size:1.05rem}code{color:var(--d);display:block;margin-top:2rem}.route{padding:2rem;border-top:1px solid var(--i);border-bottom:1px solid var(--i)}.steps{display:grid;grid-template-columns:repeat(3,1fr);margin:3rem 0 2rem;position:relative}.steps:before{content:"";position:absolute;top:12px;left:10%;right:10%;border-top:2px dashed var(--r)}.steps article{position:relative;padding:2.6rem 1.5rem 0 0}.point{position:absolute;top:0;z-index:1;background:var(--p);border:2px solid var(--r);width:22px;height:22px;border-radius:50%;font:500 .6rem/19px "IBM Plex Mono";text-align:center;color:var(--r)}.steps h2{font-size:1.25rem;margin:0}.steps p,aside p{font-size:.88rem;line-height:1.5;color:var(--d)}.route aside{border:1px dashed var(--r);display:flex;gap:1rem;padding:1rem;color:var(--r);max-width:620px}.route aside>span{font:500 1.3rem "IBM Plex Mono"}.route aside b{font:500 .68rem "IBM Plex Mono";letter-spacing:.06em}.route aside p{margin:.3rem 0 0}.plate{margin:5rem 0;padding:7px;background:var(--q);border:1px solid var(--l);background-image:linear-gradient(90deg,transparent 49.5%,rgba(43,42,36,.18) 50%,transparent 50.5%)}.plate img,.lower figure img{display:block;width:100%;object-fit:cover}.plate img{max-height:560px}.plate figcaption,.lower figcaption{padding:.8rem 0 0;font-size:.62rem;color:var(--d)}.lower{display:grid;grid-template-columns:1fr 1fr;gap:4rem}.landmarks>p{margin-top:0}.landmarks article{display:flex;gap:1rem;padding:1rem 0;border-top:1px solid var(--l)}.landmarks span{color:var(--r)}.landmarks h2{font-size:1rem;margin:0}.landmarks p{margin:.35rem 0;color:var(--d);font-size:.88rem;line-height:1.5}.lower figure{margin:0;padding:6px;background:var(--q);border:1px solid var(--l);align-self:start}.lower figure img{aspect-ratio:4/3}.notes{margin-top:5rem;display:flex;flex-wrap:wrap;gap:.6rem}.notes span{font:500 .68rem "IBM Plex Mono";padding:.6rem .8rem;border:1px solid var(--l);color:var(--d)}.guide{display:inline-block;font-size:1rem;margin:3rem 0}a:focus-visible{outline:3px solid var(--r);outline-offset:4px}@media(max-width:700px){.atlas{padding:1.25rem}header{padding:3rem 0}.steps{grid-template-columns:1fr;margin:2rem 0}.steps:before{top:10%;bottom:10%;left:11px;right:auto;border-top:0;border-left:2px dashed var(--r)}.steps article{padding:0 0 2rem 2.5rem}.point{left:0}.lower{grid-template-columns:1fr;gap:2rem}.plate{margin:3rem 0}}
</style>
