---
// PROTOTYPE: Halftone Lockstep uses white paper (#FAFAF7), ink (#141414), gray (#8A8A85), hairlines (#DDDDD6), and emerald (#34C98E).
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
const steps = [product.features[0], product.features[1], product.features[3]];
---
<main><section class="hero"><a href="/">← All stages</a><div class="copy"><p>STAGE 03 / LOCKSTEP</p><h1>{product.name}</h1><strong>{product.tagline}</strong><span>{product.description}</span><code>{product.repoPath}</code></div><figure><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><figcaption>{product.heroScreenshot.caption}</figcaption></figure></section><section class="procedure"><p>SYNC PROCEDURE</p><div>{steps.map((step,index)=><article><b>0{index + 1}</b><h2>{step.title.replace(" (read-only)", "")}</h2><span>{step.description}</span></article>)}</div><aside><b>APPLY DELETES</b><span>held — separate explicit action</span></aside></section><section class="features">{product.features.slice(2).map((feature)=><article><h2>{feature.title}</h2><p>{feature.description}</p></article>)}</section><section class="gallery">{product.gallery.map((shot)=><figure><img src={shot.src} alt={shot.alt}/><figcaption>{shot.caption}</figcaption></figure>)}</section><p class="highlights">{product.highlights.join("  /  ")}</p><a class="cta" href={`/docs/${product.slug}`}>Read more →</a></main>
<style>
 main{background:#fafaf7;color:#141414;font-family:"Geist Variable",sans-serif;overflow:hidden}.hero{background:#34c98e;padding:2rem clamp(1.5rem,7vw,8rem) clamp(4rem,8vw,8rem);display:grid;grid-template-columns:.78fr 1.22fr;gap:clamp(2rem,7vw,8rem);align-items:end}a,.copy>p,.procedure>p,figcaption,.highlights,code{font:700 .68rem/1.4 "JetBrains Mono",monospace;letter-spacing:.04em}a{grid-column:1/-1;color:inherit}a:focus-visible,.cta:focus-visible{outline:3px solid currentColor;outline-offset:5px}.copy>p{margin:0 0 2rem}.copy h1{margin:0;font-weight:800;font-size:clamp(5rem,11vw,11rem);line-height:.68;letter-spacing:-.11em}.copy strong{display:block;font-size:1.3rem;margin:2rem 0 .8rem}.copy span{display:block;line-height:1.55;max-width:27rem}.copy code{display:block;margin-top:1.2rem}figure{position:relative;margin:0;color:#34c98e;background:#fafaf7;border:1px solid #141414;box-shadow:16px 16px #141414;transform:rotate(1.2deg);overflow:hidden}figure::after{content:"";position:absolute;inset:0;pointer-events:none;background-image:radial-gradient(circle,currentColor 1px,transparent 1.3px);background-size:4px 4px;mix-blend-mode:multiply;opacity:.48}img{display:block;width:100%;min-height:26rem;object-fit:cover;filter:grayscale(1) contrast(1.25) brightness(1.06)}figcaption{position:relative;z-index:1;padding:.8rem;background:#fafaf7;color:#141414}.procedure{padding:clamp(4rem,8vw,8rem)}.procedure>p{margin:0 0 2rem}.procedure>div{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #ddddd6}.procedure article{padding:1.2rem 1.5rem 2rem 0;border-bottom:1px solid #ddddd6}.procedure article:not(:first-child){padding-left:1.5rem}.procedure b{display:block;font-size:clamp(3.5rem,7vw,7rem);line-height:.8;letter-spacing:-.1em}.procedure h2{margin:2rem 0 .7rem;font:700 .85rem "JetBrains Mono",monospace}.procedure span{color:#8a8a85;font-size:.9rem;line-height:1.5}.procedure aside{margin-top:2rem;background:#141414;color:#fafaf7;padding:1.2rem 1.5rem;display:flex;justify-content:space-between;gap:1rem;font:700 .72rem "JetBrains Mono",monospace;letter-spacing:.04em}.features{padding:0 clamp(1.5rem,8vw,8rem) 6rem;display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}.features article{border-top:1px solid #ddddd6;padding-top:1rem}.features h2{margin:0;font:700 .78rem "JetBrains Mono",monospace}.features p{margin:.7rem 0 0;color:#8a8a85;font-size:.9rem;line-height:1.5}.gallery{background:#34c98e;padding:clamp(3rem,7vw,7rem);display:flex;justify-content:center}.gallery figure{width:min(52rem,100%);transform:rotate(-1deg)}.gallery img{min-height:18rem}.highlights{margin:0;padding:1.2rem clamp(1.5rem,7vw,8rem);border-bottom:1px solid #ddddd6}.cta{display:block;background:#34c98e;color:#141414;padding:clamp(3rem,7vw,7rem);font-size:clamp(2rem,5vw,5rem);font-weight:800;letter-spacing:-.07em;text-decoration:none}@media(max-width:700px){.hero,.procedure>div{grid-template-columns:1fr}.procedure article,.procedure article:not(:first-child){padding:1.2rem 0 2rem}.features{grid-template-columns:1fr}.procedure aside{display:block}.procedure aside span{display:block;color:#fafaf7;margin-top:.5rem}img{min-height:17rem}}@media(max-width:390px){.hero,.procedure{padding-left:1.25rem;padding-right:1.25rem}}
</style>
