---
/** PROTOTYPE — Riso: teal #00A08A sync stamps, paper #F6F1E7, pink reprint warning and headline offset. */
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
const steps = [
  ["PLAN", product.features[0].description],
  ["PUSH", product.features[1].description],
  ["VERIFY", product.features[3].description],
];
---
<main class="riso lockstep"><a class="back" href="/">← All stages</a><section class="hero"><div class="copy"><p>STAGE 03 / SYNC</p><h1 data-print={product.name}>{product.name}</h1><strong>{product.tagline}</strong><p>{product.description}</p><code>{product.repoPath}</code></div><figure><div class="print"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} /></div><figcaption>{product.heroScreenshot.caption}</figcaption></figure></section><section class="stamps" aria-label="Sync flow">{steps.map(([title,body],index)=><article><b>0{index+1}</b><h2>{title}</h2><p>{body}</p></article>)}</section><aside class="reprint"><b>APPLY DELETES</b><span>REPRINT REQUIRED</span><p>{product.features[2].description}</p></aside><section class="features">{product.features.slice(4).map((feature,index)=><article><b>0{index+5}</b><h2>{feature.title}</h2><p>{feature.description}</p></article>)}</section><p class="ticker">{product.highlights.join("  /  ")}</p><a class="cta" href={`/docs/${product.slug}`}>Read more →</a></main>
<style>
@import "@fontsource/barlow-condensed/600.css";@import "@fontsource/barlow-condensed/700.css";@import "@fontsource/ibm-plex-mono/400.css";@import "@fontsource/ibm-plex-mono/500.css";.riso{--paper:#F6F1E7;--deep:#EFE7D8;--ink:#1C1A17;--riso:#00A08A;color:var(--ink);background:var(--paper) radial-gradient(rgba(28,26,23,.13) .55px,transparent .8px);background-size:5px 5px;font-family:"IBM Plex Mono",monospace;padding:1.5rem 4vw 0}.back{color:inherit;font-size:.75rem;text-decoration:none;border-bottom:1px solid}.hero{display:grid;grid-template-columns:1fr 1fr;gap:4vw;align-items:center;background:var(--riso);padding:clamp(1.5rem,5vw,5rem);margin:1.5rem 0 4rem;box-shadow:7px 8px 0 var(--ink);transform:rotate(-1deg)}.copy>p,figcaption,.ticker{font-size:.7rem;line-height:1.6;letter-spacing:.06em}.copy h1,h2{font-family:"Barlow Condensed",sans-serif;text-transform:uppercase;line-height:.78;letter-spacing:-.05em;margin:.7rem 0}.copy h1{font-size:clamp(5.5rem,12vw,11rem);position:relative;z-index:0}.copy h1:after{content:attr(data-print);position:absolute;inset:0 auto auto 4px;color:#FF48B0;z-index:-1}.copy strong{font-size:1rem}.copy p:not(:first-child){font-size:.78rem;line-height:1.7}.copy code{font-size:.7rem;border-top:1px solid;padding-top:.7rem}figure{margin:0;transform:rotate(2deg)}.print{padding:.45rem;background:var(--ink)}.print img{display:block;width:100%;aspect-ratio:1.08;object-fit:cover;filter:grayscale(1) contrast(1.2) sepia(.25);mix-blend-mode:screen;opacity:.9}figcaption{padding-top:.5rem}.stamps{display:grid;grid-template-columns:repeat(3,1fr);gap:2vw;margin:0 5vw 1.5rem}.stamps article{background:var(--riso);padding:1.4rem;min-height:225px;border:2px solid var(--ink);box-shadow:4px 4px 0 var(--ink);transform:rotate(-1deg)}.stamps article:nth-child(2){transform:rotate(1.2deg)}.stamps article:nth-child(3){transform:rotate(-.4deg)}.stamps b,.features b{font-size:.68rem}.stamps h2{font-size:4rem}.stamps p,.features p,.reprint p{font-size:.7rem;line-height:1.65}.reprint{margin:4rem 15vw;background:#FF48B0;border:2px solid var(--ink);padding:1.2rem 1.5rem;display:grid;grid-template-columns:auto 1fr;gap:.3rem 1.5rem;transform:rotate(1deg)}.reprint b{font:700 clamp(2.5rem,5vw,4.5rem)/.8 "Barlow Condensed",sans-serif}.reprint span{font-size:.68rem;letter-spacing:.1em}.reprint p{grid-column:2;margin:0}.features{display:grid;grid-template-columns:1fr 1fr;margin:0 12vw 4rem;border-top:1px solid}.features article{padding:1.2rem 1.2rem 1.5rem 0;margin-right:1.2rem;border-right:1px solid}.features h2{font-size:2.6rem}.ticker{margin:0 -4vw;padding:1rem 4vw;border-top:2px solid;border-bottom:2px solid;white-space:nowrap;overflow:hidden}.cta{display:block;background:var(--riso);padding:2rem 4vw;color:var(--ink);font:700 clamp(2.6rem,6vw,5rem)/.8 "Barlow Condensed",sans-serif;text-transform:uppercase;text-decoration:none}a:focus-visible{outline:3px solid #FF48B0;outline-offset:4px}@media(max-width:700px){.hero{grid-template-columns:1fr}.stamps{margin-inline:0}.reprint{margin:3rem 0;grid-template-columns:1fr}.reprint p{grid-column:auto}.features{margin-inline:0}}@media(max-width:390px){.riso{padding-inline:1rem}.stamps{grid-template-columns:1fr}.features{grid-template-columns:1fr}.features article{border-right:0;border-bottom:1px solid}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}}
.copy h1 { color: var(--paper); }
</style>
