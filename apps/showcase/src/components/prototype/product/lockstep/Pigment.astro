---
// PROTOTYPE: Pigment 03 uses emerald process swatches, with deletes deliberately marked as a caution treatment.
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
const steps = product.features.slice(0, 4);
---
<main>
  <section class="hero"><a class="back" href="/">← All stages</a><div class="headline"><p class="chip">PIGMENT 03 · EMERALD · #34C98E</p><h1>{product.name}</h1><p class="tagline">{product.tagline}</p><p>{product.description}</p><code>{product.repoPath}</code></div><figure><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><figcaption>{product.heroScreenshot.caption}</figcaption></figure></section>
  <section class="procedure"><p class="eyebrow">SYNC PROCEDURE / REVIEW EACH STEP</p><ul>{steps.map((feature) => <li class:list={{ warning: feature.title === "Apply deletes" }}><span>{feature.title}</span><h2>{feature.title}</h2><p>{feature.description}</p></li>)}</ul></section>
  <section class="more"><ul>{product.features.slice(4).map((feature) => <li><i></i><div><h2>{feature.title}</h2><p>{feature.description}</p></div></li>)}</ul><figure><img src={product.gallery[0].src} alt={product.gallery[0].alt}/><figcaption>{product.gallery[0].caption}</figcaption></figure></section>
  <p class="highlight">{product.highlights.join("  /  ")}</p><a class="cta" href={`/docs/${product.slug}`}>Read the formula →</a>
</main>
<style>
 :global(*){box-sizing:border-box}:global(body){margin:0;background:#101014;color:#f4f4f2;font-family:Geist Variable,Arial,sans-serif}.hero{background:#34c98e;color:#101014;padding:2rem clamp(1.4rem,7vw,8rem) clamp(4rem,8vw,8rem);display:grid;grid-template-columns:.8fr 1.2fr;gap:5rem;align-items:end;min-height:780px}.back{grid-column:1/-1;color:inherit;font:700 .75rem "JetBrains Mono",monospace}.back:focus-visible,.cta:focus-visible{outline:3px solid currentColor;outline-offset:5px}.chip,.eyebrow,.highlight,code,figcaption{font-family:"JetBrains Mono",monospace;font-size:.7rem;letter-spacing:.04em}.chip{border:1px solid;padding:.55rem .7rem;display:inline-block;font-weight:700;margin:0 0 2rem}.headline h1{font-size:clamp(5rem,11vw,11rem);letter-spacing:-.1em;line-height:.72;margin:0}.tagline{font-size:1.5rem;font-weight:700;margin:2rem 0 .75rem}.headline>p:last-of-type{line-height:1.5;max-width:430px}.hero figure{margin:0;background:#34c98e;box-shadow:20px 20px #101014}.hero img,.more figure img{display:block;width:100%;filter:grayscale(1) contrast(1.12) brightness(1.02);mix-blend-mode:multiply;opacity:.92}.hero figcaption,.more figcaption{padding:.8rem}.procedure{padding:clamp(4rem,8vw,8rem)}.eyebrow{color:#9a9aa3}.procedure ul{list-style:none;padding:0;margin:3rem 0 0;display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#36363d}.procedure li{background:#17171c;padding:1.5rem;min-height:270px}.procedure li span{display:block;color:#34c98e;font:700 .68rem "JetBrains Mono",monospace;text-transform:uppercase}.procedure li h2{font-size:1.55rem;letter-spacing:-.05em;margin:3rem 0 .7rem}.procedure li p{color:#9a9aa3;line-height:1.5;margin:0}.procedure .warning{background-color:#24241d;background-image:repeating-linear-gradient(-45deg,transparent 0 9px,rgba(245,166,35,.18) 9px 11px)}.warning span{color:#f5a623!important}.more{display:grid;grid-template-columns:.7fr 1.3fr;gap:4rem;padding:0 clamp(1.4rem,8vw,9rem) 6rem;align-items:center}.more ul{list-style:none;padding:0;margin:0}.more li{display:flex;gap:1rem;border-top:1px solid #36363d;padding:1.2rem 0}.more i{width:10px;height:10px;background:#34c98e;display:block;margin-top:.35rem;flex:none}.more h2{margin:0;font-size:1.1rem}.more p{margin:.45rem 0 0;color:#9a9aa3;line-height:1.5}.more figure{margin:0;background:#34c98e}.highlight{color:#9a9aa3;border-top:1px solid #36363d;padding:1.3rem clamp(1.4rem,8vw,9rem);line-height:2}.cta{background:#34c98e;color:#101014;display:block;text-decoration:none;padding:clamp(3rem,7vw,7rem);font-size:clamp(2.5rem,6vw,6rem);font-weight:700;letter-spacing:-.07em}@media(max-width:700px){.hero{grid-template-columns:1fr;gap:3rem}.procedure ul{grid-template-columns:1fr}.procedure li{min-height:auto}.procedure li h2{margin-top:1.5rem}.more{grid-template-columns:1fr;padding-bottom:4rem}}
</style>
