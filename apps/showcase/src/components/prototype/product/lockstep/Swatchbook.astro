---
// PROTOTYPE: emerald #34C98E plan card, #EFEAE0 archive paper and #F7F3E8 held-action face, ink workshop annotations and metal rivets.
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
const actions = ["PLAN", "PUSH", "VERIFY"];
---
<main><a class="back" href="/">← All stages</a><article class="hero"><i class="rivet"></i><p>STAGE 3 / SYNC</p><h1>{product.name}</h1><strong>{product.tagline}</strong><p class="description">{product.description}</p><figure><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/></figure><div class="spec">{product.repoPath} · {product.kind} · stage 3</div></article><section class="actions" aria-label="Lockstep actions">{actions.map((action)=><article><i class="rivet"></i><b>{action}</b><span>{action === "PLAN" ? "read the archive" : action === "PUSH" ? "send reviewed changes" : "compare against snapshot"}</span></article>)}<article class="held"><b>APPLY DELETES</b><span>held — separate explicit action</span></article></section><section class="features">{product.features.map((feature)=><article><h2>{feature.title}</h2><p>{feature.description}</p></article>)}</section><section class="lower"><figure><img src={product.gallery[0].src} alt={product.gallery[0].alt}/></figure><div><h2>Workshop notes</h2><ul>{product.highlights.map((item)=><li>{item}</li>)}</ul><a class="docs" href={`/docs/${product.slug}`}>Docs →</a></div></section></main>
<style>
@import "@fontsource/ibm-plex-mono/400.css";@import "@fontsource/ibm-plex-mono/500.css";main{max-width:1180px;margin:auto;padding:32px clamp(18px,5vw,70px) 72px;color:#191713;font-family:"IBM Plex Mono",monospace}.back,.docs{color:#191713;font-size:12px;font-weight:500}.back:focus-visible,.docs:focus-visible{outline:3px solid #191713;outline-offset:4px}.hero{position:relative;max-width:880px;margin:28px auto 44px;padding:35px 28px 0;border-radius:12px;background:#34C98E;box-shadow:0 22px 38px #19171340}.hero>p:first-of-type,.spec,h2{font-size:11px;letter-spacing:.08em}h1{margin:12px 0 4px;font:700 clamp(56px,9vw,108px)/.84 Geist Variable,sans-serif;letter-spacing:-.075em}strong{font-size:14px}.description{max-width:660px;margin:22px 0;font-size:13px;line-height:1.55}figure{margin:0;padding:6px;background:#191713}figure img{display:block;width:100%}.spec{position:relative;margin:15px -10px -17px;padding:15px;background:#F7F3E8;box-shadow:0 4px 8px #19171330;transform:rotate(-.7deg)}.spec::before,.features article::before{content:"";position:absolute;top:-5px;left:20%;width:48px;height:10px;background:#efeae0aa}.rivet{position:absolute;top:14px;left:14px;width:17px;height:17px;border-radius:50%;background:radial-gradient(circle at 32% 28%,#fff 0 10%,#C9CDD3 24%,#6A6F76 74%,#42464b)}.rivet::after{content:"";position:absolute;top:7px;left:3px;width:11px;height:2px;background:#4d5258;transform:rotate(-12deg)}.actions{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-bottom:30px}.actions article{position:relative;min-height:115px;padding:30px 16px 16px;border-radius:12px;background:#34C98E;box-shadow:0 7px 12px #19171328;transform:rotate(-1.5deg)}.actions article:nth-child(2){transform:rotate(.6deg)}.actions article:nth-child(3){transform:rotate(1.4deg)}.actions b,.actions span{display:block}.actions b{font-size:16px;letter-spacing:.03em}.actions span{margin-top:13px;font-size:11px;line-height:1.4}.actions .held{padding:18px;background:#F7F3E8;box-shadow:inset 0 0 0 1px #c5bcac,0 7px 12px #19171320;transform:rotate(-2.2deg);color:#6E6759}.held b{font-size:11px}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.features article{position:relative;padding:18px;background:#F7F3E8;box-shadow:0 4px 9px #19171318}.features h2{margin:0 0 14px}.features p{margin:0;color:#6E6759;font-size:12px;line-height:1.55}.lower{display:grid;grid-template-columns:1.1fr .9fr;gap:26px;align-items:start;margin-top:34px}.lower figure{transform:rotate(1.2deg);box-shadow:0 7px 13px #19171328}.lower h2{margin:0 0 12px}.lower ul{padding:0;margin:0 0 28px;list-style:none;border-top:1px solid #bdb5a8}.lower li{padding:11px 0;border-bottom:1px solid #bdb5a8;font-size:12px;line-height:1.45}.docs{display:inline-block;padding:13px;background:#F7F3E8;box-shadow:0 3px 6px #19171320}@media(max-width:700px){.hero{padding:30px 16px 0}.actions{grid-template-columns:repeat(2,1fr)}.features,.lower{grid-template-columns:1fr}}@media(max-width:390px){.actions{grid-template-columns:1fr}h1{font-size:58px}}
main{background:#EFEAE0;box-shadow:0 0 0 100vmax #EFEAE0;clip-path:inset(0 -100vmax)}
</style>
