---
// PROTOTYPE: Blueprint. Deep blue archive sheet, white engineering routes, mono working notes and condensed product title; amber isolates deletion risk.
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
---
<main class="sheet"><a class="back" href="/">← ALL STAGES</a><header><p>STAGE 03 · LOCKSTEP</p><h1>{product.name}</h1><strong>{product.tagline}</strong><div class="intro"><p>{product.description}</p><span>{product.repoPath}</span></div></header><section class="flow"><div class="label"><span>FIG. 1 / EXPLICIT SYNC PROCEDURE</span><span>PLAN → PUSH → VERIFY</span></div><svg viewBox="0 0 1200 250" role="img" aria-label="Lockstep plan, push, and verify workflow"><defs><marker id="flow-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L8 4L0 8Z" fill="currentColor"/></marker></defs><g class="route"><path d="M150 106H430M560 106H840M970 106H1080" marker-end="url(#flow-arrow)"/><path d="M495 152V202H720" stroke-dasharray="6 5" marker-end="url(#flow-arrow)"/></g><g class="blocks"><rect x="20" y="64" width="130" height="84"/><rect x="430" y="64" width="130" height="84"/><rect x="840" y="64" width="130" height="84"/><rect class="caution" x="720" y="178" width="210" height="48"/></g><g class="copy"><text x="85" y="95" text-anchor="middle">LOCAL</text><text x="85" y="117" text-anchor="middle">ARCHIVE</text><text x="495" y="95" text-anchor="middle">PLAN</text><text x="495" y="117" text-anchor="middle">READ-ONLY</text><text x="905" y="95" text-anchor="middle">PUSH</text><text x="905" y="117" text-anchor="middle">UPLOAD / UPDATE</text><text x="1130" y="111" text-anchor="middle">VERIFY</text><text class="amber" x="825" y="207" text-anchor="middle">APPLY DELETES / REVIEWED</text><text class="small" x="288" y="88" text-anchor="middle">SCAN + DIFF</text><text class="small" x="700" y="88" text-anchor="middle">EXPLICIT WRITE</text></g></svg></section><section class="hero"><div class="label"><span>FIG. 2 / PLAN REVIEW</span><span>NO SIDE EFFECTS</span></div><div class="frame"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><svg viewBox="0 0 100 55" aria-hidden="true"><path d="M3 9H22L34 21M97 47H76L62 33"/><circle cx="34" cy="21" r="1"/><circle cx="62" cy="33" r="1"/></svg><i class="one">PROFILE + SOURCE</i><i class="two">PLAN RESULTS</i></div></section><div class="details"><section class="parts"><div class="label"><span>PARTS LIST</span><span>06 ITEMS</span></div><table><thead><tr><th>PART</th><th>FUNCTION</th></tr></thead><tbody>{product.features.map((feature,index)=><tr><td>{String(index+1).padStart(2,"0")} / {feature.title}</td><td>{feature.description}</td></tr>)}</tbody></table></section><section class="notes"><div class="label"><span>NOTES</span><span>01–04</span></div><ol>{product.highlights.map((highlight)=><li>{highlight}</li>)}</ol></section></div><section class="secondary"><div class="label"><span>FIG. 3 / PUSH RUN</span><span>UPLOADS + UPDATES</span></div><img src={product.gallery[0].src} alt={product.gallery[0].alt}/><p>{product.gallery[0].caption}</p></section><footer><div><span>PROJECT</span><b>{product.name}</b><span>PATH</span><b>apps/lockstep</b><span>STAGE</span><b>03</b></div><a href="/docs/lockstep">ASSEMBLY DOCS →</a></footer></main>
<style>
.sheet{--p:#173E7A;--d:#122F5F;--l:rgba(255,255,255,.75);--g:rgba(255,255,255,.07);--t:#F2F6FC;--m:#9DB4D8;--c:#7FD4FF;--a:#F5A623;color:var(--t);min-height:100vh;padding:clamp(1.25rem,4vw,4.5rem);box-sizing:border-box;background-color:var(--p);background-image:linear-gradient(var(--g) 1px,transparent 1px),linear-gradient(90deg,var(--g) 1px,transparent 1px);background-size:28px 28px;font-family:"IBM Plex Mono",monospace}.back,.label,header>p,footer{font-size:.68rem;letter-spacing:.08em}.back{color:var(--c);text-decoration:none}.back:focus-visible,footer a:focus-visible{outline:2px solid var(--c);outline-offset:4px}header{padding:2rem 0;border-bottom:1px solid var(--l)}header>p{color:var(--c);margin:0}h1{font:700 clamp(4.5rem,12vw,11rem)/.72 "Barlow Condensed",sans-serif;margin:.5rem 0}header strong{color:var(--c);font-weight:400;font-size:1rem}.intro{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-top:1rem}.intro p{max-width:55rem;color:var(--m);font-size:.8rem;line-height:1.7;margin:0}.intro span{border-bottom:1px solid var(--l);font-size:.7rem;padding:.3rem}.label{display:flex;justify-content:space-between;color:var(--m);margin-bottom:.6rem}.flow{padding:2rem 0;border-bottom:1px solid var(--l)}.flow svg{width:100%;height:auto;color:var(--l);overflow:visible}.route path{fill:none;stroke:currentColor;stroke-width:1.4}.blocks rect{fill:var(--p);stroke:currentColor;stroke-width:1}.blocks .caution{stroke:var(--a)}.copy{fill:var(--t);font:500 14px "IBM Plex Mono",monospace;letter-spacing:1px}.copy .small{fill:var(--m);font-size:11px}.copy .amber{fill:var(--a);font-size:11px}.hero{padding:2.5rem 0}.frame{position:relative;overflow:hidden;border:1px solid var(--l);background:var(--d);max-width:1000px;aspect-ratio:1.7}.frame img{width:100%;height:100%;object-fit:cover;display:block}.frame svg{position:absolute;inset:0;width:100%;height:100%;stroke:var(--c);fill:none;stroke-width:.3}.frame circle{fill:var(--c);stroke:none}.frame i{position:absolute;background:var(--p);color:var(--c);font-size:clamp(.4rem,.65vw,.62rem);font-style:normal;padding:.12rem}.one{left:2%;top:10%}.two{right:2%;bottom:9%}.details{display:grid;grid-template-columns:minmax(0,2fr) minmax(14rem,1fr);gap:clamp(2rem,8vw,8rem)}.parts,.notes,.secondary{border-top:1px solid var(--l);padding-top:.7rem}table{width:100%;border-collapse:collapse;font-size:.68rem}th{text-align:left;color:var(--c);font-weight:400;padding:.6rem 0;border-bottom:1px solid var(--l)}td{color:var(--m);padding:.8rem .5rem .8rem 0;line-height:1.5;border-bottom:1px solid rgba(255,255,255,.35)}td:first-child{color:var(--t);width:30%}.notes ol{padding-left:2.3rem;margin:.2rem 0;color:var(--m);font-size:.74rem;line-height:1.7}.notes li{padding:.3rem 0}.secondary{max-width:550px;margin-top:4rem}.secondary img{display:block;width:100%;border:1px solid var(--l)}.secondary p{color:var(--m);font-size:.68rem;line-height:1.5}footer{margin-top:4rem;padding-top:1rem;border-top:1px solid var(--l);display:flex;justify-content:space-between;align-items:center}footer div{display:flex;gap:.65rem;color:var(--m)}footer b{color:var(--t);font-weight:500}footer a{color:var(--c);text-decoration:none;border:1px solid var(--c);padding:.75rem}@media(max-width:650px){.intro,.details{display:grid;grid-template-columns:1fr;gap:1rem}.flow svg{width:175%;margin-left:-35%}.flow{overflow:hidden}.details{gap:3rem}footer{align-items:start;flex-direction:column;gap:1rem}footer div{flex-wrap:wrap}}
</style>
