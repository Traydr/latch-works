---
import "@fontsource/courier-prime/400.css";
import "@fontsource/courier-prime/700.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
const procedure = product.features.slice(0, 4);
---
<!-- PROTOTYPE: Dossier tokens — manila #D8C496, paper #F4EEDF, ink #23211B, dim #6B6353, red pencil #B23A25, redaction #1C1A16; Courier Prime, procedural file, one explicit stamp. -->
<main class="page"><a href="/" class="back">← All stages</a><header><div class="tab">LOCKSTEP / CONTROLLED COPY</div><p>SUBJECT</p><h1>{product.tagline}</h1><p>{product.description}</p><small>FILE {product.repoPath} · STAGE 03 OF 04</small></header>
<section class="procedure"><div class="intro"><p class="label">OPERATING PROCEDURE</p><h2>REVIEW<br />BEFORE<br />WRITING.</h2><p>Each action has a boundary. The plan has no side effects; deletion stays separate from push.</p></div><ol>{procedure.map((feature,i)=><li class:list={{restricted:feature.title === "Apply deletes"}}><b>{String(i+1).padStart(2,"0")}</b><div><h3>{feature.title}</h3><p>{feature.description}</p></div>{feature.title === "Apply deletes" && <span>RESTRICTED</span>}</li>)}</ol></section>
<section class="exhibits"><figure><i class="clip"></i><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><figcaption>EXHIBIT A — {product.heroScreenshot.caption}</figcaption></figure>{product.gallery.map(shot=><figure><img src={shot.src} alt={shot.alt}/><figcaption>EXHIBIT B — {shot.caption}</figcaption></figure>)}</section>
<section class="statements"><p class="label">ADDITIONAL STATEMENTS</p>{product.features.slice(4).map(feature=><p><strong>{feature.title}</strong> — {feature.description}</p>)}</section><footer><div><p class="label">HIGHLIGHTS</p>{product.highlights.map(item=><p>— {item}</p>)}</div><div class="verdict"><p>VERDICT</p><strong>EXPLICIT</strong><span>Tokens remain <i>████████</i> encrypted.</span><a href={`/docs/${product.slug}`}>Full file →</a></div></footer></main>
<style>
.page{--m:#d8c496;--d:#c4af7d;--p:#f4eedf;--i:#23211b;--x:#6b6353;--r:#b23a25;max-width:1100px;margin:auto;padding:2rem 1.25rem 5rem;color:var(--i);font-family:"Courier Prime",monospace;background:var(--p);background-image:repeating-linear-gradient(90deg,transparent 0 4px,#23211b04 5px)}a{color:var(--i);font-weight:700;text-underline-offset:.2em}.back{display:inline-block;margin-bottom:3.5rem}header{position:relative;background:var(--m);padding:3rem clamp(1.5rem,6vw,5rem);border:1px solid #9e8b60}.tab{position:absolute;top:0;left:1.5rem;transform:translateY(-100%);background:var(--d);border:1px solid #9e8b60;border-bottom:0;padding:.55rem 1rem;font-size:.75rem;letter-spacing:.09em;font-weight:700}header>p:first-of-type,.label,small{font-size:.74rem;color:var(--x);letter-spacing:.1em;font-weight:700;margin:0}h1{font-size:clamp(2.5rem,7vw,5.4rem);margin:.5rem 0;line-height:.92;text-transform:uppercase}header>p:not(:first-of-type){max-width:52rem;line-height:1.5;margin:.8rem 0 1.4rem}.procedure{display:grid;grid-template-columns:.75fr 1.25fr;gap:4rem;margin:4rem 0}.intro h2{font-size:clamp(2rem,4vw,3.8rem);line-height:.86;margin:.7rem 0 1rem}.intro>p:last-child{color:var(--x);line-height:1.5;font-size:.88rem}ol{list-style:none;margin:0;padding:0;border-top:2px solid var(--i)}li{display:grid;grid-template-columns:3rem 1fr auto;gap:.6rem;border-bottom:1px solid #aaa08c;padding:1.1rem 0}li>b{color:var(--r)}li h3{font-size:1rem;margin:0 0 .35rem}li p{margin:0;color:var(--x);font-size:.86rem;line-height:1.48}.restricted{background:linear-gradient(90deg,#b23a2515,transparent)}.restricted span{align-self:start;background:#1c1a16;color:#1c1a16;border-radius:2px;padding:.1rem .35rem;font-size:.68rem}.exhibits{display:grid;grid-template-columns:1.3fr .7fr;gap:1.5rem}.exhibits figure{position:relative;margin:0;padding:.65rem;background:#fffaf0;border:1px solid #aaa08c}.exhibits img{width:100%;display:block;filter:saturate(.72)}figcaption{font-size:.77rem;line-height:1.35;margin-top:.7rem}.clip{position:absolute;right:1rem;top:-1rem;width:13px;height:35px;border:2px solid var(--i);border-bottom:0;border-radius:8px 8px 0 0;transform:rotate(12deg)}.statements{margin:3.5rem 0;border-top:2px solid var(--i);padding-top:1rem}.statements p{max-width:780px;line-height:1.5;padding:.8rem 0;margin:0;border-bottom:1px dotted #aaa08c}footer{display:flex;justify-content:space-between;gap:2rem;border-top:2px solid var(--i);padding-top:1.4rem}footer>div:first-child p:not(.label){margin:.5rem 0;color:var(--x);font-size:.84rem}.verdict{text-align:right;font-size:.8rem}.verdict p{margin:0 0 .4rem}.verdict strong{display:inline-block;padding:.45rem .65rem;border:3px solid var(--r);color:var(--r);letter-spacing:.1em;transform:rotate(-5deg)}.verdict span{display:block;margin-top:1rem}.verdict i{font-style:normal;background:#1c1a16;color:#1c1a16}.verdict a{display:block;margin-top:1.3rem}a:focus-visible{outline:3px solid var(--r);outline-offset:4px}@media(max-width:680px){.procedure,.exhibits{grid-template-columns:1fr;gap:2rem}footer{display:block}.verdict{text-align:left;margin-top:2rem}}@media(max-width:390px){.page{padding-inline:1rem}.tab{left:.7rem;font-size:.66rem}li{grid-template-columns:2.2rem 1fr}}
</style>
