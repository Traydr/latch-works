---
/** PROTOTYPE — Workshop / Lockstep. Tokens: steel/panel/seam/zinc/dim, sync stripe #34C98E, safety orange #FF5C1F. Signature: guarded delete latch with real action language. */
import "@fontsource/barlow-condensed/600.css"; import "@fontsource/barlow-condensed/700.css"; import "@fontsource/barlow/400.css"; import "@fontsource/barlow/500.css"; import "@fontsource/ibm-plex-mono/400.css"; import "@fontsource/ibm-plex-mono/500.css";
import type { Product } from "@/data/products";
interface Props { product: Product; } const { product } = Astro.props;
const actions=[{number:"01",name:"Plan",note:"Read-only"},{number:"02",name:"Push",note:"Uploads + updates"},{number:"03",name:"Verify",note:"Drift check"}];
---
<main class="workshop"><a class="back" href="/">← All stages</a><section class="nameplate"><i class="stripe"></i><span class="screw tl"></span><span class="screw tr"></span><span class="screw bl"></span><span class="screw br"></span><p class="kicker">STAGE 03 · SYNC</p><h1>{product.name}</h1><p class="tagline">{product.tagline}</p><p class="description">{product.description}</p><dl class="specs"><div><dt>PATH</dt><dd>{product.repoPath}</dd></div><div><dt>TYPE</dt><dd>SYNC TOOL</dd></div><div><dt>ROLE</dt><dd>{product.tagline}</dd></div></dl></section>
<section class="control"><div class="section-head"><p>CONTROL PANEL</p><h2>Explicit actions</h2></div><div class="rail"><div class="railbar"></div>{actions.map(action=><article class="switch"><span>{action.number}</span><h3>{action.name}</h3><p>{action.note}</p><i aria-hidden="true"></i></article>)}<article class="guard"><div class="guard-label">LATCHED — opened only as a separate explicit action</div><div class="delete"><span>04</span><h3>Apply deletes</h3><p>Only remove remote entries listed in the reviewed plan.</p></div></article><div class="railbar"></div></div></section>
<section class="run"><figure class="bezel"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><figcaption>{product.heroScreenshot.caption}</figcaption></figure>{product.gallery.map(shot=><figure class="bezel secondary"><img src={shot.src} alt={shot.alt}/><figcaption>{shot.caption}</figcaption></figure>)}</section><section class="features"><div class="section-head"><p>SYNC REGISTER</p><h2>Control functions</h2></div><div class="feature-list">{product.features.map((feature,index)=><article><span>{String(index+1).padStart(2,"0")}</span><h3>{feature.title}</h3><p>{feature.description}</p></article>)}</div></section><section class="highlights"><h2>Workshop notes</h2><ul>{product.highlights.map(highlight=><li>{highlight}</li>)}</ul></section><a class="manual" href={`/docs/${product.slug}`}>Service manual <span>→</span></a></main>
<style>
.workshop{--steel:#1b1f23;--panel:#23282e;--seam:#343a41;--zinc:#c9cdd3;--dim:#7c828a;--accent:#34c98e;--orange:#ff5c1f;background:radial-gradient(color-mix(in srgb,#343a41 45%,transparent) 1px,transparent 1px) 0 0/22px 22px,var(--steel);color:var(--zinc);font-family:"Barlow",sans-serif;min-height:100vh;padding:2rem max(1rem,calc((100% - 70rem)/2)) 4rem}.back,.kicker,.specs,.section-head p,.switch>span,.guard-label,.delete>span,figcaption,.manual{font:400 .72rem "IBM Plex Mono",monospace;letter-spacing:.1em}.back{color:var(--zinc);text-decoration:none;display:inline-block;margin-bottom:1.5rem}.back:focus-visible,.manual:focus-visible{outline:2px solid var(--accent);outline-offset:4px}.nameplate{position:relative;overflow:hidden;padding:2.6rem clamp(1.3rem,5vw,3.5rem);background:linear-gradient(180deg,#262c32,#1e2328);border:1px solid var(--seam);box-shadow:inset 0 1px #ffffff10,0 20px 40px -24px #000}.stripe{position:absolute;inset:0 auto 0 0;width:5px;background:var(--accent)}.screw{position:absolute;width:.78rem;height:.78rem;border-radius:50%;background:linear-gradient(45deg,transparent 43%,#101315 44% 56%,transparent 57%),radial-gradient(circle at 35% 30%,#626b74,#252a30 72%);box-shadow:inset 0 -1px 2px #000}.tl{top:.6rem;left:.7rem}.tr{top:.6rem;right:.7rem;transform:rotate(30deg)}.bl{bottom:.6rem;left:.7rem;transform:rotate(65deg)}.br{bottom:.6rem;right:.7rem;transform:rotate(110deg)}.kicker{color:var(--accent);margin:0}.nameplate h1,.section-head h2,.highlights h2{font:700 2.1rem "Barlow Condensed",sans-serif;text-transform:uppercase;letter-spacing:.03em}.nameplate h1{font-size:clamp(3.8rem,10vw,7rem);line-height:.82;color:#eef0f2;margin:.7rem 0}.tagline{font-size:1.3rem;margin:0}.description{color:var(--dim);max-width:45rem;line-height:1.6;margin:1rem 0 1.5rem}.specs{margin:0;border-top:1px solid var(--seam);max-width:48rem}.specs div{display:grid;grid-template-columns:4.5rem 1fr;gap:1rem;padding:.55rem 0;border-bottom:1px dashed var(--seam)}.specs dt{color:var(--dim)}.specs dd{margin:0;line-height:1.45}.control,.features,.highlights{margin-top:3rem}.section-head{border-bottom:1px solid var(--seam);margin-bottom:1rem}.section-head p{color:var(--accent);margin:0 0 .35rem}.section-head h2,.highlights h2{margin:0 0 .75rem}.rail{display:grid;grid-template-columns:repeat(4,1fr);gap:.65rem;position:relative}.railbar{grid-column:1/-1;height:7px;background:linear-gradient(#3a4149,#20252a);border-block:1px solid #101315}.switch,.guard{background:linear-gradient(180deg,#282e34,#20252a);border:1px solid var(--seam);min-height:10rem;padding:1rem;box-shadow:inset 0 1px #ffffff0d}.switch>span,.delete>span{color:var(--accent)}.switch h3,.delete h3{font:700 1.8rem "Barlow Condensed",sans-serif;text-transform:uppercase;margin:.55rem 0 .25rem}.switch p,.delete p{color:var(--dim);margin:0;line-height:1.45}.switch i{display:block;width:100%;height:.4rem;background:#15191d;border:1px solid #0d1012;margin-top:1.1rem}.guard{border:1px dashed color-mix(in srgb,var(--orange) 70%,var(--seam));padding:.45rem}.guard-label{color:var(--orange);padding:.25rem .35rem .65rem;line-height:1.4}.delete{border:1px solid #4b3025;padding:.7rem;min-height:6.4rem}.run{display:grid;grid-template-columns:2fr 1fr;gap:1.25rem;margin-top:3rem}.bezel{margin:0;background:#101315;border:1px solid #090b0d;padding:.55rem;box-shadow:inset 0 2px 10px #000}.bezel img{display:block;width:100%}.bezel figcaption{color:var(--dim);padding:.6rem .1rem .05rem}.feature-list{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--seam);gap:1px;background:var(--seam)}.feature-list article{background:var(--panel);padding:1.15rem}.feature-list span{font:500 .72rem "IBM Plex Mono",monospace;color:var(--accent)}.feature-list h3{font:600 1.35rem "Barlow Condensed",sans-serif;text-transform:uppercase;margin:.5rem 0 .3rem}.feature-list p{color:var(--dim);line-height:1.55;font-size:.9rem;margin:0}.highlights{background:linear-gradient(180deg,#262c32,#1e2328);border:1px solid var(--seam);padding:1.2rem}.highlights ul{margin:0;padding:0;list-style:none}.highlights li{color:var(--dim);padding:.45rem 0 .45rem 1.15rem;border-bottom:1px dashed var(--seam)}.highlights li:last-child{border:0}.highlights li::before{content:"▸";color:var(--accent);position:absolute;margin-left:-1.15rem}.manual{display:inline-block;color:var(--accent);border:1px solid color-mix(in srgb,var(--accent) 65%,transparent);padding:.7rem .9rem;text-decoration:none;margin-top:1.5rem;transition:background .16s ease,transform .16s ease}.manual:hover{background:color-mix(in srgb,var(--accent) 12%,transparent)}.manual:active{transform:scale(.97)}@media(max-width:760px){.rail{grid-template-columns:1fr 1fr}.run{grid-template-columns:1fr}.feature-list{grid-template-columns:1fr 1fr}}@media(max-width:420px){.workshop{padding-inline:1rem}.nameplate{padding:2.2rem 1.15rem}.nameplate h1{font-size:3.55rem}.rail,.feature-list{grid-template-columns:1fr}}
</style>
