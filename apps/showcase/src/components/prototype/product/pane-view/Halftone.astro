---
// PROTOTYPE: Halftone Pane View uses white paper (#FAFAF7), ink (#141414), gray (#8A8A85), hairlines (#DDDDD6), and sky (#38A8E8).
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
---
<main><section class="hero"><a href="/">← All stages</a><div class="copy"><p>STAGE 04 / PANE VIEW</p><h1>{product.name}</h1><strong>{product.tagline}</strong><span>{product.description}</span><code>{product.repoPath}</code></div><div class="panes"><figure class="primary"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><figcaption>{product.heroScreenshot.caption}</figcaption></figure><figure class="secondary"><img src={product.gallery[0].src} alt={product.gallery[0].alt}/><figcaption>{product.gallery[0].caption}</figcaption></figure></div></section><section class="features"><p>PRIVATE VIEWING, ON ANY PANE</p><div>{product.features.map((feature)=><article><h2>{feature.title}</h2><p>{feature.description}</p></article>)}</div></section><section class="gallery"><figure><img src={product.gallery[1].src} alt={product.gallery[1].alt}/><figcaption>{product.gallery[1].caption}</figcaption></figure></section><p class="highlights">{product.highlights.join("  /  ")}</p><a class="cta" href={`/docs/${product.slug}`}>Read more →</a></main>
<style>
 main{background:#fafaf7;color:#141414;font-family:"Geist Variable",sans-serif;overflow:hidden}.hero{position:relative;min-height:55rem;background:#38a8e8;padding:2rem clamp(1.5rem,7vw,8rem) 7rem}.hero>a,.copy>p,.features>p,figcaption,.highlights,code{font:700 .68rem/1.4 "JetBrains Mono",monospace;letter-spacing:.04em}.hero>a{color:inherit}.hero>a:focus-visible,.cta:focus-visible{outline:3px solid currentColor;outline-offset:5px}.copy{position:relative;z-index:2;max-width:25rem;padding-top:clamp(5rem,12vw,11rem)}.copy>p{margin:0 0 2rem}.copy h1{margin:0;font-size:clamp(5rem,12vw,12rem);font-weight:800;line-height:.68;letter-spacing:-.11em}.copy strong{display:block;margin:2rem 0 .8rem;font-size:1.3rem}.copy span{display:block;line-height:1.55}.copy code{display:block;margin-top:1.2rem}figure{position:relative;margin:0;color:#38a8e8;background:#fafaf7;border:1px solid #141414;box-shadow:15px 15px #141414;overflow:hidden}figure::after{content:"";position:absolute;inset:0;pointer-events:none;background-image:radial-gradient(circle,currentColor 1px,transparent 1.3px);background-size:4px 4px;mix-blend-mode:multiply;opacity:.48}img{display:block;width:100%;min-height:20rem;object-fit:cover;filter:grayscale(1) contrast(1.25) brightness(1.06)}figcaption{position:relative;z-index:1;padding:.75rem;background:#fafaf7;color:#141414}.panes .primary{position:absolute;right:7vw;top:10rem;width:min(53vw,48rem);transform:rotate(1.6deg)}.panes .secondary{position:absolute;right:2vw;bottom:3rem;width:min(28vw,25rem);transform:rotate(-2deg)}.secondary img{min-height:12rem}.features{padding:clamp(4rem,8vw,8rem)}.features>p{margin:0 0 2rem}.features>div{display:grid;grid-template-columns:repeat(2,1fr);column-gap:5rem}.features article{padding:1.25rem 0;border-top:1px solid #ddddd6}.features h2{margin:0;font:700 .78rem "JetBrains Mono",monospace}.features p{margin:.7rem 0 0;color:#8a8a85;font-size:.9rem;line-height:1.5}.gallery{padding:clamp(3rem,7vw,7rem);background:#fafaf7;display:flex;justify-content:flex-end}.gallery figure{width:min(46rem,100%);transform:rotate(-1.2deg)}.gallery img{min-height:18rem}.highlights{margin:0;padding:1.2rem clamp(1.5rem,7vw,8rem);border-top:1px solid #ddddd6}.cta{display:block;background:#38a8e8;color:#141414;padding:clamp(3rem,7vw,7rem);font-size:clamp(2rem,5vw,5rem);font-weight:800;letter-spacing:-.07em;text-decoration:none}@media(max-width:800px){.hero{min-height:auto;padding-bottom:4rem}.panes{margin-top:3rem}.panes .primary,.panes .secondary{position:relative;right:auto;top:auto;bottom:auto;width:88%;margin-left:auto}.panes .secondary{width:57%;margin:-2rem 0 0 0}.copy{max-width:34rem;padding-top:5rem}.features>div{grid-template-columns:1fr;gap:0}}@media(max-width:390px){.hero,.features{padding-left:1.25rem;padding-right:1.25rem}.panes .primary{width:94%}.panes .secondary{width:70%}img{min-height:16rem}}
</style>
