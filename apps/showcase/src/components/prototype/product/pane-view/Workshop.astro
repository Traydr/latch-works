---
/** PROTOTYPE — Workshop / Pane View. Tokens: steel/panel/seam/zinc/dim, delivery stripe #38A8E8. Signature: glazed screenshot cabinet and data-backed web-delivery plate. */
import "@fontsource/barlow-condensed/600.css"; import "@fontsource/barlow-condensed/700.css"; import "@fontsource/barlow/400.css"; import "@fontsource/barlow/500.css"; import "@fontsource/ibm-plex-mono/400.css"; import "@fontsource/ibm-plex-mono/500.css";
import type { Product } from "@/data/products";
interface Props { product: Product; } const { product } = Astro.props;
---
<main class="workshop"><a class="back" href="/">← All stages</a><section class="nameplate"><i class="stripe"></i><span class="screw tl"></span><span class="screw tr"></span><span class="screw bl"></span><span class="screw br"></span><p class="kicker">STAGE 04 · VIEW</p><h1>{product.name}</h1><p class="tagline">{product.tagline}</p><p class="description">{product.description}</p><dl class="specs"><div><dt>PATH</dt><dd>{product.repoPath}</dd></div><div><dt>TYPE</dt><dd>APP</dd></div><div><dt>ROLE</dt><dd>{product.tagline}</dd></div></dl></section>
<section class="cabinet"><div class="section-head"><p>GLAZED CABINET</p><h2>Private web delivery</h2></div><dl class="delivery"><div><dt>SIGNED DELIVERY</dt><dd>Authenticated delivery</dd></div><div><dt>ACCESS MODE</dt><dd>Read-only</dd></div></dl><div class="glass"><figure class="hero-bezel"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><figcaption>{product.heroScreenshot.caption}</figcaption></figure><div class="gallery">{product.gallery.map((shot,index)=><figure class="bezel"><span>VIEW {String(index+1).padStart(2,"0")}</span><img src={shot.src} alt={shot.alt}/><figcaption>{shot.caption}</figcaption></figure>)}</div></div></section>
<section class="features"><div class="section-head"><p>DELIVERY REGISTER</p><h2>Cabinet functions</h2></div><div class="feature-list">{product.features.map((feature,index)=><article><span>{String(index+1).padStart(2,"0")}</span><h3>{feature.title}</h3><p>{feature.description}</p></article>)}</div></section><section class="highlights"><h2>Workshop notes</h2><ul>{product.highlights.map(highlight=><li>{highlight}</li>)}</ul></section><a class="manual" href={`/docs/${product.slug}`}>Service manual <span>→</span></a></main>
<style>
.workshop{--steel:#1b1f23;--panel:#23282e;--seam:#343a41;--zinc:#c9cdd3;--dim:#7c828a;--accent:#38a8e8;background:radial-gradient(color-mix(in srgb,#343a41 45%,transparent) 1px,transparent 1px) 0 0/22px 22px,var(--steel);color:var(--zinc);font-family:"Barlow",sans-serif;min-height:100vh;padding:2rem max(1rem,calc((100% - 70rem)/2)) 4rem}.back,.kicker,.specs,.section-head p,.delivery dt,.bezel span,figcaption,.manual{font:400 .72rem "IBM Plex Mono",monospace;letter-spacing:.1em}.back{color:var(--zinc);text-decoration:none;display:inline-block;margin-bottom:1.5rem}.back:focus-visible,.manual:focus-visible{outline:2px solid var(--accent);outline-offset:4px}.nameplate{position:relative;overflow:hidden;padding:2.6rem clamp(1.3rem,5vw,3.5rem);background:linear-gradient(180deg,#262c32,#1e2328);border:1px solid var(--seam);box-shadow:inset 0 1px #ffffff10,0 20px 40px -24px #000}.stripe{position:absolute;inset:0 auto 0 0;width:5px;background:var(--accent)}.screw{position:absolute;width:.78rem;height:.78rem;border-radius:50%;background:linear-gradient(45deg,transparent 43%,#101315 44% 56%,transparent 57%),radial-gradient(circle at 35% 30%,#626b74,#252a30 72%);box-shadow:inset 0 -1px 2px #000}.tl{top:.6rem;left:.7rem}.tr{top:.6rem;right:.7rem;transform:rotate(30deg)}.bl{bottom:.6rem;left:.7rem;transform:rotate(65deg)}.br{bottom:.6rem;right:.7rem;transform:rotate(110deg)}.kicker{color:var(--accent);margin:0}.nameplate h1,.section-head h2,.highlights h2{font:700 2.1rem "Barlow Condensed",sans-serif;text-transform:uppercase;letter-spacing:.03em}.nameplate h1{font-size:clamp(3.8rem,10vw,7rem);line-height:.82;color:#eef0f2;margin:.7rem 0}.tagline{font-size:1.3rem;margin:0}.description{color:var(--dim);max-width:45rem;line-height:1.6;margin:1rem 0 1.5rem}.specs{margin:0;border-top:1px solid var(--seam);max-width:48rem}.specs div{display:grid;grid-template-columns:4.5rem 1fr;gap:1rem;padding:.55rem 0;border-bottom:1px dashed var(--seam)}.specs dt{color:var(--dim)}.specs dd{margin:0;line-height:1.45}.cabinet,.features,.highlights{margin-top:3rem}.section-head{border-bottom:1px solid var(--seam);margin-bottom:1rem}.section-head p{color:var(--accent);margin:0 0 .35rem}.section-head h2,.highlights h2{margin:0 0 .75rem}.delivery{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--seam);gap:1px;background:var(--seam);margin:0 0 1px}.delivery div{background:var(--panel);padding:.75rem 1rem}.delivery dt{color:var(--accent);display:block}.delivery dd{font:600 1.2rem "Barlow Condensed",sans-serif;text-transform:uppercase;display:block;margin:.25rem 0 0}.glass{position:relative;background:linear-gradient(135deg,#ffffff0d,#ffffff02 42%,transparent 60%);border:1px solid #ffffff1a;padding:1rem;box-shadow:inset 0 1px #ffffff12,inset 0 0 2rem #0b1015}.hero-bezel,.bezel{position:relative;margin:0;background:#101315;border:1px solid #090b0d;padding:.55rem;box-shadow:inset 0 2px 10px #000}.hero-bezel img,.bezel img{display:block;width:100%}.hero-bezel figcaption,.bezel figcaption{color:var(--dim);padding:.6rem .1rem .05rem}.gallery{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem}.bezel span{display:block;color:var(--accent);padding:0 0 .55rem}.feature-list{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--seam);gap:1px;background:var(--seam)}.feature-list article{background:var(--panel);padding:1.15rem}.feature-list span{font:500 .72rem "IBM Plex Mono",monospace;color:var(--accent)}.feature-list h3{font:600 1.35rem "Barlow Condensed",sans-serif;text-transform:uppercase;margin:.5rem 0 .3rem}.feature-list p{color:var(--dim);line-height:1.55;font-size:.9rem;margin:0}.highlights{background:linear-gradient(180deg,#262c32,#1e2328);border:1px solid var(--seam);padding:1.2rem}.highlights ul{margin:0;padding:0;list-style:none}.highlights li{color:var(--dim);padding:.45rem 0 .45rem 1.15rem;border-bottom:1px dashed var(--seam)}.highlights li:last-child{border:0}.highlights li::before{content:"▸";color:var(--accent);position:absolute;margin-left:-1.15rem}.manual{display:inline-block;color:var(--accent);border:1px solid color-mix(in srgb,var(--accent) 65%,transparent);padding:.7rem .9rem;text-decoration:none;margin-top:1.5rem;transition:background .16s ease,transform .16s ease}.manual:hover{background:color-mix(in srgb,var(--accent) 12%,transparent)}.manual:active{transform:scale(.97)}@media(max-width:700px){.feature-list{grid-template-columns:1fr 1fr}}@media(max-width:420px){.workshop{padding-inline:1rem}.nameplate{padding:2.2rem 1.15rem}.nameplate h1{font-size:3.55rem}.delivery,.gallery,.feature-list{grid-template-columns:1fr}.glass{padding:.55rem}}
</style>
