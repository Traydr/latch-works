---
// PROTOTYPE: Atlas — parchment #F0EBDD, panel #E9E2CF, ink #2B2A24, dim #7A7260, contour #C9BBA0, route #C4442C; Geist + IBM Plex Mono.
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
---
<main class="atlas"><nav><a href="/">← All stages</a><span>REF PV-04</span></nav><header><p>STAGE 04 · VIEW</p><h1>{product.name}</h1><em>{product.tagline}</em><p>{product.description}</p><code>GRID REF / {product.repoPath}</code></header><figure class="main-plate"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><figcaption>PV-04 / {product.heroScreenshot.caption}</figcaption></figure><section class="landmarks"><div class="heading"><p>LANDMARKS</p><h2>The archive,<br/>at a distance.</h2></div><ul>{product.features.map(f=><li><span>⊕</span><div><h3>{f.title}</h3><p>{f.description}</p></div></li>)}</ul></section><section class="plates">{product.gallery.map((shot,i)=><figure><img src={shot.src} alt={shot.alt}/><figcaption>PV-0{5+i} / {shot.caption}</figcaption></figure>)}</section><section class="notes"><p>FIELD NOTES</p><div>{product.highlights.map(h=><span>{h}</span>)}</div></section><a class="guide" href={`/docs/${product.slug}`}>Trail guide →</a></main>
<style>
:global(:root){--p:#F0EBDD;--q:#E9E2CF;--i:#2B2A24;--d:#7A7260;--l:#C9BBA0;--r:#C4442C}.atlas{max-width:1300px;margin:auto;padding:2rem;color:var(--i);min-height:100vh;background:var(--p);background-image:repeating-radial-gradient(ellipse at 100% 15%,transparent 0 42px,rgba(201,187,160,.14) 43px 44px,transparent 45px 84px)}nav{display:flex;justify-content:space-between;font:500 .72rem "IBM Plex Mono",monospace;color:var(--d)}nav a,.guide{color:var(--r);text-decoration:none}header{padding:7rem 0 4rem;max-width:820px}header>p:first-child,code,figcaption,.heading>p,.notes>p{font:500 .7rem "IBM Plex Mono",monospace;letter-spacing:.08em;color:var(--r)}h1{font-size:clamp(5rem,11vw,10rem);line-height:.78;letter-spacing:-.1em;margin:1.2rem 0}em{font-size:1.6rem;color:var(--r);font-style:normal}header>p:not(:first-child){max-width:640px;color:var(--d);line-height:1.6;font-size:1.1rem}code{display:block;color:var(--d);margin-top:2rem}.main-plate{margin:0;padding:10px;background:var(--q);border:1px solid var(--l);background-image:linear-gradient(90deg,transparent 32.9%,rgba(43,42,36,.17) 33%,transparent 33.1%),linear-gradient(0deg,transparent 49.9%,rgba(43,42,36,.15) 50%,transparent 50.1%)}.main-plate img{display:block;width:100%;max-height:700px;object-fit:cover}.main-plate figcaption,.plates figcaption{padding:.8rem 0 0;font-size:.62rem;color:var(--d)}.landmarks{padding:8rem 0;display:grid;grid-template-columns:1fr 2fr;gap:8rem}.heading h2{font-size:3.4rem;line-height:.88;letter-spacing:-.075em;margin:1rem 0}.landmarks ul{list-style:none;padding:0;margin:0;border-top:1px solid var(--i)}.landmarks li{display:grid;grid-template-columns:28px 1fr;gap:1rem;padding:1.25rem 0;border-bottom:1px solid var(--l)}.landmarks li>span{color:var(--r)}.landmarks h3{font-size:1.1rem;margin:0}.landmarks p{margin:.35rem 0 0;color:var(--d);line-height:1.5;font-size:.9rem}.plates{display:grid;grid-template-columns:1.4fr 1fr;gap:2rem;align-items:start}.plates figure{margin:0;padding:7px;background:var(--q);border:1px solid var(--l)}.plates figure:last-child{margin-top:5rem}.plates img{display:block;width:100%;aspect-ratio:16/10;object-fit:cover}.notes{border-top:1px solid var(--i);border-bottom:1px solid var(--i);margin-top:7rem;padding:1.2rem 0;display:grid;grid-template-columns:180px 1fr}.notes>p{margin:0}.notes div{display:flex;flex-wrap:wrap;gap:.6rem}.notes span{font:500 .68rem "IBM Plex Mono";color:var(--d);padding:.5rem .7rem;border:1px solid var(--l)}.guide{display:inline-block;margin:3rem 0;font:500 1rem "IBM Plex Mono",monospace}a:focus-visible{outline:3px solid var(--r);outline-offset:4px}@media(max-width:700px){.atlas{padding:1.25rem}header{padding:4rem 0 3rem}h1{font-size:4.6rem}.landmarks{padding:4rem 0;grid-template-columns:1fr;gap:2rem}.plates{gap:1rem}.plates figure:last-child{margin-top:2rem}.notes{margin-top:4rem;grid-template-columns:1fr;gap:1rem}}@media(max-width:430px){.plates{grid-template-columns:1fr}.plates figure:last-child{margin-top:0}}
</style>
