---
// PROTOTYPE: Pigment 04 is an airy sky field of overlapping authenticated viewing panes and black lab notes.
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
---
<main>
  <section class="hero"><a class="back" href="/">← All stages</a><div class="copy"><h1>{product.name}</h1><p class="tagline">{product.tagline}</p><p>{product.description}</p><code>{product.repoPath}</code></div><div class="panes"><figure class="hero-pane"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><figcaption>{product.heroScreenshot.caption}</figcaption></figure><figure class="small-pane"><img src={product.gallery[0].src} alt={product.gallery[0].alt}/></figure></div></section>
  <section class="ingredients"><p class="eyebrow">VIEWING INGREDIENTS / PRIVATE BY DESIGN</p><ul>{product.features.map((feature) => <li><i></i><div><h2>{feature.title}</h2><p>{feature.description}</p></div></li>)}</ul></section>
  <section class="gallery"><figure><img src={product.gallery[1].src} alt={product.gallery[1].alt}/><figcaption>{product.gallery[1].caption}</figcaption></figure><aside><p>READ-ONLY ACCESS</p><span>Private pane, signed delivery, responsive archive.</span></aside></section>
  <p class="highlight">{product.highlights.join("  /  ")}</p><a class="cta" href={`/docs/${product.slug}`}>Read the formula →</a>
</main>
<style>
 :global(*){box-sizing:border-box}:global(body){margin:0;background:#101014;color:#f4f4f2;font-family:Geist Variable,Arial,sans-serif}.hero{background:#38a8e8;color:#101014;min-height:820px;padding:2rem clamp(1.4rem,7vw,8rem) 7rem;position:relative;overflow:hidden}.back{font:700 .75rem "JetBrains Mono",monospace;color:inherit}.back:focus-visible,.cta:focus-visible{outline:3px solid currentColor;outline-offset:5px}.copy{position:relative;z-index:1;max-width:600px;padding-top:11rem}.chip,.eyebrow,.highlight,code,figcaption,.gallery aside p{font-family:"JetBrains Mono",monospace;font-size:.7rem;letter-spacing:.04em}.chip{display:inline-block;border:1px solid;padding:.55rem .7rem;font-weight:700;margin:0 0 2rem}.copy h1{font-size:clamp(5rem,12vw,12rem);line-height:.7;letter-spacing:-.105em;margin:0}.tagline{font-weight:700;font-size:1.55rem;margin:2rem 0 .75rem}.copy>p:last-of-type{max-width:440px;line-height:1.5}.panes figure{margin:0;background:#38a8e8;box-shadow:18px 18px #101014}.panes img,.gallery img{display:block;width:100%;filter:grayscale(1) contrast(1.12) brightness(1.02);mix-blend-mode:multiply;opacity:.92}.panes figcaption,.gallery figcaption{padding:.8rem}.hero-pane{position:absolute;right:7vw;top:18%;width:min(54vw,760px);transform:rotate(2.5deg)}.small-pane{position:absolute;right:2vw;bottom:6%;width:min(27vw,390px);transform:rotate(-5deg)}.ingredients{padding:clamp(5rem,8vw,8rem) clamp(1.4rem,8vw,10rem)}.eyebrow{color:#9a9aa3}.ingredients ul{list-style:none;padding:0;margin:3rem 0 0;display:grid;grid-template-columns:repeat(2,1fr);column-gap:5rem}.ingredients li{display:flex;gap:1rem;border-top:1px solid #36363d;padding:1.4rem 0}.ingredients i{display:block;width:10px;height:10px;background:#38a8e8;flex:none;margin-top:.35rem}.ingredients h2{font-size:1.15rem;margin:0}.ingredients p{margin:.5rem 0 0;color:#9a9aa3;line-height:1.5}.gallery{background:#17171c;padding:clamp(3rem,7vw,7rem);display:grid;grid-template-columns:1fr .45fr;gap:3rem;align-items:end}.gallery figure{margin:0;background:#38a8e8}.gallery aside{border-top:1px solid #38a8e8;padding-top:1rem;color:#9a9aa3;line-height:1.5}.gallery aside p{color:#38a8e8;font-weight:700}.gallery aside span{font-size:clamp(1.4rem,2.6vw,2.5rem);line-height:1;letter-spacing:-.05em;color:#f4f4f2;font-weight:700}.highlight{color:#9a9aa3;padding:1.3rem clamp(1.4rem,8vw,10rem);line-height:2}.cta{display:block;color:#101014;background:#38a8e8;text-decoration:none;padding:clamp(3rem,7vw,7rem);font-size:clamp(2.5rem,6vw,6rem);font-weight:700;letter-spacing:-.07em}@media(max-width:900px){.hero{min-height:auto;padding-bottom:4rem}.copy{padding-top:6rem}.panes{display:grid;gap:1.5rem;margin-top:4rem}.hero-pane,.small-pane{position:relative;inset:auto;width:auto;transform:none}.ingredients ul{grid-template-columns:1fr}.gallery{grid-template-columns:1fr}} 
</style>
