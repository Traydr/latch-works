---
// PROTOTYPE: Blueprint. Airy blue technical sheet with quiet white figure frames; mono operational notes, condensed title, cyan reserved for active paths.
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
const deliveryNotes = ["Authenticated gallery access only", "Signed thumbnail and preview delivery", "Read-only archive on web and mobile", ...product.highlights];
---
<main class="sheet"><a class="back" href="/">← ALL STAGES</a><header><p>STAGE 04 · PANE VIEW</p><h1>{product.name}</h1><strong>{product.tagline}</strong><div class="intro"><p>{product.description}</p><span>{product.repoPath}</span></div></header><section class="hero"><div class="label"><span>FIG. 1 / AUTHENTICATED GALLERY</span><span>WEB + MOBILE ACCESS</span></div><div class="frame"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><svg viewBox="0 0 100 56" aria-hidden="true"><path d="M3 8H22L34 22M98 8H77L63 18M97 50H75L61 36"/><circle cx="34" cy="22" r="1"/><circle cx="63" cy="18" r="1"/><circle cx="61" cy="36" r="1"/></svg><i class="left">FOLDER NAVIGATION</i><i class="top">SIGNED DELIVERY</i><i class="bottom">MEDIA GRID</i></div></section><div class="support"><section class="delivery"><div class="label"><span>DELIVERY NOTES</span><span>READ-ONLY</span></div><ol>{deliveryNotes.map((note,index)=><li><span>{String(index+1).padStart(2,"0")}</span>{note}</li>)}</ol></section><section class="parts"><div class="label"><span>PARTS LIST</span><span>06 ITEMS</span></div><table><thead><tr><th>PART</th><th>FUNCTION</th></tr></thead><tbody>{product.features.map((feature,index)=><tr><td>{String(index+1).padStart(2,"0")} / {feature.title}</td><td>{feature.description}</td></tr>)}</tbody></table></section></div><section class="figures"><div class="label"><span>FIG. 2–3 / READING + ACCESS</span><span>SUPPORTING VIEWS</span></div>{product.gallery.map((shot,index)=><figure><img src={shot.src} alt={shot.alt}/><figcaption>FIG. {index+2} · {shot.caption}</figcaption></figure>)}</section><footer><div><span>PROJECT</span><b>{product.name}</b><span>PATH</span><b>apps/pane-view</b><span>STAGE</span><b>04</b></div><a href="/docs/pane-view">ASSEMBLY DOCS →</a></footer></main>
<style>
.sheet{--p:#173E7A;--d:#122F5F;--l:rgba(255,255,255,.75);--g:rgba(255,255,255,.07);--t:#F2F6FC;--m:#9DB4D8;--c:#7FD4FF;color:var(--t);min-height:100vh;padding:clamp(1.25rem,5vw,5.5rem);box-sizing:border-box;background-color:var(--p);background-image:linear-gradient(var(--g) 1px,transparent 1px),linear-gradient(90deg,var(--g) 1px,transparent 1px);background-size:28px 28px;font-family:"IBM Plex Mono",monospace}.back,.label,header>p,footer{font-size:.68rem;letter-spacing:.08em}.back{color:var(--c);text-decoration:none}.back:focus-visible,footer a:focus-visible{outline:2px solid var(--c);outline-offset:4px}header{padding:2rem 0 2.5rem;border-bottom:1px solid var(--l)}header>p{color:var(--c);margin:0}h1{font:700 clamp(5rem,13vw,12rem)/.7 "Barlow Condensed",sans-serif;margin:.5rem 0}header strong{color:var(--c);font-size:1rem;font-weight:400}.intro{max-width:760px;margin-top:1rem}.intro p{color:var(--m);font-size:.83rem;line-height:1.75;margin:.7rem 0}.intro span{font-size:.7rem;border-bottom:1px solid var(--l);padding:.35rem 0}.label{display:flex;justify-content:space-between;color:var(--m);margin-bottom:.65rem}.hero{padding:3.5rem 0 5rem}.frame{position:relative;overflow:hidden;border:1px solid var(--l);background:var(--d);aspect-ratio:1.78}.frame img{width:100%;height:100%;object-fit:cover;display:block}.frame svg{position:absolute;inset:0;width:100%;height:100%;stroke:var(--c);fill:none;stroke-width:.25}.frame circle{fill:var(--c);stroke:none}.frame i{position:absolute;background:var(--p);font-size:clamp(.4rem,.62vw,.62rem);color:var(--c);font-style:normal;padding:.13rem}.left{left:2%;top:9%}.top{right:2%;top:8%}.bottom{right:2%;bottom:9%}.support{display:grid;grid-template-columns:minmax(16rem,1fr) minmax(0,2fr);gap:clamp(2rem,8vw,8rem)}.delivery,.parts,.figures{border-top:1px solid var(--l);padding-top:.75rem}.delivery ol{list-style:none;padding:0;margin:0}.delivery li{display:grid;grid-template-columns:2rem 1fr;gap:.6rem;border-bottom:1px solid rgba(255,255,255,.35);padding:.8rem 0;color:var(--m);font-size:.72rem;line-height:1.55}.delivery li span{color:var(--c)}table{width:100%;border-collapse:collapse;font-size:.68rem}th{text-align:left;color:var(--c);font-weight:400;padding:.65rem 0;border-bottom:1px solid var(--l)}td{padding:.75rem .5rem .75rem 0;border-bottom:1px solid rgba(255,255,255,.35);color:var(--m);line-height:1.5}td:first-child{width:30%;color:var(--t)}.figures{margin-top:5rem;display:grid;grid-template-columns:1fr 1fr;gap:clamp(1rem,4vw,4rem)}.figures .label{grid-column:1/-1}.figures figure{margin:0}.figures img{display:block;width:100%;border:1px solid var(--l)}figcaption{color:var(--m);font-size:.64rem;padding-top:.55rem}footer{border-top:1px solid var(--l);margin-top:5rem;padding-top:1rem;display:flex;align-items:center;justify-content:space-between}footer div{display:flex;gap:.65rem;color:var(--m)}footer b{color:var(--t);font-weight:500}footer a{color:var(--c);text-decoration:none;border:1px solid var(--c);padding:.75rem}@media(max-width:650px){.support{grid-template-columns:1fr;gap:3rem}.figures{grid-template-columns:1fr}.figures .label{grid-column:auto}footer{align-items:start;flex-direction:column;gap:1rem}footer div{flex-wrap:wrap}} 
</style>
