---
import "@fontsource/courier-prime/400.css";
import "@fontsource/courier-prime/700.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
---
<!-- PROTOTYPE: Dossier tokens — manila #D8C496, paper #F4EEDF, ink #23211B, dim #6B6353, red pencil #B23A25, redaction #1C1A16; Courier Prime, airy reading file, one read-only stamp. -->
<main class="page"><a href="/" class="back">← All stages</a><article class="file"><header><div class="tab">PANE VIEW / WEB ACCESS</div><p class="label">SUBJECT</p><h1>{product.tagline}</h1><p>{product.description}</p><small>FILE {product.repoPath} · STAGE 04 OF 04</small></header><figure class="hero"><i class="clip"></i><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><figcaption>EXHIBIT A — {product.heroScreenshot.caption}</figcaption></figure><section class="reading"><p class="label">STATEMENTS / ACCESS RECORD</p>{product.features.map((feature,i)=><article><span>{String(i+1).padStart(2,"0")}</span><div><h2>{feature.title}</h2><p>{feature.description}</p></div></article>)}</section><section class="gallery">{product.gallery.map((shot,i)=><figure><img src={shot.src} alt={shot.alt}/><figcaption>EXHIBIT {String.fromCharCode(66+i)} — {shot.caption}</figcaption></figure>)}</section><footer><div><p class="label">FILE NOTES</p>{product.highlights.map(item=><p>— {item}</p>)}</div><div class="verdict"><p>DELIVERY</p><span>████████ signed, time-limited tokens</span><strong>READ-ONLY</strong><a href={`/docs/${product.slug}`}>Full file →</a></div></footer></article></main>
<style>
.page{--m:#d8c496;--d:#c4af7d;--p:#f4eedf;--i:#23211b;--x:#6b6353;--r:#b23a25;max-width:840px;margin:auto;padding:2rem 1.25rem 6rem;color:var(--i);font-family:"Courier Prime",monospace;background:var(--p);background-image:repeating-linear-gradient(0deg,transparent 0 4px,#23211b04 5px)}a{color:var(--i);font-weight:700;text-underline-offset:.2em}.back{display:inline-block;margin-bottom:3.5rem}.file{background:var(--p)}header{position:relative;background:var(--m);border:1px solid #9e8b60;padding:3rem clamp(1.4rem,6vw,4.5rem)}.tab{position:absolute;top:0;left:1.5rem;transform:translateY(-100%);background:var(--d);padding:.5rem .9rem;border:1px solid #9e8b60;border-bottom:0;font-size:.75rem;font-weight:700;letter-spacing:.09em}.label,small{font-size:.74rem;letter-spacing:.1em;color:var(--x);font-weight:700}header .label{margin:0}h1{font-size:clamp(2.6rem,7vw,5.2rem);line-height:.92;text-transform:uppercase;margin:.55rem 0 1rem}header>p:not(.label){line-height:1.55;margin:0 0 1.5rem}.hero{position:relative;margin:3.5rem -2rem 4rem;padding:.75rem;background:#fffaf0;border:1px solid #aaa08c;box-shadow:6px 7px #23211b18}.hero img,.gallery img{width:100%;display:block;filter:saturate(.72)}figcaption{font-size:.78rem;line-height:1.4;margin-top:.7rem}.clip{position:absolute;left:1.3rem;top:-1rem;width:13px;height:35px;border:2px solid var(--i);border-bottom:0;border-radius:8px 8px 0 0;transform:rotate(-12deg)}.reading{margin:auto;max-width:680px}.reading> .label{display:block;margin-bottom:.8rem}.reading article{display:grid;grid-template-columns:3rem 1fr;gap:.7rem;padding:1.45rem 0;border-top:1px solid #aaa08c}.reading article:last-child{border-bottom:1px solid #aaa08c}.reading span{color:var(--r);font-weight:700}.reading h2{font-size:1.05rem;margin:0 0 .45rem}.reading p{margin:0;line-height:1.55;color:var(--x);font-size:.9rem}.gallery{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin:4rem 0}.gallery figure{margin:0;padding:.6rem;background:#fffaf0;border:1px solid #aaa08c}.gallery figure:first-child{transform:rotate(-.6deg)}.gallery figure:last-child{transform:rotate(.6deg)}footer{border-top:2px solid var(--i);padding-top:1.4rem;display:flex;justify-content:space-between;gap:2rem}footer>div:first-child p:not(.label){font-size:.84rem;color:var(--x);margin:.5rem 0}.verdict{text-align:right;font-size:.78rem}.verdict p{margin:0 0 .4rem}.verdict span{display:block;background:#1c1a16;color:#1c1a16;border-radius:2px;margin:0 0 1.2rem}.verdict strong{display:inline-block;padding:.45rem .65rem;color:var(--r);border:3px solid var(--r);letter-spacing:.1em;transform:rotate(-6deg)}.verdict a{display:block;margin-top:1.35rem}a:focus-visible{outline:3px solid var(--r);outline-offset:4px}@media(max-width:700px){.hero{margin:3rem 0}.gallery{grid-template-columns:1fr}footer{display:block}.verdict{text-align:left;margin-top:2rem}}@media(max-width:390px){.page{padding-inline:1rem}.tab{left:.6rem;font-size:.65rem}.reading article{grid-template-columns:2.3rem 1fr}}
</style>
