---
/**
 * PROTOTYPE — Pane View product page "Reading Room". Throwaway. Do not ship.
 *
 * Concept: the private reading room. Pane View is where the archive is read,
 * so the page is quiet daylight: editorial serif, generous air, and the app
 * shown as layered panes of glass — the gallery in front, viewer and login
 * floating behind. The only product page in the set that works in the light.
 *
 * Tokens
 *   Color: daylight #F5F7F8 · ink #1D2530 · dim #5D6B7A · hairline #D9E0E6
 *          sky #2F8FD0 (links + quiet emphasis) · frost rgba(255,255,255,.6)
 *   Type:  IBM Plex Serif 600 (headlines) · Geist (body) · IBM Plex Mono (labels)
 *   Layout: calm header → layered floating panes (gallery / viewer / login)
 *           → hairline feature grid → serene highlights → quiet CTA.
 *   Signature: overlapping floating panes with frosted caption chips.
 */
import "@fontsource/ibm-plex-serif/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import type { Product } from "@/data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const [galleryShot, viewerShot, loginShot] = [
  product.heroScreenshot,
  product.gallery[0],
  product.gallery[1],
];
---

<div class="room">
  <div class="wrap">
    <a class="back" href="/">← All stages</a>

    <header class="room-head">
      <p class="eyebrow">STAGE 04 · VIEW · {product.repoPath}</p>
      <h1>{product.tagline}</h1>
      <p class="desc">{product.description}</p>
      <p class="access">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="4" y="11" width="16" height="10" rx="2" />
          <path d="M8 11V7a4 4 0 0 1 8 0v4" />
        </svg>
        Authenticated · signed delivery · read-only
      </p>
    </header>

    <!-- Floating panes -->
    <section class="panes" aria-label={`${product.name} views`}>
      <figure class="pane main">
        <img src={galleryShot.src} alt={galleryShot.alt} />
        <figcaption class="chip">{galleryShot.caption}</figcaption>
      </figure>
      {
        viewerShot && (
          <figure class="pane float-a">
            <img src={viewerShot.src} alt={viewerShot.alt} loading="lazy" />
            <figcaption class="chip">{viewerShot.caption}</figcaption>
          </figure>
        )
      }
      {
        loginShot && (
          <figure class="pane float-b">
            <img src={loginShot.src} alt={loginShot.alt} loading="lazy" />
            <figcaption class="chip">{loginShot.caption}</figcaption>
          </figure>
        )
      }
    </section>

    <!-- Features -->
    <section class="features">
      <h2 class="section-label"><span>What reading here is like</span></h2>
      <div class="feature-grid">
        {
          product.features.map((feature) => (
            <div class="feature">
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Highlights + CTA -->
    <footer class="room-foot">
      <ul class="highlights">
        {product.highlights.map((h) => <li>{h}</li>)}
      </ul>
      <a class="docs-link" href="/docs/pane-view">Browse the reading guide →</a>
    </footer>
  </div>
</div>

<style>
  .room {
    --day: #f5f7f8;
    --ink: #1d2530;
    --dim: #5d6b7a;
    --hairline: #d9e0e6;
    --sky: #2f8fd0;
    background:
      radial-gradient(ellipse 90% 45% at 70% -5%, rgba(47, 143, 208, 0.08), transparent 65%),
      var(--day);
    color: var(--ink);
    font-family: "Geist Variable", system-ui, sans-serif;
    padding-bottom: 5rem;
  }

  .wrap {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 0;
  }

  .back {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--dim);
    text-decoration: none;
    margin-bottom: 3.5rem;
  }
  .back:hover { color: var(--sky); }

  /* — Header — */
  .room-head {
    max-width: 44rem;
  }
  .eyebrow {
    margin: 0 0 1.25rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    letter-spacing: 0.3em;
    color: var(--sky);
  }
  .room-head h1 {
    margin: 0;
    font-family: "IBM Plex Serif", Georgia, serif;
    font-weight: 600;
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-wrap: balance;
  }
  .desc {
    margin: 1.5rem 0 0;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--dim);
  }
  .access {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--dim);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.45rem 0.9rem;
    background: rgba(255, 255, 255, 0.6);
  }
  .access svg {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--sky);
  }

  /* — Floating panes — */
  .panes {
    position: relative;
    margin-top: 4.5rem;
    padding-bottom: 6rem;
  }
  .pane {
    margin: 0;
    position: relative;
    border-radius: 12px;
    overflow: visible;
  }
  .pane img {
    display: block;
    width: 100%;
    border-radius: 10px;
    box-shadow:
      0 0 0 1px rgba(29, 37, 48, 0.08),
      0 32px 64px -24px rgba(29, 37, 48, 0.35);
  }
  .pane.main {
    width: 74%;
  }
  .pane.float-a {
    position: absolute;
    right: 0;
    top: 18%;
    width: 38%;
  }
  .pane.float-b {
    position: absolute;
    left: 6%;
    bottom: 0;
    width: 30%;
  }
  .pane.float-a img,
  .pane.float-b img {
    box-shadow:
      0 0 0 1px rgba(29, 37, 48, 0.1),
      0 24px 48px -18px rgba(29, 37, 48, 0.4);
  }
  .chip {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    max-width: calc(100% - 1.8rem);
    background: rgba(255, 255, 255, 0.62);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    font-size: 0.72rem;
    color: var(--ink);
    box-shadow: 0 6px 16px -8px rgba(29, 37, 48, 0.3);
  }
  @media (max-width: 48rem) {
    .panes {
      display: grid;
      gap: 1.5rem;
      padding-bottom: 0;
    }
    .pane.main,
    .pane.float-a,
    .pane.float-b {
      position: relative;
      width: 100%;
      top: auto;
      left: auto;
      right: auto;
      bottom: auto;
    }
  }

  /* — Features — */
  .features {
    margin-top: 5rem;
  }
  .section-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 2.25rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .section-label::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--hairline);
  }
  .feature-grid {
    display: grid;
    gap: 2.5rem 3rem;
  }
  @media (min-width: 56rem) {
    .feature-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .feature {
    border-top: 1px solid var(--hairline);
    padding-top: 1.1rem;
  }
  .feature h3 {
    margin: 0;
    font-family: "IBM Plex Serif", Georgia, serif;
    font-weight: 600;
    font-size: 1.1rem;
  }
  .feature p {
    margin: 0.6rem 0 0;
    font-size: 0.87rem;
    line-height: 1.7;
    color: var(--dim);
  }

  /* — Footer — */
  .room-foot {
    margin-top: 4.5rem;
    border-top: 1px solid var(--hairline);
    padding-top: 2.5rem;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 56rem) {
    .room-foot {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
  }
  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    font-size: 0.88rem;
    color: var(--dim);
  }
  .highlights li::before {
    content: "·  ";
    color: var(--sky);
    font-weight: 700;
  }
  .docs-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sky);
    text-decoration: none;
    border-bottom: 1.5px solid var(--sky);
    padding-bottom: 0.15rem;
    white-space: nowrap;
  }
  .docs-link:hover { opacity: 0.75; }
  .docs-link:focus-visible {
    outline: 2px solid var(--sky);
    outline-offset: 3px;
  }
</style>
