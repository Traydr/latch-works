---
/** PROTOTYPE — Riso: blue #3B82F6 pane collage on #F6F1E7 with pink name misregistration. */
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
---
<main class="riso pane"><a class="back" href="/">← All stages</a><section class="hero"><div class="intro"><p>STAGE 04 / VIEW</p><h1 data-print={product.name}>{product.name}</h1><strong>{product.tagline}</strong><p>{product.description}</p><code>{product.repoPath}</code></div><div class="collage"><figure class="main"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} /><figcaption>{product.heroScreenshot.caption}</figcaption></figure><figure class="viewer"><img src={product.gallery[0].src} alt={product.gallery[0].alt} /></figure><figure class="login"><img src={product.gallery[1].src} alt={product.gallery[1].alt} /></figure></div></section><section class="features">{product.features.map((feature,index)=><article><b>0{index+1}</b><h2>{feature.title}</h2><p>{feature.description}</p></article>)}</section><p class="ticker">{product.highlights.join("  /  ")}</p><a class="cta" href={`/docs/${product.slug}`}>Read more →</a></main>
<style>
@import "@fontsource/barlow-condensed/600.css";@import "@fontsource/barlow-condensed/700.css";@import "@fontsource/ibm-plex-mono/400.css";@import "@fontsource/ibm-plex-mono/500.css";.riso{--paper:#F6F1E7;--deep:#EFE7D8;--ink:#1C1A17;--riso:#3B82F6;color:var(--ink);background:var(--paper) radial-gradient(rgba(28,26,23,.13) .55px,transparent .8px);background-size:5px 5px;font-family:"IBM Plex Mono",monospace;padding:1.5rem 4vw 0;overflow:hidden}.back{color:inherit;font-size:.75rem;text-decoration:none;border-bottom:1px solid}.hero{background:var(--riso);padding:clamp(1.5rem,5vw,5rem);margin:1.5rem 0 4rem;min-height:720px;box-shadow:7px 8px 0 var(--ink);position:relative}.intro{max-width:47%;position:relative;z-index:2}.intro>p,figcaption,.ticker{font-size:.7rem;line-height:1.6;letter-spacing:.06em}.intro h1,h2{font-family:"Barlow Condensed",sans-serif;text-transform:uppercase;line-height:.78;letter-spacing:-.05em;margin:.7rem 0}.intro h1{font-size:clamp(5.5rem,12vw,11rem);position:relative;z-index:0}.intro h1:after{content:attr(data-print);position:absolute;inset:0 auto auto 4px;color:#FF48B0;z-index:-1}.intro strong{font-size:1rem}.intro p:not(:first-child){font-size:.78rem;line-height:1.7}.intro code{font-size:.7rem;border-top:1px solid;padding-top:.7rem}.collage figure{margin:0;background:var(--ink);padding:.35rem;position:absolute;box-shadow:5px 5px 0 var(--ink)}.collage img{display:block;width:100%;object-fit:cover;filter:grayscale(1) contrast(1.16) sepia(.25);mix-blend-mode:screen;opacity:.9}.main{width:57%;right:4%;top:10%;transform:rotate(2deg)}.main img{aspect-ratio:1.34}.viewer{width:32%;right:39%;bottom:7%;transform:rotate(-3deg)}.viewer img,.login img{aspect-ratio:1.15}.login{width:25%;right:1%;bottom:4%;transform:rotate(4deg)}figcaption{padding:.45rem 0 0;color:var(--paper)}.features{display:grid;grid-template-columns:repeat(3,1fr);margin:0 4vw 4rem;border-top:1px solid}.features article{padding:1.25rem 1.25rem 1.5rem 0;margin-right:1.25rem;border-right:1px solid}.features article:nth-child(3n){border:0}.features b{font-size:.68rem;color:var(--riso)}.features h2{font-size:2.6rem}.features p{font-size:.7rem;line-height:1.65}.ticker{margin:0 -4vw;padding:1rem 4vw;border-top:2px solid;border-bottom:2px solid;white-space:nowrap;overflow:hidden}.cta{display:block;background:var(--riso);color:var(--ink);padding:2rem 4vw;font:700 clamp(2.6rem,6vw,5rem)/.8 "Barlow Condensed",sans-serif;text-transform:uppercase;text-decoration:none}a:focus-visible{outline:3px solid #FF48B0;outline-offset:4px}@media(max-width:700px){.hero{min-height:790px}.intro{max-width:100%}.main{width:78%;top:40%;right:9%}.viewer{width:43%;right:43%;bottom:3%}.login{width:34%;right:3%;bottom:6%}.features{grid-template-columns:1fr 1fr;margin-inline:0}.features article:nth-child(3n){border-right:1px solid}.features article:nth-child(2n){border:0}}@media(max-width:390px){.riso{padding-inline:1rem}.hero{min-height:750px;padding:1.25rem}.intro h1{font-size:5.1rem}.features{grid-template-columns:1fr}.features article{border-right:0!important;border-bottom:1px solid}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}}
.intro h1 { color: var(--paper); }
.intro p:not(:first-child) { max-width: 25rem; }
.viewer { right: 20%; }
</style>
