---
// PROTOTYPE: sky #38A8E8 primary pane card with overlapping viewer/login swatches, #F7F3E8 glued strips, #EFEAE0 paper, ink and metal rivets.
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
---
<main><a class="back" href="/">← All stages</a><section class="hero-zone"><article class="hero"><i class="rivet"></i><p>STAGE 4 / VIEW</p><h1>{product.name}</h1><strong>{product.tagline}</strong><p class="description">{product.description}</p><figure><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/></figure><div class="spec">{product.repoPath} · {product.kind} · stage 4</div></article><aside class="mini viewer"><i class="rivet"></i><figure><img src={product.gallery[0].src} alt={product.gallery[0].alt}/></figure><p>VIEWER</p></aside><aside class="mini login"><i class="rivet"></i><figure><img src={product.gallery[1].src} alt={product.gallery[1].alt}/></figure><p>LOGIN</p></aside></section><section class="features">{product.features.map((feature)=><article><h2>{feature.title}</h2><p>{feature.description}</p></article>)}</section><section class="lower"><div><h2>Workshop notes</h2><ul>{product.highlights.map((item)=><li>{item}</li>)}</ul></div><a class="docs" href={`/docs/${product.slug}`}>Docs →</a></section></main>
<style>
@import "@fontsource/ibm-plex-mono/400.css";@import "@fontsource/ibm-plex-mono/500.css";main{max-width:1200px;margin:auto;padding:32px clamp(18px,5vw,70px) 72px;color:#191713;font-family:"IBM Plex Mono",monospace}.back,.docs{color:#191713;font-size:12px;font-weight:500}.back:focus-visible,.docs:focus-visible{outline:3px solid #191713;outline-offset:4px}.hero-zone{position:relative;min-height:680px;padding:28px 14% 30px 0}.hero{position:relative;z-index:1;padding:35px 28px 0;border-radius:12px;background:#38A8E8;box-shadow:0 22px 38px #19171340;transform:rotate(-.8deg)}.hero>p:first-of-type,.spec,h2,.mini p{font-size:11px;letter-spacing:.08em}h1{margin:12px 0 4px;font:700 clamp(56px,9vw,108px)/.84 Geist Variable,sans-serif;letter-spacing:-.075em}strong{font-size:14px}.description{max-width:660px;margin:22px 0;font-size:13px;line-height:1.55}figure{margin:0;padding:6px;background:#F7F3E8}figure img{display:block;width:100%}.spec{position:relative;margin:15px -10px -17px;padding:15px;background:#F7F3E8;box-shadow:0 4px 8px #19171330;transform:rotate(.6deg)}.spec::before,.features article::before{content:"";position:absolute;top:-5px;left:20%;width:48px;height:10px;background:#efeae0aa}.rivet{position:absolute;z-index:2;top:14px;left:14px;width:17px;height:17px;border-radius:50%;background:radial-gradient(circle at 32% 28%,#fff 0 10%,#C9CDD3 24%,#6A6F76 74%,#42464b)}.rivet::after{content:"";position:absolute;top:7px;left:3px;width:11px;height:2px;background:#4d5258;transform:rotate(-12deg)}.mini{position:absolute;z-index:2;width:35%;padding:26px 12px 10px;border-radius:12px;background:#38A8E8;box-shadow:0 12px 24px #19171335}.mini figure{padding:5px}.mini p{margin:10px 4px 2px}.viewer{right:0;bottom:110px;transform:rotate(5deg)}.login{right:4%;bottom:-5px;transform:rotate(-4deg)}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.features article{position:relative;padding:18px;background:#F7F3E8;box-shadow:0 4px 9px #19171318}.features h2{margin:0 0 14px}.features p{margin:0;color:#6E6759;font-size:12px;line-height:1.55}.lower{display:flex;justify-content:space-between;gap:32px;align-items:end;margin-top:34px;border-top:1px solid #bdb5a8;padding-top:24px}.lower h2{margin:0 0 12px}.lower ul{padding:0;margin:0;list-style:none;border-top:1px solid #bdb5a8}.lower li{padding:10px 0;border-bottom:1px solid #bdb5a8;font-size:12px;line-height:1.45}.docs{display:block;padding:14px;background:#F7F3E8;box-shadow:0 3px 6px #19171320;white-space:nowrap}@media(max-width:700px){.hero-zone{min-height:0;padding:28px 0 34px}.mini{position:relative;width:65%;margin-top:18px}.viewer{right:auto;bottom:auto;margin-left:auto}.login{right:auto;bottom:auto;margin-left:5%}.features{grid-template-columns:1fr}.lower{display:block}.docs{display:inline-block;margin-top:22px}}@media(max-width:390px){.hero{padding:30px 16px 0}.mini{width:82%}h1{font-size:58px}}
main{background:#EFEAE0;box-shadow:0 0 0 100vmax #EFEAE0;clip-path:inset(0 -100vmax)}
</style>
