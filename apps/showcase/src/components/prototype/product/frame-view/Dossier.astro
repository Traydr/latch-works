---
import "@fontsource/courier-prime/400.css";
import "@fontsource/courier-prime/700.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
---
<!-- PROTOTYPE: Dossier tokens — manila #D8C496, paper #F4EEDF, ink #23211B, dim #6B6353, red pencil #B23A25, redaction #1C1A16; Courier Prime, centered clipped exhibit, one stamp. -->
<main class="page"><a href="/" class="back">← All stages</a><header><div class="tab">FRAME VIEW</div><p>SUBJECT / {product.tagline}</p><h1>{product.name}</h1><p>{product.description}</p><small>FILE {product.repoPath} · STAGE 02 OF 04</small></header>
<figure class="hero"><i class="clip"></i><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><figcaption>EXHIBIT A — {product.heroScreenshot.caption}</figcaption></figure>
<section class="wall"><p class="label">STATEMENTS / LOCAL REFERENCE EXPERIENCE</p><div>{product.features.map((feature,i)=><article><b>{String(i+1).padStart(2,"0")}</b><h2>{feature.title}</h2><p>{feature.description}</p></article>)}</div></section>
<section class="secondary">{product.gallery.map((shot,i)=><figure><img src={shot.src} alt={shot.alt}/><figcaption>EXHIBIT {String.fromCharCode(66+i)} — {shot.caption}</figcaption></figure>)}</section>
<footer><div><p class="label">HIGHLIGHTS</p>{product.highlights.map(item=><p>— {item}</p>)}</div><div class="right"><p>NOT EXPOSED</p><span>████████ local paths</span><strong>LOCAL FIRST</strong><a href={`/docs/${product.slug}`}>Full file →</a></div></footer></main>
<style>
.page{--m:#d8c496;--d:#c4af7d;--p:#f4eedf;--i:#23211b;--x:#6b6353;--r:#b23a25;max-width:1050px;margin:auto;padding:2rem 1.25rem 5rem;color:var(--i);font-family:"Courier Prime",monospace;background:var(--p);background-image:repeating-linear-gradient(0deg,transparent 0 4px,#23211b04 5px)}a{color:var(--i);font-weight:700;text-underline-offset:.2em}.back{display:inline-block;margin-bottom:3rem}header{text-align:center;position:relative;background:var(--m);border:1px solid #9e8b60;padding:3rem clamp(1rem,6vw,5rem) 2rem}.tab{position:absolute;top:0;left:50%;transform:translate(-50%,-100%);background:var(--d);border:1px solid #9e8b60;border-bottom:0;padding:.5rem 1rem;font-size:.78rem;font-weight:700;letter-spacing:.1em;white-space:nowrap}header p:first-of-type,.label,small{font-size:.75rem;letter-spacing:.1em;font-weight:700;color:var(--x)}h1{font-size:clamp(3rem,8vw,6rem);line-height:.9;margin:.6rem 0;text-transform:uppercase}header p:not(:first-of-type){max-width:43rem;margin:0 auto 1.3rem;line-height:1.5}.hero{position:relative;margin:4rem auto;max-width:850px;padding:.8rem;background:#fffaf0;border:1px solid #aaa08c;box-shadow:8px 9px #23211b20}.hero img,.secondary img{display:block;width:100%;filter:saturate(.72)}figcaption{font-size:.78rem;line-height:1.35;margin-top:.75rem}.clip{position:absolute;z-index:1;top:-1rem;left:50%;width:14px;height:37px;border:2px solid var(--i);border-bottom:0;border-radius:9px 9px 0 0;transform:rotate(-10deg)}.wall{border-top:2px solid var(--i);padding-top:1rem}.wall>div{display:grid;grid-template-columns:repeat(3,1fr);border-left:1px solid #b4a989}.wall article{min-height:180px;border-right:1px solid #b4a989;border-bottom:1px solid #b4a989;padding:1.15rem}.wall b{color:var(--r);font-size:.8rem}.wall h2{font-size:1rem;margin:.7rem 0}.wall article p{font-size:.84rem;line-height:1.48;margin:0;color:var(--x)}.secondary{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin:4rem 0}.secondary figure{margin:0;padding:.65rem;background:#fffaf0;border:1px solid #aaa08c;transform:rotate(var(--tilt))}.secondary figure:first-child{--tilt:-.8deg}.secondary figure:last-child{--tilt:.8deg}footer{border-top:2px solid var(--i);padding-top:1.5rem;display:flex;justify-content:space-between;gap:2rem}footer>div:first-child p:not(.label){font-size:.84rem;color:var(--x);margin:.5rem 0}.right{text-align:right;font-size:.8rem}.right>p{margin:0 0 .3rem}.right span{display:block;background:#1c1a16;color:#1c1a16;border-radius:2px;margin-bottom:1.3rem}.right strong{display:inline-block;color:var(--r);border:3px solid var(--r);padding:.45rem .6rem;letter-spacing:.1em;transform:rotate(-7deg)}.right a{display:block;margin-top:1.4rem}a:focus-visible{outline:3px solid var(--r);outline-offset:4px}@media(max-width:650px){.wall>div{grid-template-columns:1fr 1fr}.secondary{grid-template-columns:1fr}footer{display:block}.right{text-align:left;margin-top:2rem}}@media(max-width:390px){.wall>div{grid-template-columns:1fr}h1{font-size:2.8rem}}
</style>
