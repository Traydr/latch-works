---
// PROTOTYPE: Blueprint. Blueprint #173E7A with precise white framing; condensed display titles and mono annotations, sparse cyan navigation.
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
---
<main class="sheet"><a class="back" href="/">← ALL STAGES</a><header><p>STAGE 02 · FRAME VIEW</p><h1>{product.name}</h1><strong>{product.tagline}</strong><p class="description">{product.description}</p><span class="path">{product.repoPath}</span></header><section class="hero"><div class="label"><span>FIG. 1 / PRIMARY LOCAL GALLERY</span><span>DESKTOP REFERENCE UX</span></div><div class="image"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><svg viewBox="0 0 100 58" aria-hidden="true"><path d="M3 8H20L31 22M96 8H78L65 17M95 52H74L61 37"/><circle cx="31" cy="22" r="1"/><circle cx="65" cy="17" r="1"/><circle cx="61" cy="37" r="1"/></svg><i class="c1">FOLDER TREE</i><i class="c2">SORT + SEARCH</i><i class="c3">MEDIA GRID</i></div></section><section class="parts"><div class="label"><span>PARTS LIST</span><span>06 ITEMS</span></div><div class="part-grid">{product.features.map((feature,index)=><article><span>{String(index+1).padStart(2,"0")}</span><h2>{feature.title}</h2><p>{feature.description}</p></article>)}</div></section><section class="gallery"><div class="label"><span>FIG. 2–3 / SUPPORTING VIEWS</span><span>LOCAL MEDIA</span></div>{product.gallery.map((shot,index)=><figure><img src={shot.src} alt={shot.alt}/><figcaption>FIG. {index+2} · {shot.caption}</figcaption></figure>)}</section><section class="notes"><div class="label"><span>NOTES</span><span>01–04</span></div><ol>{product.highlights.map((highlight)=><li>{highlight}</li>)}</ol></section><footer><div>PROJECT <b>{product.name}</b> / PATH <b>apps/frame-view</b> / STAGE <b>02</b></div><a href="/docs/frame-view">ASSEMBLY DOCS →</a></footer></main>
<style>
.sheet{--p:#173E7A;--d:#122F5F;--l:rgba(255,255,255,.75);--g:rgba(255,255,255,.07);--t:#F2F6FC;--m:#9DB4D8;--c:#7FD4FF;color:var(--t);min-height:100vh;padding:clamp(1.25rem,4vw,4.5rem);box-sizing:border-box;background-color:var(--p);background-image:linear-gradient(var(--g) 1px,transparent 1px),linear-gradient(90deg,var(--g) 1px,transparent 1px);background-size:28px 28px;font-family:"IBM Plex Mono",monospace}.back,.label,header>p,footer{font-size:.68rem;letter-spacing:.08em}.back{color:var(--c);text-decoration:none}.back:focus-visible,footer a:focus-visible{outline:2px solid var(--c);outline-offset:4px}header{padding:2rem 0;border-bottom:1px solid var(--l)}header>p{color:var(--c);margin:0}h1{font:700 clamp(4.8rem,13vw,12rem)/.7 "Barlow Condensed",sans-serif;margin:.5rem 0}header strong{color:var(--c);font-size:1rem;font-weight:400}.description{max-width:60rem;color:var(--m);font-size:.82rem;line-height:1.7;margin:1rem 0}.path{display:block;width:max-content;border-bottom:1px solid var(--l);padding:.3rem 0;font-size:.72rem}.hero{padding:2rem 0 4rem}.label{display:flex;justify-content:space-between;color:var(--m);margin-bottom:.5rem}.image{border:1px solid var(--l);background:var(--d);position:relative;aspect-ratio:1.82;overflow:hidden}.image img{width:100%;height:100%;object-fit:cover;display:block}.image svg{position:absolute;inset:0;width:100%;height:100%;fill:none;stroke:var(--c);stroke-width:.25}.image circle{fill:var(--c);stroke:none}.image i{position:absolute;background:var(--p);font-style:normal;font-size:clamp(.42rem,.65vw,.65rem);color:var(--c);padding:.12rem}.c1{left:2%;top:9%}.c2{right:2%;top:9%}.c3{right:2%;bottom:8%}.parts,.gallery,.notes{border-top:1px solid var(--l);padding-top:.75rem}.part-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0 1.5rem}.part-grid article{padding:1.1rem 0;border-bottom:1px solid rgba(255,255,255,.35)}.part-grid span{font-size:.65rem;color:var(--c)}.part-grid h2{font:600 1.45rem "Barlow Condensed",sans-serif;margin:.4rem 0}.part-grid p,.notes li{color:var(--m);font-size:.72rem;line-height:1.6;margin:0}.gallery{margin-top:4rem;display:grid;grid-template-columns:1fr 1fr;gap:1rem}.gallery .label{grid-column:1/-1}.gallery figure{margin:0}.gallery img{width:100%;border:1px solid var(--l);display:block}.gallery figcaption{color:var(--m);font-size:.63rem;padding-top:.5rem}.notes{max-width:760px;margin-top:4rem}.notes ol{padding-left:2.5rem}footer{border-top:1px solid var(--l);padding-top:1rem;margin-top:4rem;display:flex;justify-content:space-between;align-items:center;color:var(--m)}footer b{color:var(--t);font-weight:500}footer a{color:var(--c);text-decoration:none;border:1px solid var(--c);padding:.75rem}@media(max-width:600px){.part-grid{grid-template-columns:1fr 1fr}.gallery{grid-template-columns:1fr}.gallery .label{grid-column:auto}footer{align-items:start;flex-direction:column;gap:1rem}}@media(max-width:420px){.part-grid{grid-template-columns:1fr}}
</style>
