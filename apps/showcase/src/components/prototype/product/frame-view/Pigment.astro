---
// PROTOTYPE: Pigment 02 is a violet gallery plate, with a centered local-viewing image as the visual thesis.
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
---
<main>
  <section class="hero"><a href="/">← All stages</a><p class="chip">PIGMENT 02 · VIOLET · #8B7CF6</p><h1>{product.name}</h1><p class="tagline">{product.tagline}</p><figure class="plate"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} /><figcaption>{product.heroScreenshot.caption}</figcaption></figure><div class="metadata"><p>{product.description}</p><code>{product.repoPath}</code></div></section>
  <section class="features"><p class="eyebrow">SIX WAYS TO FRAME AN ARCHIVE</p><ul>{product.features.map((feature) => <li><i></i><h2>{feature.title}</h2><p>{feature.description}</p></li>)}</ul></section>
  <section class="gallery">{product.gallery.map((image) => <figure><img src={image.src} alt={image.alt}/><figcaption>{image.caption}</figcaption></figure>)}</section>
  <p class="highlight">{product.highlights.join("  /  ")}</p><a class="cta" href={`/docs/${product.slug}`}>Read the formula →</a>
</main>
<style>
  :global(*){box-sizing:border-box}:global(body){margin:0;background:#101014;color:#f4f4f2;font-family:Geist Variable,Arial,sans-serif}a{color:inherit}.hero{background:#8b7cf6;color:#f4f4f2;text-align:center;padding:2rem clamp(1.4rem,6vw,7rem) 6rem}.hero>a{display:block;text-align:left;font:700 .75rem "JetBrains Mono",monospace}.hero>a:focus-visible,.cta:focus-visible{outline:3px solid currentColor;outline-offset:5px}.chip,.eyebrow,.highlight,code,figcaption{font-family:"JetBrains Mono",monospace;font-size:.7rem;letter-spacing:.04em}.chip{display:inline-block;margin:7rem 0 2rem;border:1px solid;padding:.55rem .7rem;font-weight:700}.hero h1{font-size:clamp(5rem,13vw,13rem);letter-spacing:-.105em;line-height:.7;margin:0}.tagline{font-size:clamp(1.25rem,2vw,1.75rem);font-weight:700;margin:2rem 0 4rem}.plate{margin:0 auto;max-width:1050px;background:#8b7cf6;box-shadow:0 28px 0 #101014;border:1px solid rgba(255,255,255,.4);overflow:hidden}.plate img,.gallery img{display:block;width:100%;filter:grayscale(1) contrast(1.18) brightness(.82);mix-blend-mode:screen;opacity:.92}.plate figcaption,.gallery figcaption{text-align:left;padding:.8rem}.metadata{max-width:560px;text-align:left;margin:4rem auto 0;display:flex;gap:2rem;align-items:flex-start}.metadata p{margin:0;line-height:1.5}.metadata code{white-space:nowrap}.features{padding:clamp(5rem,9vw,9rem) clamp(1.4rem,8vw,10rem)}.eyebrow{color:#9a9aa3}.features ul{list-style:none;margin:3rem 0 0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:3rem}.features li{border-top:1px solid #36363d;padding-top:1rem}.features i{display:block;background:#8b7cf6;width:12px;height:12px}.features h2{font-size:1.2rem;margin:1rem 0 .5rem}.features p{color:#9a9aa3;line-height:1.5;margin:0}.gallery{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#101014}.gallery figure{margin:0;background:#8b7cf6}.highlight{padding:1.3rem clamp(1.4rem,8vw,10rem);color:#9a9aa3;line-height:2}.cta{display:block;background:#8b7cf6;padding:clamp(3rem,7vw,7rem);font-size:clamp(2.5rem,6vw,6rem);font-weight:700;letter-spacing:-.07em;text-decoration:none}@media(max-width:700px){.chip{margin-top:5rem}.metadata{display:block}.metadata code{display:block;margin-top:1rem}.features ul{grid-template-columns:1fr}.gallery{grid-template-columns:1fr}}
</style>
