---
// PROTOTYPE: violet #8B7CF6 oversized viewing card, white card ink, #F7F3E8 paper mats and strips, metal rivet hardware over #EFEAE0.
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
---
<main><a class="back" href="/">← All stages</a><article class="hero"><i class="rivet"></i><p>STAGE 2 / ORGANIZE</p><h1>{product.name}</h1><strong>{product.tagline}</strong><p class="description">{product.description}</p><figure><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} /></figure><div class="spec">{product.repoPath} · {product.kind} · stage 2</div></article><section class="features">{product.features.map((feature)=><article><h2>{feature.title}</h2><p>{feature.description}</p></article>)}</section><section class="pair">{product.gallery.map((image,index)=><figure class={`shot shot-${index}`}><img src={image.src} alt={image.alt}/><figcaption>{image.caption}</figcaption></figure>)}</section><section class="end"><div><h2>Workshop notes</h2><ul>{product.highlights.map((item)=><li>{item}</li>)}</ul></div><a class="docs" href={`/docs/${product.slug}`}>Docs →</a></section></main>
<style>
@import "@fontsource/ibm-plex-mono/400.css"; @import "@fontsource/ibm-plex-mono/500.css";
main{max-width:1220px;margin:auto;padding:32px clamp(18px,5vw,70px) 72px;color:#191713;font-family:"IBM Plex Mono",monospace}.back,.docs{color:#191713;font-size:12px;font-weight:500}.back:focus-visible,.docs:focus-visible{outline:3px solid #191713;outline-offset:4px}.hero{position:relative;margin:28px auto 42px;padding:45px 34px 0;border-radius:12px;background:#8B7CF6;color:#fff;box-shadow:0 25px 45px #19171345}.hero>p:first-of-type,.spec,h2{font-size:11px;letter-spacing:.08em}h1{margin:12px 0 6px;font:700 clamp(65px,11vw,132px)/.82 Geist Variable,sans-serif;letter-spacing:-.08em}strong{font-size:14px}.description{max-width:660px;margin:24px 0;font-size:13px;line-height:1.55}figure{margin:0;padding:6px;background:#F7F3E8;color:#191713}figure img{display:block;width:100%}.spec{position:relative;margin:16px -13px -17px;padding:15px;background:#F7F3E8;color:#191713;box-shadow:0 4px 8px #19171330;transform:rotate(-.5deg)}.spec::before,.features article::before{content:"";position:absolute;top:-5px;left:20%;width:48px;height:10px;background:#efeae0aa}.rivet{position:absolute;top:15px;left:15px;width:18px;height:18px;border-radius:50%;background:radial-gradient(circle at 32% 28%,#fff 0 10%,#C9CDD3 24%,#6A6F76 74%,#42464b)}.rivet::after{content:"";position:absolute;top:8px;left:3px;width:12px;height:2px;background:#4d5258;transform:rotate(-12deg)}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.features article{position:relative;padding:18px;background:#F7F3E8;box-shadow:0 4px 9px #19171318}.features h2{margin:0 0 14px}.features p{margin:0;color:#6E6759;font-size:12px;line-height:1.55}.pair{display:flex;justify-content:center;align-items:flex-start;min-height:335px;margin:54px 5% 20px}.shot{width:min(55%,520px);box-shadow:0 12px 23px #19171335}.shot-0{transform:rotate(-3deg)}.shot-1{margin:48px 0 0 -8%;transform:rotate(3deg)}figcaption{padding:10px 4px 2px;color:#6E6759;font-size:11px;line-height:1.4}.end{display:flex;justify-content:space-between;gap:32px;align-items:end;margin-top:20px;border-top:1px solid #bdb5a8;padding-top:24px}.end h2{margin:0 0 12px}.end ul{margin:0;padding:0;list-style:none}.end li{padding:8px 0;font-size:12px}.docs{display:block;padding:14px;background:#F7F3E8;box-shadow:0 3px 6px #19171320;white-space:nowrap}@media(max-width:650px){.hero{padding:35px 16px 0}.features{grid-template-columns:1fr}.pair{display:block;min-height:0;margin:38px 0}.shot{width:92%}.shot-1{margin:18px 0 0 8%}.end{display:block}.docs{display:inline-block;margin-top:22px}h1{font-size:67px}}
main{background:#EFEAE0;box-shadow:0 0 0 100vmax #EFEAE0;clip-path:inset(0 -100vmax)}
</style>
