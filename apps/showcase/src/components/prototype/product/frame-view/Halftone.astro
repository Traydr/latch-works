---
// PROTOTYPE: Halftone Frame View uses white paper (#FAFAF7), ink (#141414), gray (#8A8A85), hairlines (#DDDDD6), and violet (#8B7CF6).
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
---
<main><section class="hero"><a href="/">← All stages</a><div class="head"><p>STAGE 02 / FRAME VIEW</p><h1>{product.name}</h1><strong>{product.tagline}</strong><span>{product.description}</span><code>{product.repoPath}</code></div><figure><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><figcaption>{product.heroScreenshot.caption}</figcaption></figure></section><section class="features"><p>LOCAL VIEWER / SIX WORKING PARTS</p><div>{product.features.map((feature)=><article><h2>{feature.title}</h2><p>{feature.description}</p></article>)}</div></section><section class="gallery">{product.gallery.map((shot)=><figure><img src={shot.src} alt={shot.alt}/><figcaption>{shot.caption}</figcaption></figure>)}</section><p class="highlights">{product.highlights.join("  /  ")}</p><a class="cta" href={`/docs/${product.slug}`}>Read more →</a></main>
<style>
 main{background:#fafaf7;color:#141414;font-family:"Geist Variable",sans-serif;overflow:hidden}.hero{background:#8b7cf6;color:#fafaf7;padding:2rem clamp(1.5rem,7vw,8rem) clamp(4rem,8vw,8rem)}a,.head>p,.features>p,figcaption,.highlights,code{font:700 .68rem/1.4 "JetBrains Mono",monospace;letter-spacing:.04em}a{color:inherit}a:focus-visible,.cta:focus-visible{outline:3px solid currentColor;outline-offset:5px}.head{display:grid;grid-template-columns:1fr minmax(0,1.9fr);gap:3rem;margin:clamp(4rem,8vw,8rem) 0 3rem;align-items:end}.head>p{grid-column:1/-1;margin:0}.head h1{grid-column:1/-1;margin:0;font-weight:800;font-size:clamp(5rem,14vw,14rem);line-height:.67;letter-spacing:-.11em}.head strong{font-size:1.3rem}.head span{max-width:37rem;line-height:1.55}.head code{display:block;margin-top:1rem}figure{position:relative;margin:0;color:#8b7cf6;background:#fafaf7;border:1px solid #141414;box-shadow:19px 19px #141414;transform:rotate(-1.2deg);overflow:hidden}figure::after{content:"";position:absolute;inset:0;pointer-events:none;background-image:radial-gradient(circle,currentColor 1px,transparent 1.3px);background-size:4px 4px;mix-blend-mode:multiply;opacity:.5}img{display:block;width:100%;min-height:clamp(22rem,48vw,48rem);object-fit:cover;filter:grayscale(1) contrast(1.25) brightness(1.06)}figcaption{position:relative;z-index:1;background:#fafaf7;color:#141414;padding:.8rem}.features{padding:clamp(4rem,8vw,8rem)}.features>p{margin:0 0 2rem}.features>div{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #ddddd6}.features article{padding:1.25rem 1.5rem 2.4rem 0;border-bottom:1px solid #ddddd6}.features article:nth-child(3n+2),.features article:nth-child(3n+3){padding-left:1.5rem}.features h2{font:700 .78rem "JetBrains Mono",monospace;margin:0}.features p{margin:.8rem 0 0;color:#8a8a85;font-size:.9rem;line-height:1.5}.gallery{background:#141414;padding:clamp(3rem,7vw,7rem);display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,5rem)}.gallery figure{box-shadow:12px 12px #8b7cf6}.gallery figure:last-child{transform:rotate(1.1deg)}.gallery img{min-height:16rem}.highlights{margin:0;padding:1.2rem clamp(1.5rem,7vw,8rem);color:#141414;border-bottom:1px solid #ddddd6}.cta{display:block;background:#8b7cf6;color:#fafaf7;padding:clamp(3rem,7vw,7rem);font-size:clamp(2rem,5vw,5rem);font-weight:800;letter-spacing:-.07em;text-decoration:none}@media(max-width:700px){.head{grid-template-columns:1fr}.features>div,.gallery{grid-template-columns:1fr}.features article,.features article:nth-child(3n+2),.features article:nth-child(3n+3){padding:1.2rem 0 2rem}img{min-height:17rem}}@media(max-width:390px){.hero,.features{padding-left:1.25rem;padding-right:1.25rem}}
</style>
