---
// PROTOTYPE: Atlas — parchment #F0EBDD, panel #E9E2CF, ink #2B2A24, dim #7A7260, contour #C9BBA0, route #C4442C; Geist + IBM Plex Mono.
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
---
<main class="atlas"><a href="/">← All stages</a><header><p>STAGE 02 · ORGANIZE <b>REF FV-02</b></p><h1>{product.name}</h1><em>{product.tagline}</em><p>{product.description}</p><code>GRID REF / {product.repoPath}</code></header><figure class="plate"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt}/><figcaption>FV-02 / {product.heroScreenshot.caption}</figcaption></figure><section class="land"><div class="title"><p>LANDMARKS</p><h2>Local terrain,<br/>in full frame.</h2></div><div class="list">{product.features.map(f=><article><span>⊕</span><h3>{f.title}</h3><p>{f.description}</p></article>)}</div></section><section class="gallery">{product.gallery.map((shot,i)=><figure><img src={shot.src} alt={shot.alt}/><figcaption>FV-0{3+i} / {shot.caption}</figcaption></figure>)}</section><section class="notes">{product.highlights.map(h=><p>{h}</p>)}</section><a class="guide" href={`/docs/${product.slug}`}>Trail guide →</a></main>
<style>
:global(:root){--p:#F0EBDD;--q:#E9E2CF;--i:#2B2A24;--d:#7A7260;--l:#C9BBA0;--r:#C4442C}.atlas{max-width:1240px;margin:auto;padding:2rem;color:var(--i);min-height:100vh;background:var(--p);background-image:repeating-radial-gradient(ellipse at 50% 30%,transparent 0 39px,rgba(201,187,160,.16) 40px 41px,transparent 42px 80px)}a,.guide{color:var(--r);font:500 .75rem "IBM Plex Mono",monospace;text-decoration:none}header{text-align:center;max-width:730px;margin:5rem auto 3rem}header>p:first-child,code,figcaption,.title>p{font:500 .7rem "IBM Plex Mono",monospace;letter-spacing:.08em;color:var(--r)}header b{font-weight:400;color:var(--d);margin-left:1rem}h1{font-size:clamp(4.5rem,10vw,8rem);letter-spacing:-.09em;line-height:.82;margin:1rem}em{color:var(--r);font-size:1.4rem;font-style:normal}header>p:not(:first-child){line-height:1.6;color:var(--d)}code{display:block;color:var(--d);margin-top:2rem}.plate{margin:0 auto 7rem;max-width:1000px;padding:8px;background:var(--q);border:1px solid var(--l);background-image:linear-gradient(45deg,transparent 49.5%,rgba(43,42,36,.18) 50%,transparent 50.5%)}.plate img{display:block;width:100%;max-height:610px;object-fit:cover}.plate figcaption,.gallery figcaption{padding:.8rem 0 0;font-size:.62rem;color:var(--d)}.land{border-top:1px solid var(--i);display:grid;grid-template-columns:1fr 2fr;padding:2rem 0 4rem}.title h2{font-size:2.5rem;letter-spacing:-.06em;line-height:.92;margin:1rem 0}.list{display:grid;grid-template-columns:1fr 1fr;gap:0 2rem}.list article{border-top:1px solid var(--l);padding:1rem 0;position:relative}.list span{color:var(--r);position:absolute;right:0}.list h3{font-size:1rem;margin:0}.list p{font-size:.87rem;color:var(--d);line-height:1.5;margin:.5rem 1.5rem 0 0}.gallery{display:grid;grid-template-columns:1fr 1fr;gap:2rem}.gallery figure{margin:0;padding:6px;background:var(--q);border:1px solid var(--l)}.gallery img{display:block;width:100%;aspect-ratio:16/10;object-fit:cover}.notes{margin-top:5rem;border-top:1px solid var(--i);border-bottom:1px solid var(--i);display:grid;grid-template-columns:repeat(4,1fr)}.notes p{font:500 .7rem/1.5 "IBM Plex Mono",monospace;color:var(--d);padding:1.5rem;border-right:1px solid var(--l)}.guide{display:inline-block;margin:3rem 0;font-size:1rem}a:focus-visible{outline:3px solid var(--r);outline-offset:4px}@media(max-width:700px){.atlas{padding:1.25rem}header{margin:3rem auto}.plate{margin-bottom:4rem}.land{grid-template-columns:1fr}.list{margin-top:1.5rem}.notes{grid-template-columns:1fr 1fr}.notes p{margin:0}.gallery{gap:1rem}}@media(max-width:430px){.list,.gallery,.notes{grid-template-columns:1fr}h1{font-size:4.2rem}}
</style>
