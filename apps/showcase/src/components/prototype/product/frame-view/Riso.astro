---
/** PROTOTYPE — Riso: violet #7A5AFF gallery print on #F6F1E7 paper with pink headline offset. */
import type { Product } from "@/data/products";
interface Props { product: Product; }
const { product } = Astro.props;
---
<main class="riso frame"><a class="back" href="/">← All stages</a><section class="hero"><div><p>STAGE 02 / ORGANIZE</p><h1 data-print={product.name}>{product.name}</h1><strong>{product.tagline}</strong><p>{product.description}</p><code>{product.repoPath}</code></div></section><section class="gallery-piece"><figure class="side left"><img src={product.gallery[0].src} alt={product.gallery[0].alt} /></figure><figure class="main-print"><img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} /><figcaption>{product.heroScreenshot.caption}</figcaption></figure><figure class="side right"><img src={product.gallery[1].src} alt={product.gallery[1].alt} /></figure></section><section class="features">{product.features.map((feature,index)=><article><b>0{index+1}</b><h2>{feature.title}</h2><p>{feature.description}</p></article>)}</section><p class="ticker">{product.highlights.join("  /  ")}</p><a class="cta" href={`/docs/${product.slug}`}>Read more →</a></main>
<style>
@import "@fontsource/barlow-condensed/600.css";@import "@fontsource/barlow-condensed/700.css";@import "@fontsource/ibm-plex-mono/400.css";@import "@fontsource/ibm-plex-mono/500.css";.riso{--paper:#F6F1E7;--deep:#EFE7D8;--ink:#1C1A17;--riso:#7A5AFF;color:var(--ink);background:var(--paper) radial-gradient(rgba(28,26,23,.13) .55px,transparent .8px);background-size:5px 5px;font-family:"IBM Plex Mono",monospace;padding:1.5rem 4vw 0}.back{color:inherit;font-size:.75rem;text-decoration:none;border-bottom:1px solid}.hero{background:var(--riso);margin:1.5rem 0 0;padding:clamp(2rem,7vw,6rem);min-height:440px;display:flex;align-items:center;box-shadow:7px 8px 0 var(--ink);transform:rotate(1deg)}.hero>div{max-width:50rem}.hero p,.ticker,figcaption{font-size:.72rem;line-height:1.65}.hero h1,h2{font-family:"Barlow Condensed",sans-serif;text-transform:uppercase;line-height:.78;letter-spacing:-.05em;margin:.65rem 0}.hero h1{position:relative;z-index:0;font-size:clamp(6rem,15vw,14rem)}.hero h1:after{content:attr(data-print);position:absolute;inset:0 auto auto 4px;z-index:-1;color:#FF48B0}.hero strong{font-size:1rem}.hero p:not(:first-child){max-width:40rem}.hero code{font-size:.7rem;border-top:1px solid;padding-top:.7rem}.gallery-piece{min-height:630px;display:grid;grid-template-columns:.48fr 1fr .48fr;gap:2vw;align-items:center;margin:-2rem 5vw 4rem}.gallery-piece figure{margin:0}.gallery-piece img{display:block;width:100%;object-fit:cover;filter:grayscale(1) contrast(1.15) sepia(.3);mix-blend-mode:multiply}.main-print{background:var(--ink);padding:.55rem;box-shadow:6px 7px 0 var(--riso);transform:rotate(-1.5deg)}.main-print img{aspect-ratio:1.3;mix-blend-mode:screen}.side{border:1px solid var(--ink);padding:.3rem;transform:rotate(3deg)}.side img{aspect-ratio:.8}.right{transform:rotate(-3deg)}figcaption{padding:.55rem 0 0;color:var(--paper)}.features{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid;margin:0 4vw 4rem}.features article{padding:1.25rem 1.25rem 1.5rem 0;margin-right:1.25rem;border-right:1px solid}.features article:nth-child(3n){border:0}.features b{font-size:.68rem;color:var(--riso)}.features h2{font-size:2.6rem}.features p{font-size:.7rem;line-height:1.65}.ticker{margin:0 -4vw;padding:1rem 4vw;border-top:2px solid;border-bottom:2px solid;white-space:nowrap;overflow:hidden}.cta{display:block;background:var(--riso);color:var(--ink);padding:2rem 4vw;font:700 clamp(2.6rem,6vw,5rem)/.8 "Barlow Condensed",sans-serif;text-transform:uppercase;text-decoration:none}a:focus-visible{outline:3px solid #FF48B0;outline-offset:4px}@media(max-width:700px){.gallery-piece{min-height:0;margin:2rem 0 3rem;grid-template-columns:1fr 1fr}.main-print{grid-column:span 2;grid-row:1}.side{display:none}.features{grid-template-columns:1fr 1fr;margin-inline:0}.features article:nth-child(3n){border-right:1px solid}.features article:nth-child(2n){border:0}}@media(max-width:390px){.riso{padding-inline:1rem}.features{grid-template-columns:1fr}.features article{border-right:0!important;border-bottom:1px solid}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}}
.hero h1 { color: var(--paper); }
</style>
