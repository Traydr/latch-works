---
/**
 * PROTOTYPE — throwaway. Do not ship.
 *
 * Floating bottom bar for cycling homepage layout variants via `?variant=`.
 * Dev-only: the bar is never rendered in production builds.
 */
import type { VariantOption } from "./variants";

interface Props {
  current: VariantOption;
  variants: VariantOption[];
}

const { current, variants } = Astro.props;
const isDev = import.meta.env.DEV;
---

{
  isDev && (
    <div
      class="proto-switcher"
      data-current={current.key}
      data-keys={variants.map((v) => v.key).join(",")}
    >
      <button type="button" data-step="-1" aria-label="Previous variant">
        ←
      </button>
      <span class="proto-switcher-label">
        <strong>{current.key}</strong> — {current.name}
      </span>
      <button type="button" data-step="1" aria-label="Next variant">
        →
      </button>
    </div>
  )
}

<style>
  .proto-switcher {
    position: fixed;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.35rem;
    border-radius: 999px;
    background: #f5f4f0;
    color: #111;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.35),
      0 12px 32px -8px rgba(0, 0, 0, 0.65);
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
  }
  .proto-switcher button {
    border: 0;
    border-radius: 999px;
    width: 2rem;
    height: 2rem;
    background: #111;
    color: #f5f4f0;
    cursor: pointer;
    font-size: 0.9rem;
    line-height: 1;
  }
  .proto-switcher button:hover {
    background: #333;
  }
  .proto-switcher button:focus-visible {
    outline: 2px solid #111;
    outline-offset: 2px;
  }
  .proto-switcher-label {
    padding: 0 0.6rem;
    white-space: nowrap;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>(".proto-switcher");
  if (bar) {
    const keys = (bar.dataset.keys ?? "").split(",");
    const go = (step: number) => {
      const url = new URL(window.location.href);
      const current = url.searchParams.get("variant") ?? bar.dataset.current ?? keys[0];
      const idx = Math.max(0, keys.indexOf(current));
      const next = keys[(idx + step + keys.length) % keys.length];
      url.searchParams.set("variant", next);
      window.location.href = url.toString();
    };
    bar.querySelectorAll<HTMLButtonElement>("button[data-step]").forEach((btn) => {
      btn.addEventListener("click", () => go(Number(btn.dataset.step)));
    });
    window.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement | null;
      if (
        target &&
        (target.tagName === "INPUT" ||
          target.tagName === "TEXTAREA" ||
          target.isContentEditable)
      ) {
        return;
      }
      if (event.key === "ArrowLeft") go(-1);
      if (event.key === "ArrowRight") go(1);
    });
  }
</script>
