---
/**
 * MDX `table` override: wide reference tables scroll inside the article instead of widening the
 * page on phones. The wrapper is focusable so keyboard users can scroll it too.
 */
const props = Astro.props;
---

<div class="table-scroll" role="region" aria-label="Table" tabindex="0">
  <table {...props}><slot /></table>
</div>
