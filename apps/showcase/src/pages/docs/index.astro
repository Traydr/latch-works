---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const docs = (await getCollection("docs")).sort(
  (left, right) => (left.data.order ?? 99) - (right.data.order ?? 99),
);
const firstDoc = docs[0];

if (firstDoc) {
  return Astro.redirect(`/docs/${firstDoc.id}`);
}
---

<BaseLayout title="Docs — Latch Works">
  <div class="mx-auto max-w-2xl px-4 py-20 text-center sm:px-6">
    <h1 class="text-3xl font-semibold text-foreground">Documentation</h1>
    <p class="mt-4 text-muted-foreground">Docs are on the way.</p>
  </div>
</BaseLayout>
