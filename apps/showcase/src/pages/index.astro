---
/**
 * PROTOTYPE HUB — throwaway. Do not ship as-is.
 *
 * Iteration 3: five design families, switchable via `?variant=` (0 = current
 * design, baseline). Keys are aligned with product pages — the same key on
 * `/[slug]` is the same family. Flip with the floating bar or ←/→ keys.
 * Once winners are picked, fold them into the real pages and delete
 * src/components/prototype/.
 */
import PrototypeSwitcher from "@/components/prototype/PrototypeSwitcher.astro";
import VariantAtlas from "@/components/prototype/home/VariantAtlas.astro";
import VariantCatalog from "@/components/prototype/home/VariantCatalog.astro";
import VariantCurrent from "@/components/prototype/home/VariantCurrent.astro";
import VariantDossier from "@/components/prototype/home/VariantDossier.astro";
import VariantPigment from "@/components/prototype/home/VariantPigment.astro";
import VariantWorkbench from "@/components/prototype/home/VariantWorkbench.astro";
import { HOME_VARIANTS, resolveVariant } from "@/components/prototype/variants";
import BaseLayout from "@/layouts/BaseLayout.astro";

const variant = resolveVariant(Astro.url.searchParams.get("variant"), HOME_VARIANTS);
---

<BaseLayout>
  {variant.slug === "current" && <VariantCurrent />}
  {variant.slug === "archive" && <VariantCatalog />}
  {variant.slug === "workshop" && <VariantWorkbench />}
  {variant.slug === "atlas" && <VariantAtlas />}
  {variant.slug === "dossier" && <VariantDossier />}
  {variant.slug === "pigment" && <VariantPigment />}
  <PrototypeSwitcher current={variant} variants={HOME_VARIANTS} />
</BaseLayout>
