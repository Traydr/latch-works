---
import FrameView from "@/components/colorblock/FrameView.astro";
import GatherBox from "@/components/colorblock/GatherBox.astro";
import Lockstep from "@/components/colorblock/Lockstep.astro";
import PaneView from "@/components/colorblock/PaneView.astro";
import { getProduct } from "@/data/products";
import BaseLayout from "@/layouts/BaseLayout.astro";

const { slug } = Astro.params;
const product = slug ? getProduct(slug) : undefined;

if (!product) {
  return Astro.redirect("/");
}
---

<BaseLayout title={`${product.name} — Latch Works`} description={product.description}>
  {product.slug === "gather-box" && <GatherBox product={product} />}
  {product.slug === "frame-view" && <FrameView product={product} />}
  {product.slug === "lockstep" && <Lockstep product={product} />}
  {product.slug === "pane-view" && <PaneView product={product} />}
</BaseLayout>
