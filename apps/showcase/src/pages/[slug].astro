---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProduct } from "@/data/products";
import ProductV1 from "@/variants/v1/Product.astro";
import ProductV2 from "@/variants/v2/Product.astro";
import ProductV3 from "@/variants/v3/Product.astro";
import ProductV4 from "@/variants/v4/Product.astro";
import ProductV5 from "@/variants/v5/Product.astro";
import ShellV1 from "@/variants/v1/Shell.astro";
import ShellV2 from "@/variants/v2/Shell.astro";
import ShellV3 from "@/variants/v3/Shell.astro";
import ShellV4 from "@/variants/v4/Shell.astro";
import ShellV5 from "@/variants/v5/Shell.astro";

const { slug } = Astro.params;
const product = slug ? getProduct(slug) : undefined;

if (!product) {
  return Astro.redirect("/");
}
---

<BaseLayout title={`${product.name} — Latch Works`} description={product.description}>
  <div data-variant="1" class="variant-root">
    <ShellV1><ProductV1 product={product} /></ShellV1>
  </div>
  <div data-variant="2" class="variant-root">
    <ShellV2><ProductV2 product={product} /></ShellV2>
  </div>
  <div data-variant="3" class="variant-root">
    <ShellV3><ProductV3 product={product} /></ShellV3>
  </div>
  <div data-variant="4" class="variant-root">
    <ShellV4><ProductV4 product={product} /></ShellV4>
  </div>
  <div data-variant="5" class="variant-root">
    <ShellV5><ProductV5 product={product} /></ShellV5>
  </div>
</BaseLayout>
