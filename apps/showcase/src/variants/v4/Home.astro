---
import { ProductBadge } from "@/components/ui";
import { pipeline, products, tools } from "@/data/products";
import { heroCopy, principles } from "@/data/site-content";

const apps = products.filter((product) => product.kind === "app");
const lockstep = tools[0];
---

<div class="mx-auto grid max-w-7xl auto-rows-[minmax(140px,auto)] grid-cols-2 gap-3 p-3 sm:grid-cols-4 sm:gap-4 sm:p-4 lg:auto-rows-[minmax(160px,auto)]">
  <section class="col-span-2 row-span-2 flex flex-col justify-end rounded-2xl border border-border/70 bg-card/40 p-6 sm:p-8">
    <p class="text-xs font-medium uppercase tracking-widest text-primary">{heroCopy.eyebrow}</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">{heroCopy.title}</h1>
    <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted-foreground sm:text-base">{heroCopy.description}</p>
  </section>

  {
    pipeline.map((stage) => (
      <div class="flex flex-col justify-center rounded-2xl border border-border/70 bg-muted/15 p-4">
        <p class="text-[0.65rem] font-semibold uppercase tracking-wider text-primary">{stage.step}</p>
        <p class="mt-1 text-sm font-medium text-foreground">{stage.product}</p>
        <p class="mt-1 text-xs text-muted-foreground">{stage.description}</p>
      </div>
    ))
  }

  {
    apps.map((product, index) => (
      <a
        href={`/${product.slug}`}
        class:list={[
          "group overflow-hidden rounded-2xl border border-border/70 bg-card/30 transition hover:border-primary/40",
          index === 0 ? "col-span-2 row-span-2" : "col-span-1 row-span-2",
        ]}
      >
        <div class={`h-1 bg-gradient-to-r ${product.accent}`}></div>
        <img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} class="h-32 w-full object-cover object-top sm:h-40" />
        <div class="p-4">
          <div class="flex items-center gap-2">
            <h2 class="font-semibold text-foreground">{product.name}</h2>
            <ProductBadge kind={product.kind} />
          </div>
          <p class="mt-1 text-xs text-muted-foreground">{product.tagline}</p>
        </div>
      </a>
    ))
  }

  {
    lockstep ? (
      <a href={`/${lockstep.slug}`} class="col-span-2 flex flex-col justify-between rounded-2xl border border-border/70 bg-card/50 p-5 sm:flex-row sm:items-center sm:gap-6">
        <div>
          <p class="text-xs uppercase tracking-widest text-primary">Sync</p>
          <h2 class="mt-1 text-xl font-semibold text-foreground">{lockstep.name}</h2>
          <p class="mt-2 text-sm text-muted-foreground">{lockstep.tagline}</p>
        </div>
        <img src={lockstep.heroScreenshot.src} alt={lockstep.heroScreenshot.alt} class="mt-4 h-24 w-full rounded-lg object-cover object-left-top sm:mt-0 sm:h-20 sm:w-40" />
      </a>
    ) : null
  }

  {
    principles.map((item) => (
      <div class="rounded-2xl border border-border/70 bg-muted/10 p-4">
        <h3 class="text-sm font-medium text-foreground">{item.title}</h3>
        <p class="mt-1 text-xs leading-relaxed text-muted-foreground">{item.body}</p>
      </div>
    ))
  }
</div>
