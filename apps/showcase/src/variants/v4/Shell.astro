---
import { apps, tools } from "@/data/products";
import { navClass } from "@/variants/shared/nav";

const pathname = Astro.url.pathname;
---

<div class="min-h-screen bg-background">
  <header class="border-b border-border/70 px-4 py-3 sm:px-6">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4">
      <a href="/" class="text-sm font-semibold text-foreground">Latch Works</a>
      <nav class="flex flex-wrap items-center gap-1 text-sm" aria-label="Primary">
        {apps.map((product) => (
          <a href={`/${product.slug}`} class={navClass(pathname, `/${product.slug}`)}>{product.name}</a>
        ))}
        {tools.map((product) => (
          <a href={`/${product.slug}`} class={navClass(pathname, `/${product.slug}`)}>{product.name}</a>
        ))}
        <a href="/docs" class={navClass(pathname, "/docs")}>Docs</a>
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
</div>
