---
import { products, tools } from "@/data/products";
import { heroCopy, principles } from "@/data/site-content";

const apps = products.filter((product) => product.kind === "app");
const lockstep = tools[0];
---

<article class="variant5-snap mx-auto max-w-2xl px-6 py-16 sm:py-24">
  <header class="border-b border-border/70 pb-12">
    <p class="text-xs font-medium uppercase tracking-[0.3em] text-primary">{heroCopy.eyebrow}</p>
    <h1 class="mt-6 text-4xl font-semibold leading-tight tracking-tight text-foreground sm:text-5xl">{heroCopy.title}</h1>
    <p class="mt-8 text-lg leading-relaxed text-muted-foreground">{heroCopy.description}</p>
    <p class="mt-8 text-sm text-muted-foreground">↓ Each app below is its own chapter. Keep scrolling.</p>
  </header>

  {
    apps.map((product, index) => (
      <section class="border-b border-border/70 py-16 sm:py-20">
        <p class="font-mono text-xs text-muted-foreground">Chapter {String(index + 1).padStart(2, "0")}</p>
        <h2 class="mt-4 text-3xl font-semibold text-foreground">{product.name}</h2>
        <p class="mt-3 text-lg text-primary">{product.tagline}</p>
        <p class="mt-6 leading-relaxed text-muted-foreground">{product.description}</p>
        <a href={`/${product.slug}`} class="mt-8 inline-block overflow-hidden rounded-xl border border-border/70">
          <img src={product.heroScreenshot.src} alt={product.heroScreenshot.alt} class="aspect-[16/10] w-full max-w-xl object-cover object-top" />
        </a>
        <a href={`/${product.slug}`} class="mt-6 block text-sm font-medium text-primary">Read the full {product.name} page →</a>
      </section>
    ))
  }

  {
    lockstep ? (
      <section class="border-b border-border/70 py-16 sm:py-20">
        <p class="font-mono text-xs text-muted-foreground">Interlude — sync</p>
        <h2 class="mt-4 text-3xl font-semibold text-foreground">{lockstep.name}</h2>
        <p class="mt-6 leading-relaxed text-muted-foreground">{lockstep.description}</p>
        <ul class="mt-8 space-y-3">
          {lockstep.highlights.map((item) => (
            <li class="border-l-2 border-primary/40 pl-4 text-sm text-muted-foreground">{item}</li>
          ))}
        </ul>
        <a href={`/${lockstep.slug}`} class="mt-8 inline-block text-sm font-medium text-primary">Lockstep details →</a>
      </section>
    ) : null
  }

  <section class="py-16">
    <h2 class="text-2xl font-semibold text-foreground">Why it exists</h2>
    <div class="mt-8 space-y-8">
      {principles.map((item) => (
        <div>
          <h3 class="font-medium text-foreground">{item.title}</h3>
          <p class="mt-2 leading-relaxed text-muted-foreground">{item.body}</p>
        </div>
      ))}
    </div>
  </section>
</article>
