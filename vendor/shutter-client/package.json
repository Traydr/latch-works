{
  "name": "@shutter/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./urls": {
      "source": "./src/urls.ts",
      "types": "./dist/urls.d.ts",
      "default": "./dist/urls.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@shutter/protocol": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
